<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-android36.0</TargetFramework>
        <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
        <Nullable>enable</Nullable>
        <ApplicationTitle>OpenUtau Mobile 预览版</ApplicationTitle>
        <AndroidPackageFormat>apk</AndroidPackageFormat>
        <!-- 将程序集随 APK 部署，避免启动时逐个加载导致 ANR。 -->
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
        <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
        <!-- 大堆内存 -->
        <AndroidMaxHeapSize>2G</AndroidMaxHeapSize>
        <TieredPGO>true</TieredPGO>
        <IsTrimmable>true</IsTrimmable>
        <!-- 使用托管传输，保留动态插件所需的 HTTP/2 与 gRPC 响应尾部支持。 -->
        <UseNativeHttpHandler>false</UseNativeHttpHandler>
    </PropertyGroup>
    <!-- 调试模式 -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <ApplicationId>$(BaseApplicationId).debug</ApplicationId>
        <!-- 集中保存程序集和调试符号，减少打包时逐文件生成共享库的开销。 -->
        <AndroidUseAssemblyStore>true</AndroidUseAssemblyStore>
    </PropertyGroup>
    <!-- 发布模式 -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <AndroidCreatePackagePerAbi>True</AndroidCreatePackagePerAbi>
    </PropertyGroup>
    <!-- 静态资源 -->
    <ItemGroup>
        <AndroidResource Include="Resources\drawable\Icon.png"/>
    </ItemGroup>
    <!-- NuGet 包引用 -->
    <ItemGroup>
        <PackageReference Include="Avalonia.Android" Version="$(AvaloniaVersion)"/>
        <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.1"/>
        <!-- 避免 NuGet 的宿主平台原生资产与 Android AAR 中的同名库竞争。 -->
        <PackageReference Include="Microsoft.ML.OnnxRuntime"
                          Version="1.29.0"
                          GeneratePathProperty="true"
                          ExcludeAssets="native;runtime;build;buildTransitive"/>
    </ItemGroup>
    <!-- 项目引用 -->
    <ItemGroup>
        <ProjectReference Include="..\OpenUtauMobile\OpenUtauMobile.csproj"/>
    </ItemGroup>

    <!-- 仅从官方 Android AAR 提取 ONNX Runtime 原生库。 -->
    <ItemGroup>
        <AndroidLibrary Include="$(PkgMicrosoft_ML_OnnxRuntime)/runtimes/android/native/onnxruntime.aar"
                        Bind="false"/>
    </ItemGroup>

    <!-- 完整保留 .NET 基础框架的类型和成员，供动态调用使用；保留现有 AOT 配置。 -->
    <Target Name="PreserveAndroidBaseFrameworkAssemblies" BeforeTargets="PrepareForILLink"
            DependsOnTargets="ResolveReferences" Condition="'$(PublishTrimmed)' == 'true'">
        <ItemGroup>
            <TrimmerRootAssembly Include="@(ReferencePath->WithMetadataValue('FrameworkReferenceName', 'Microsoft.NETCore.App')->'%(Filename)')"
                                 RootMode="All" />
            <TrimmerRootAssembly Include="System.Private.CoreLib" RootMode="All" />
        </ItemGroup>
    </Target>

    <Import Project="../native/NativeBuild.targets" />
</Project>
