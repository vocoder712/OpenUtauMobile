<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-android36.0</TargetFramework>
        <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
        <Nullable>enable</Nullable>
        <ApplicationId>$(BaseApplicationId)</ApplicationId>
        <ApplicationTitle>OpenUtau Mobile 预览版</ApplicationTitle>
        <AndroidPackageFormat>apk</AndroidPackageFormat>
        <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
        <!-- 大堆内存 -->
        <AndroidMaxHeapSize>2G</AndroidMaxHeapSize>
        <TieredPGO>true</TieredPGO>
        <!-- 关闭链接器裁剪，保证运行时 DLL 反射注册可用 -->
        <IsTrimmable>False</IsTrimmable>
        <PublishTrimmed>False</PublishTrimmed>
        <AndroidLinkMode>None</AndroidLinkMode>
    </PropertyGroup>
    <!-- 调试模式 -->
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <ApplicationId>$(BaseApplicationId).debug</ApplicationId>
        <IsTrimmable>False</IsTrimmable>
        <!-- 避免 Fast Deployment 在启动期逐个加载程序集导致 ANR -->
        <EmbedAssembliesIntoApk>True</EmbedAssembliesIntoApk>
    </PropertyGroup>
    <!-- 发布模式 -->
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <IsTrimmable>False</IsTrimmable>
        <PublishTrimmed>False</PublishTrimmed>
        <AndroidLinkMode>None</AndroidLinkMode>
        <AndroidCreatePackagePerAbi>True</AndroidCreatePackagePerAbi>
        <!-- 关闭 AOT：AOT 要求 PublishTrimmed=true，会破坏插件 DLL 的反射加载 -->
        <RunAOTCompilation>False</RunAOTCompilation>
        <AndroidEnableProfiledAot>False</AndroidEnableProfiledAot>
        <!-- 分包 -->
        <!-- 在命令行中单独制定需要哪些分包 -->
        <!-- <RuntimeIdentifiers>android-arm;android-arm64;android-x86;android-x64</RuntimeIdentifiers> -->
    </PropertyGroup>
    <!-- Mono GC nursery 大小；缓解移动端 UI 卡顿与内存不足（Release 生效） -->
    <ItemGroup Condition="'$(Configuration)' == 'Release'">
        <AndroidEnvVar Include="MONO_GC_PARAMS" Value="nursery-size=128m" />
    </ItemGroup>
    <!-- 静态资源 -->
    <ItemGroup>
        <AndroidResource Include="Resources\drawable\Icon.png"/>
    </ItemGroup>
    <!-- NuGet 包引用 -->
    <ItemGroup>
        <PackageReference Include="Avalonia.Android" Version="$(AvaloniaVersion)"/>
        <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.1"/>
        <!-- 避免 NuGet 的宿主平台原生资产与 Android AAR 中的同名库竞争。 -->
        <PackageReference Include="Microsoft.ML.OnnxRuntime"
                          Version="1.29.0"
                          GeneratePathProperty="true"
                          ExcludeAssets="native;runtime;build;buildTransitive"/>
    </ItemGroup>
    <!-- 项目引用 -->
    <ItemGroup>
        <ProjectReference Include="..\OpenUtauMobile\OpenUtauMobile.csproj"/>
    </ItemGroup>

    <!-- 仅从官方 Android AAR 提取 ONNX Runtime 原生库。 -->
    <ItemGroup>
        <AndroidLibrary Include="$(PkgMicrosoft_ML_OnnxRuntime)/runtimes/android/native/onnxruntime.aar"
                        Bind="false"/>
    </ItemGroup>

    <!-- 原生库 -->
    <ItemGroup>
        <!-- 避免默认项与显式项重复，先排除，再包含 -->
        <AndroidNativeLibrary Remove="Libs\**\*.so"/>
        <AndroidNativeLibrary Include="Libs\armeabi-v7a\*">
            <Abi>armeabi-v7a</Abi>
        </AndroidNativeLibrary>
        <AndroidNativeLibrary Include="Libs\arm64-v8a\*">
            <Abi>arm64-v8a</Abi>
        </AndroidNativeLibrary>
        <AndroidNativeLibrary Include="Libs\x86\*">
            <Abi>x86</Abi>
        </AndroidNativeLibrary>
        <AndroidNativeLibrary Include="Libs\x86_64\*">
            <Abi>x86_64</Abi>
        </AndroidNativeLibrary>
    </ItemGroup>
    <Import Project="../native/game/GameNative.targets" />
</Project>