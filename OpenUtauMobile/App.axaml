<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:OpenUtauMobile"
             xmlns:dialogHostAvalonia="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             x:Class="OpenUtauMobile.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>
    
    <Application.Resources>
        <FontFamily x:Key="ContentControlThemeFontFamily">
            $Default
        </FontFamily>
    </Application.Resources>

    <Application.Styles>
        <!-- Development fallback only; custom Style layer should override and eventually replace this. -->
        <FluentTheme />
        <!-- DialogHost.Avalonia 弹窗所需的样式 -->
        <dialogHostAvalonia:DialogHostStyles />
        <!-- 新的 Theme 主题系统 -->
        <StyleInclude Source="avares://OpenUtauMobile/Themes/OpenUtauMobile/OpenUtauMobileTheme.axaml" />
        <!-- IconPacks 2.0 仍使用 Avalonia 11 编译 XAML，此处提供 Avalonia 12 兼容控件主题。 -->
        <StyleInclude Source="avares://OpenUtauMobile/Themes/IconPacksCompat.axaml" />
    </Application.Styles>
</Application>
