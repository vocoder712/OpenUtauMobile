<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:foundation="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Foundation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenUtauMobile.ViewModels"
             xmlns:c="clr-namespace:OpenUtauMobile.Controls"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             mc:Ignorable="d"
             d:DesignHeight="880" d:DesignWidth="400"
             x:Class="OpenUtauMobile.Views.SingerManagementView"
             x:DataType="vm:SingerManagementViewModel">

    <UserControl.Styles>
        <StyleInclude Source="/Views/Styles/SingerManagementView.axaml" />
    </UserControl.Styles>

    <!-- Root -->
    <Panel Background="{DynamicResource Sem.Color.Surface}">
        <DockPanel>
            <!-- 顶栏 -->
            <Border DockPanel.Dock="Top"
                    Classes="TopBar">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceS}">
                    <!-- 返回 -->
                    <Button Grid.Column="0"
                            Classes="TopBarBtn"
                            Command="{Binding BackCommand}"
                            ToolTip.Tip="{DynamicResource Common.Back}"
                            Content="{iconPacks:PhosphorIcons ArrowLeft}">
                    </Button>
                    <!-- 标题 -->
                    <TextBlock Grid.Column="1"
                               Classes="TopBarTitle"
                               Text="{DynamicResource SingerManagement.Title}" />
                    <!-- 手动重新扫描歌手目录，与返回页面时使用相同刷新入口。 -->
                    <Button Grid.Column="2" Classes="TopBarBtn" Command="{Binding RefreshCommand}"
                            ToolTip.Tip="{DynamicResource Common.Refresh}"
                            Content="{iconPacks:PhosphorIcons ArrowsClockwise}" />
                </Grid>
            </Border>

            <!-- 不可用候选单独显示位置与错误，不进入工程歌手选择。 -->
            <ScrollViewer DockPanel.Dock="Bottom" MaxHeight="240">
                <c:SingerCandidatesList ItemsSource="{Binding UnavailableCandidates}" DeleteCommand="{Binding DeleteCandidateCommand}" />
            </ScrollViewer>
            <!-- 歌手列表 -->
            <c:SingerList
                          ClipToBounds="False"
                          Singers="{Binding Singers}"
                          SelectSingerCommand="{Binding OpenSingerCommand}" />
        </DockPanel>

        <!-- 安装器先于文件选择；超出菜单容量时转入现有列表选择器。 -->
        <c:FabMenu x:Name="InstallerMenu" Actions="{Binding InstallerActions}"
                   IsExpanded="{Binding IsMenuExpanded}" OpenLabel="{DynamicResource SingerManagement.Install}" />

    </Panel>
</UserControl>
