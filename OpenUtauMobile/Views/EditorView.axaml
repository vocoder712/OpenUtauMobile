<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:localTokens="clr-namespace:OpenUtauMobile.Views.Tokens"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenUtauMobile.ViewModels"
             xmlns:local="clr-namespace:OpenUtauMobile"
             mc:Ignorable="d"
             x:Class="OpenUtauMobile.Views.EditorView"
             xmlns:c="clr-namespace:OpenUtauMobile.Controls"
             xmlns:tools="clr-namespace:OpenUtauMobile.Tools"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:foundation="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Foundation"
             xmlns:semantic="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Semantic"
             x:DataType="vm:EditorViewModel"
             Background="{DynamicResource DynamicResource Sem.Color.SurfaceContainerLow}">

    <UserControl.Resources>
        <tools:SnapDivToLabelConverter x:Key="SnapDivToLabelConverter" />
        <tools:ProgressToWidthConverter x:Key="ProgressToWidthConverter" />
        <tools:PathToFileNameConverter x:Key="PathToFileName" />
        <tools:PathToDirectoryConverter x:Key="PathToDirectory" />
        <tools:DoubleToGridLengthConverter x:Key="DoubleToGridLengthConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Grid#SplitDragHandle, Grid#PhonemeSplitHandlePill">
            <Setter Property="Opacity" Value="{x:Static localTokens:EditorTokens.HandleRestOpacity}" />
            <Setter Property="Cursor" Value="{x:Static local:ViewConstants.cursorSizeNS}" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="{x:Static foundation:MotionTokens.DurationBase}" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid#SplitDragHandle:pointerover, Grid#PhonemeSplitHandlePill:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Grid#SplitDragHandle:pressed, Grid#PhonemeSplitHandlePill:pressed">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top" Classes="TopBar">
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceS}">
                <Button Grid.Column="0"
                        Classes="TopBarBtn"
                        Command="{Binding BackCommand}"
                        ToolTip.Tip="{DynamicResource Common.Back}"
                        Content="{iconPacks:PhosphorIcons ArrowLeft}">
                </Button>
                <!-- 标题 -->
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="{x:Static foundation:LayoutTokens.SpaceXS}"
                            Margin="0,0,8,0">
                    <TextBlock Text="{Binding ProjectPath, Converter={StaticResource PathToFileName}}"
                               FontSize="{x:Static semantic:TypographyTokens.BodyLSize}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ProjectPath, Converter={StaticResource PathToDirectory}}"
                               FontSize="{x:Static semantic:TypographyTokens.LabelSSize}"
                               Opacity="0.50"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- 保存 混音 更多 -->
                <StackPanel Grid.Column="2"
                            IsEnabled="{Binding !IsLoadingProject}"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Command="{Binding SaveCommand}"
                            ToolTip.Tip="{DynamicResource Editor.Save}"
                            Classes="TopBarBtn"
                            Content="{iconPacks:PhosphorIcons FloppyDisk}">
                    </Button>
                    <Button x:Name="OpenMixerButton" Classes="TopBarBtn" Click="OnOpenMixerClick"
                            ToolTip.Tip="{DynamicResource Mixer.Title}"
                            Content="{iconPacks:PhosphorIcons SlidersHorizontal}" />
                    <Button Command="{Binding ShowMorePopupCommand}"
                            ToolTip.Tip="{DynamicResource Editor.More}"
                            Classes="TopBarBtn"
                            Content="{iconPacks:PhosphorIcons DotsThreeVertical}">
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <!-- 主编辑区，分为走带编曲（上）和钢琴卷帘（下）两大部分
             第二列用于支持响应式布局 -->
        <Grid x:Name="EditorGrid" RowDefinitions="200,*" ColumnDefinitions="*,0"
              IsEnabled="{Binding !IsLoadingProject}">
            <!-- 走带编曲 -->
            <c:ArrangementSurface x:Name="Arrangement" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" />

            <!-- 同层编辑区：钢琴卷帘与混音面板互斥挂载。 -->
            <Panel x:Name="DetailAreaHost" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ClipToBounds="True">
            <c:PianoRollSurface x:Name="PianoSurface" />
            </Panel>

            <!-- 分割线与拖拽手柄叠加层（仅手柄可命中） -->
            <Canvas x:Name="SplitOverlay"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    ZIndex="350"
                    ClipToBounds="True">
                <Border x:Name="SplitGuideLine"
                        Width="{x:Static local:ViewConstants.EditorSplitLineThickness}"
                        Height="{x:Static local:ViewConstants.EditorSplitLineThickness}"
                        Background="{DynamicResource Sem.Color.OutlineVariant}"
                        IsHitTestVisible="False" />

                <Grid x:Name="SplitDragHandle"
                      Width="{x:Static local:ViewConstants.EditorSplitHandleWidth}"
                      Height="{x:Static local:ViewConstants.EditorSplitHandleHeight}"
                        RenderTransformOrigin="0.5,0.5"
                      ToolTip.Tip="拖拽调整编辑区布局"
                      IsHitTestVisible="True">
                    <Path
                        Data="M 0,12
                       C 0,12 3,12 6,6
                       C 9,0 12,0 12,0
                       H 36
                       C 36,0 39,0 42,6
                       C 45,12 48,12 48,12
                       C 48,12 45,12 42,18
                       C 39,24 36,24 36,24
                       H 12
                       C 12,24 9,24 6,18
                       C 3,12 0,12 0,12
                       Z"
                        Fill="{DynamicResource Sem.Color.Surface}"
                        Stroke="{DynamicResource Sem.Color.Outline}"
                        StrokeThickness="1"
                        Stretch="Fill" />
                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="{x:Static foundation:LayoutTokens.SpaceXS}"
                                IsHitTestVisible="False">
                        <Rectangle Width="12" Height="2" RadiusX="1" RadiusY="1"
                                   Fill="{DynamicResource Sem.Color.OnSurfaceVariant}" Opacity="0.58" />
                        <Rectangle Width="12" Height="2" RadiusX="1" RadiusY="1"
                                   Fill="{DynamicResource Sem.Color.OnSurfaceVariant}" Opacity="0.58" />
                    </StackPanel>
                </Grid>
            </Canvas>

            <!-- 渲染等待提示（全局悬浮） -->
            <Border Grid.Row="0" Grid.RowSpan="2"
                    Grid.Column="0" Grid.ColumnSpan="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,48,0,0"
                    Background="{DynamicResource Sem.Color.Surface}"
                    BorderBrush="{DynamicResource Sem.Color.OutlineVariant}"
                    BorderThickness="1"
                    CornerRadius="{x:Static foundation:ShapeTokens.CornerXL}"
                    IsVisible="{Binding IsWaitingRender}"
                    IsHitTestVisible="False"
                    ZIndex="1000" Padding="12,8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="{x:Static localTokens:EditorTokens.RenderShadowBlur}" Color="{DynamicResource Sem.Value.Shadow}" Opacity="{x:Static localTokens:EditorTokens.RenderShadowOpacity}"
                                      OffsetX="0" OffsetY="{x:Static localTokens:EditorTokens.RenderShadowOffset}" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal" Spacing="{x:Static foundation:LayoutTokens.SpaceS}" VerticalAlignment="Center">
                    <TextBlock Text="●" Foreground="{DynamicResource Sem.Color.Warning}" FontSize="10"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Editor.Rendering}"
                               Foreground="{DynamicResource Sem.Color.OnSurface}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 放大镜控件，置于最顶层，绝对布局于左上角 -->
            <!-- 将其放在 EditorGrid 的最后，这样它会覆盖在 TrackArea 和 PianoRoll 之上 -->
            <c:MagnifierControl
                x:Name="PitchMagnifier"
                Grid.Row="0" Grid.RowSpan="2"
                Grid.Column="0" Grid.ColumnSpan="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                LensSize="200,200"
                CornerRadius="{x:Static foundation:ShapeTokens.CornerXL}"
                Background="{DynamicResource Sem.Color.SurfaceContainer}"
                BorderBrush="{DynamicResource Sem.Color.OutlineVariant}"
                ShadowColor="{DynamicResource Sem.Value.Shadow}"
                IsHitTestVisible="False"
                Focusable="False"
                IsVisible="False"
                ZIndex="200"
                Margin="12" />
        </Grid>
    </DockPanel>
</UserControl>
