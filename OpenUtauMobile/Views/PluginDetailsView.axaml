<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OpenUtauMobile.ViewModels"
             xmlns:foundation="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Foundation"
             xmlns:semantic="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Semantic"
             xmlns:icons="https://github.com/MahApps/IconPacks.Avalonia"
             x:Class="OpenUtauMobile.Views.PluginDetailsView"
             x:DataType="vm:PluginDetailsViewModel">
    <UserControl.Resources>
        <DataTemplate x:Key="PluginMetadataTemplate" x:DataType="vm:PluginDetailItem">
            <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                <TextBlock Classes="Supporting" Text="{Binding Label}" />
                <SelectableTextBlock Text="{Binding Value}" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="{x:Static semantic:TypographyTokens.TitleMSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Sem.Color.Primary}" />
        </Style>
        <Style Selector="TextBlock.Supporting">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource Sem.Color.OnSurfaceVariant}" />
            <Setter Property="FontSize" Value="{x:Static semantic:TypographyTokens.BodyMSize}" />
        </Style>
        <Style Selector="Button.DetailAction">
            <Setter Property="MinHeight" Value="72" />
        </Style>
        <Style Selector="Button.DetailAction TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.ActionBody">
            <Setter Property="Padding" Value="16,12" />
        </Style>
    </UserControl.Styles>
    <Panel Background="{DynamicResource Sem.Color.Surface}">
        <DockPanel>
            <!-- 固定顶栏与加载条沿用应用导航页的公共角色。 -->
            <Border DockPanel.Dock="Top" Classes="TopBar">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceS}">
                    <Button Classes="TopBarBtn" Command="{Binding BackCommand}"
                            Content="{icons:PhosphorIcons ArrowLeft}" ToolTip.Tip="{DynamicResource Common.Back}"
                            AutomationProperties.Name="{DynamicResource Common.Back}" />
                    <TextBlock Grid.Column="1" Classes="TopBarTitle" Text="{DynamicResource PluginDetails.Title}" />
                    <Button Grid.Column="2" Classes="TopBarBtn" Command="{Binding RefreshCommand}"
                            Content="{icons:PhosphorIcons ArrowsClockwise}" ToolTip.Tip="{DynamicResource Common.Refresh}"
                            AutomationProperties.Name="{DynamicResource Common.Refresh}" />
                </Grid>
            </Border>
            <ProgressBar DockPanel.Dock="Top" Classes="TopBarLoading" IsVisible="{Binding IsBusy}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Padding="20,16,20,24">
                    <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceL}" MaxWidth="840" HorizontalAlignment="Stretch">
                        <!-- 插件身份和状态紧邻启用开关，所有持久化变更明确提示重启生效。 -->
                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceS}">
                            <TextBlock Text="{Binding Title}" FontSize="{x:Static semantic:TypographyTokens.HeadlineSSize}"
                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Classes="Supporting" Text="{Binding Status}" />
                            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Sem.Color.Error}" />
                        </StackPanel>
                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceM}" MinHeight="56">
                                <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource PluginDetails.EnablePlugin}" TextWrapping="Wrap"
                                               FontSize="{x:Static semantic:TypographyTokens.BodyLSize}" />
                                    <TextBlock Classes="Supporting" Text="{DynamicResource PluginDetails.RestartDescription}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsPluginEnabled, Mode=TwoWay}"
                                              IsEnabled="{Binding CanChangeEnabled}" OnContent="{x:Null}" OffContent="{x:Null}"
                                              AutomationProperties.Name="{DynamicResource PluginDetails.EnablePlugin}" />
                            </Grid>
                        </Border>

                        <!-- 默认仅展示关键身份信息，完整元数据和签名说明按需展开。 -->
                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceS}">
                            <TextBlock Classes="SectionTitle" Text="{DynamicResource PluginDetails.BasicInfo}" />
                            <Border Classes="card">
                                <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceM}">
                                    <ItemsControl ItemsSource="{Binding SummaryMetadata}" ItemTemplate="{StaticResource PluginMetadataTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceM}" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <!-- 隐藏项直接延续摘要的布局，底部透明箭头始终作为展开与收起入口。 -->
                                    <StackPanel IsVisible="{Binding IsMetadataExpanded}" Spacing="{x:Static foundation:LayoutTokens.SpaceM}">
                                        <ItemsControl ItemsSource="{Binding AdditionalMetadata}" ItemTemplate="{StaticResource PluginMetadataTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceM}" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <TextBlock Classes="Supporting" Text="{DynamicResource PluginDetails.SignatureDescription}" />
                                    </StackPanel>
                                    <ToggleButton Classes="icon" HorizontalAlignment="Center" Background="Transparent"
                                                  Foreground="{DynamicResource Sem.Color.Primary}"
                                                  IsChecked="{Binding IsMetadataExpanded, Mode=TwoWay}"
                                                  ToolTip.Tip="{DynamicResource Common.Details}"
                                                  AutomationProperties.Name="{DynamicResource Common.Details}">
                                        <Panel>
                                            <icons:PackIconPhosphorIcons Kind="CaretDown" IsVisible="{Binding !IsMetadataExpanded}" />
                                            <icons:PackIconPhosphorIcons Kind="CaretUp" IsVisible="{Binding IsMetadataExpanded}" />
                                        </Panel>
                                    </ToggleButton>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 能力来自成功登记的快照；未加载时不会为了查询而执行插件入口。 -->
                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceS}">
                            <TextBlock Classes="SectionTitle" Text="{DynamicResource PluginDetails.Capabilities}" />
                            <Border Classes="card">
                                <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceM}">
                                    <TextBlock Classes="Supporting" Text="{DynamicResource PluginDetails.CapabilitiesDescription}" />
                                    <ItemsControl ItemsSource="{Binding Capabilities}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceM}" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PluginDetailItem">
                                                <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                                    <TextBlock Classes="Supporting" Text="{Binding Label}" />
                                                    <SelectableTextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 配置和数据操作复用 OptionEntry 行为，破坏性动作经确认后排队执行。 -->
                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceS}">
                            <TextBlock Classes="SectionTitle" Text="{DynamicResource PluginDetails.ConfigurationData}" />
                            <Border Background="{DynamicResource Sem.Color.SurfaceContainerLow}"
                                    CornerRadius="{x:Static foundation:ShapeTokens.CornerL}" ClipToBounds="True">
                                <StackPanel>
                                    <Button Classes="OptionEntry DetailAction" Command="{Binding OpenSettingsCommand}">
                                        <Border Classes="ActionBody">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceM}">
                                                <icons:PackIconPhosphorIcons Kind="GearSix" />
                                                <StackPanel Grid.Column="1" Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                                    <TextBlock Text="{DynamicResource PluginWebSettings.Title}" FontSize="{x:Static semantic:TypographyTokens.BodyLSize}" />
                                                    <TextBlock Classes="Supporting" Text="{Binding SettingsDescription}" />
                                                </StackPanel>
                                                <icons:PackIconPhosphorIcons Grid.Column="2" Kind="CaretRight" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                    <Button Classes="OptionEntry DetailAction" Command="{Binding CopyDataDirectoryCommand}"
                                            ToolTip.Tip="{DynamicResource Common.Copy}">
                                        <Border Classes="ActionBody">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceM}">
                                                <icons:PackIconPhosphorIcons Kind="Folder" />
                                                <StackPanel Grid.Column="1" Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                                    <TextBlock Text="{DynamicResource PluginDetails.DataDirectory}" FontSize="{x:Static semantic:TypographyTokens.BodyLSize}" />
                                                    <TextBlock Classes="Supporting" Text="{Binding DataDirectory}" IsVisible="{Binding HasRegistration}" />
                                                    <TextBlock Classes="Supporting" Text="{DynamicResource PluginDetails.DataUnavailable}" IsVisible="{Binding !HasRegistration}" />
                                                </StackPanel>
                                                <icons:PackIconPhosphorIcons Grid.Column="2" Kind="Copy" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                    <Button Classes="OptionEntry DetailAction" Command="{Binding ClearDataCommand}">
                                        <Border Classes="ActionBody">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceM}">
                                                <icons:PackIconPhosphorIcons Kind="Broom" Foreground="{DynamicResource Sem.Color.Error}" />
                                                <StackPanel Grid.Column="1" Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                                    <TextBlock Text="{Binding DataClearLabel}" Foreground="{DynamicResource Sem.Color.Error}"
                                                               FontSize="{x:Static semantic:TypographyTokens.BodyLSize}" />
                                                    <TextBlock Classes="Supporting" Text="{Binding DataDescription}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Border Classes="card" Padding="0">
                            <Button Classes="OptionEntry DetailAction" Command="{Binding UninstallCommand}">
                                <Border Classes="ActionBody">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceM}">
                                        <icons:PackIconPhosphorIcons Kind="Trash" Foreground="{DynamicResource Sem.Color.Error}" />
                                        <StackPanel Grid.Column="1" Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                            <TextBlock Text="{Binding UninstallLabel}" Foreground="{DynamicResource Sem.Color.Error}"
                                                       FontSize="{x:Static semantic:TypographyTokens.BodyLSize}" />
                                            <TextBlock Classes="Supporting" Text="{DynamicResource PluginDetails.UninstallDescription}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </Border>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </DockPanel>
    </Panel>
</UserControl>
