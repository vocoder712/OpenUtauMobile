<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:foundation="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Foundation"
    xmlns:theme="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenUtauMobile.ViewModels"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:components="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Components"
             xmlns:semantic="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Semantic"
             mc:Ignorable="d"
             x:Class="OpenUtauMobile.Views.AboutView"
             x:DataType="vm:AboutViewModel">

    <Panel Background="{DynamicResource Sem.Color.Surface}">
        <DockPanel>
            <!-- Top Bar -->
            <Border DockPanel.Dock="Top" Classes="TopBar">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceS}">
                    <Button Grid.Column="0"
                            Classes="TopBarBtn"
                            Command="{Binding BackCommand}"
                            ToolTip.Tip="{DynamicResource Common.Back}"
                            Content="{iconPacks:PhosphorIcons ArrowLeft}" />
                    <TextBlock Grid.Column="1" Classes="TopBarTitle" Text="{DynamicResource About.Title}" />
                </Grid>
            </Border>

            <!-- 主体-->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Border Padding="16,16,16,24">
                    <StackPanel>
                        <!-- Hero -->
                        <StackPanel HorizontalAlignment="Center"
                                    Margin="0,32,0,24"
                                    Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                            <Border Width="72" Height="72"
                                    CornerRadius="{x:Static foundation:ShapeTokens.CornerXL}"
                                    ClipToBounds="True"
                                    HorizontalAlignment="Center">
                                <Image Source="avares://OpenUtauMobile/Assets/openutau.ico"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            </Border>
                            <!-- logotype -->
                            <Svg Path="avares://OpenUtauMobile/Assets/logotype.svg" HorizontalAlignment="Center"
                                 Css="{DynamicResource SvgCss}"
                                 Margin="0,12,0,0"
                                 Width="300" />
                            <!-- 版本号 -->
                            <TextBlock FontSize="{x:Static semantic:TypographyTokens.BodySSize}"
                                       Opacity="0.40"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="WrapWithOverflow">
                                <Run Text="{DynamicResource About.Version}" />
                                <Run Text="{Binding Version}" />
                            </TextBlock>
                            <!-- 内核版本 -->
                            <TextBlock FontSize="{x:Static semantic:TypographyTokens.BodySSize}"
                                       Opacity="0.40"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center">
                                <Run Text="{DynamicResource About.CoreVersion}" />
                                <Run Text="{Binding CoreVersion}" />
                            </TextBlock>
                            <!-- 构建号 -->
                            <TextBlock FontSize="{x:Static semantic:TypographyTokens.BodySSize}"
                                       Opacity="0.40"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center">
                                <Run Text="{DynamicResource About.BuildNumber}" />
                                <Run Text="{Binding BuildNumber}" />
                            </TextBlock>
                            <!-- 构建时间 -->
                            <TextBlock FontSize="{x:Static semantic:TypographyTokens.BodySSize}"
                                       Opacity="0.40"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center">
                                <Run Text="{DynamicResource About.BuildTime}" />
                                <Run Text="{Binding BuildTimestamp}" />
                            </TextBlock>
                            <!-- 构建系统 -->
                            <TextBlock FontSize="{x:Static semantic:TypographyTokens.BodySSize}"
                                       Opacity="0.40"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center">
                                <Run Text="{DynamicResource About.BuildMachine}" />
                                <Run Text="{Binding BuildMachine}" />
                            </TextBlock>
                            <!-- Commit ID -->
                            <TextBlock FontSize="{x:Static semantic:TypographyTokens.BodySSize}"
                                       Opacity="0.40"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center">
                                <Run Text="{DynamicResource About.CommitId}" />
                                <Run Text="{Binding SourceCommit}" />
                            </TextBlock>
                            <!-- Action 运行 ID -->
                            <TextBlock FontSize="{x:Static semantic:TypographyTokens.BodySSize}"
                                       Opacity="0.40"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center">
                                <Run Text="{DynamicResource About.ActionId}" />
                                <Run Text="{Binding ActionRunId}" />
                            </TextBlock>
                        </StackPanel>

                        <!-- 选项栏 -->
                        <Border CornerRadius="{x:Static foundation:ShapeTokens.CornerXL}" Background="{DynamicResource Sem.Color.SurfaceContainerLow}"
                                ClipToBounds="True">
                            <StackPanel>
                                <!-- 项目主页 -->
                                <Button Classes="OptionEntry" Command="{Binding OpenHomepageCommand}">
                                    <Border Padding="{x:Static components:OptionEntryTokens.TrailingInset}">
                                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceS}" MinHeight="{x:Static components:OptionEntryTokens.MinHeight}">
                                            <Panel Grid.Column="0" Width="{x:Static components:OptionEntryTokens.IconContainerSize}" Height="{x:Static components:OptionEntryTokens.IconContainerSize}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                                <Border Width="{x:Static components:OptionEntryTokens.IconContainerSize}" Height="{x:Static components:OptionEntryTokens.IconContainerSize}" CornerRadius="{x:Static foundation:ShapeTokens.CornerL}"
                                                        Background="{DynamicResource Sem.Color.PrimaryContainer}" />
                                                <iconPacks:PackIconPhosphorIcons Width="{x:Static semantic:IconTokens.Compact}" Height="{x:Static semantic:IconTokens.Compact}"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="{DynamicResource Sem.Color.Primary}"
                                                                                 Kind="GlobeSimple" />
                                            </Panel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                                <TextBlock Text="{DynamicResource About.ProjectHome}" FontSize="{x:Static semantic:TypographyTokens.BodyLSize}"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="github.com/vocoder712/OpenUtauMobile" FontSize="{x:Static semantic:TypographyTokens.LabelSSize}"
                                                           Opacity="0.50" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Panel Grid.Column="2" Width="{x:Static components:OptionEntryTokens.IconContainerSize}" Height="{x:Static components:OptionEntryTokens.IconContainerSize}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                                <iconPacks:PackIconPhosphorIcons
                                                    Width="14"
                                                    Height="14"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource Sem.Color.OnSurfaceVariant}"
                                                    Kind="ArrowSquareOut" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                </Button>
                                <Border Height="1" Opacity="0.08" Margin="52,0,12,0"
                                        Background="{DynamicResource Sem.Color.OnSurfaceVariant}" />
                                <!-- 开放源代码许可 -->
                                <Button Classes="OptionEntry" Command="{Binding OpenLicenseCommand}">
                                    <Border Padding="{x:Static components:OptionEntryTokens.TrailingInset}">
                                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceS}" MinHeight="{x:Static components:OptionEntryTokens.MinHeight}">
                                            <Panel Grid.Column="0" Width="{x:Static components:OptionEntryTokens.IconContainerSize}" Height="{x:Static components:OptionEntryTokens.IconContainerSize}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                                <Border Width="{x:Static components:OptionEntryTokens.IconContainerSize}" Height="{x:Static components:OptionEntryTokens.IconContainerSize}" CornerRadius="{x:Static foundation:ShapeTokens.CornerL}"
                                                        Background="{DynamicResource Sem.Color.PrimaryContainer}" />
                                                <iconPacks:PackIconPhosphorIcons Width="{x:Static semantic:IconTokens.Compact}" Height="{x:Static semantic:IconTokens.Compact}"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="{DynamicResource Sem.Color.Primary}"
                                                                                 Kind="Scales" />
                                            </Panel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                                <TextBlock Text="{DynamicResource About.License}" FontSize="{x:Static semantic:TypographyTokens.BodyLSize}"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="Apache-2.0" FontSize="{x:Static semantic:TypographyTokens.LabelSSize}" Opacity="0.50"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Panel Grid.Column="2" Width="{x:Static components:OptionEntryTokens.IconContainerSize}" Height="{x:Static components:OptionEntryTokens.IconContainerSize}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                                <iconPacks:PackIconPhosphorIcons
                                                    Width="14"
                                                    Height="14"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource Sem.Color.OnSurfaceVariant}"
                                                    Kind="ArrowSquareOut" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                </Button>
                                <Border Height="1" Opacity="0.08" Margin="52,0,12,0"
                                        Background="{DynamicResource Sem.Color.OnSurfaceVariant}" />
                                <!-- 致谢 -->
                                <Button Classes="OptionEntry" Command="{Binding OpenCreditsCommand}">
                                    <Border Padding="{x:Static components:OptionEntryTokens.TrailingInset}">
                                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceS}" MinHeight="{x:Static components:OptionEntryTokens.MinHeight}">
                                            <Panel Grid.Column="0" Width="{x:Static components:OptionEntryTokens.IconContainerSize}" Height="{x:Static components:OptionEntryTokens.IconContainerSize}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                                <Border Width="{x:Static components:OptionEntryTokens.IconContainerSize}" Height="{x:Static components:OptionEntryTokens.IconContainerSize}" CornerRadius="{x:Static foundation:ShapeTokens.CornerL}"
                                                        Background="{DynamicResource Sem.Color.PrimaryContainer}" />
                                                <iconPacks:PackIconPhosphorIcons Width="{x:Static semantic:IconTokens.Compact}" Height="{x:Static semantic:IconTokens.Compact}"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="{DynamicResource Sem.Color.Primary}"
                                                                                 Kind="Heart" />
                                            </Panel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                                <TextBlock Text="{DynamicResource About.Credits}" FontSize="{x:Static semantic:TypographyTokens.BodyLSize}"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{DynamicResource About.Credits.Desc}" FontSize="{x:Static semantic:TypographyTokens.LabelSSize}"
                                                           Opacity="0.50" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Panel Grid.Column="2" Width="{x:Static components:OptionEntryTokens.IconContainerSize}" Height="{x:Static components:OptionEntryTokens.IconContainerSize}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                                <iconPacks:PackIconPhosphorIcons
                                                    Width="14"
                                                    Height="14"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource Sem.Color.OnSurfaceVariant}"
                                                    Kind="ArrowSquareOut" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                </Button>
                                <Border Height="1" Opacity="0.08" Margin="52,0,12,0"
                                        Background="{DynamicResource Sem.Color.OnSurfaceVariant}" />
                                <!-- 贡献 -->
                                <Button Classes="OptionEntry" Command="{Binding OpenFeedbackCommand}">
                                    <Border Padding="{x:Static components:OptionEntryTokens.TrailingInset}">
                                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceS}" MinHeight="{x:Static components:OptionEntryTokens.MinHeight}">
                                            <Panel Grid.Column="0" Width="{x:Static components:OptionEntryTokens.IconContainerSize}" Height="{x:Static components:OptionEntryTokens.IconContainerSize}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                                <Border Width="{x:Static components:OptionEntryTokens.IconContainerSize}" Height="{x:Static components:OptionEntryTokens.IconContainerSize}" CornerRadius="{x:Static foundation:ShapeTokens.CornerL}"
                                                        Background="{DynamicResource Sem.Color.PrimaryContainer}" />
                                                <iconPacks:PackIconPhosphorIcons Width="{x:Static semantic:IconTokens.Compact}" Height="{x:Static semantic:IconTokens.Compact}"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="{DynamicResource Sem.Color.Primary}"
                                                                                 Kind="BracketsCurly" />
                                            </Panel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                                <TextBlock Text="{DynamicResource About.Contribute}" FontSize="{x:Static semantic:TypographyTokens.BodyLSize}"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{DynamicResource About.Contribute.Desc}" FontSize="{x:Static semantic:TypographyTokens.LabelSSize}"
                                                           Opacity="0.50" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Panel Grid.Column="2" Width="{x:Static components:OptionEntryTokens.IconContainerSize}" Height="{x:Static components:OptionEntryTokens.IconContainerSize}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                                <iconPacks:PackIconPhosphorIcons
                                                    Width="14"
                                                    Height="14"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource Sem.Color.OnSurfaceVariant}"
                                                    Kind="ArrowSquareOut" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>
            </ScrollViewer>
        </DockPanel>
    </Panel>
</UserControl>
