<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:foundation="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Foundation"
    xmlns:theme="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenUtauMobile.ViewModels"
             xmlns:conv="clr-namespace:OpenUtauMobile.Tools"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:semantic="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Semantic"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="OpenUtauMobile.Views.SettingsView"
             x:Name="Root"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Resources>
        <conv:EnumEqualConverter x:Key="EnumEqual" />
        <conv:EnumNotEqualConverter x:Key="EnumNotEqual" />
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="/Views/Styles/SettingsView.axaml" />
    </UserControl.Styles>

    <Panel Background="{DynamicResource Sem.Color.Surface}">
        <DockPanel>

            <Border DockPanel.Dock="Top" Classes="TopBar">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceS}">
                    <Button Grid.Column="0"
                            Classes="TopBarBtn"
                            Command="{Binding BackCommand}"
                            ToolTip.Tip="{DynamicResource Common.Back}"
                            Content="{iconPacks:PhosphorIcons ArrowLeft}">
                    </Button>
                    <TextBlock Grid.Column="1" Classes="TopBarTitle" Text="{DynamicResource Settings.Title}" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="Auto,Auto,*">

                <Border Grid.Column="0"
                        Background="{DynamicResource Sem.Color.SurfaceContainer}"
                        Width="{Binding NavWidth}">
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Width"
                                              Duration="{x:Static foundation:MotionTokens.DurationMedium}"
                                              Easing="CubicEaseInOut" />
                        </Transitions>
                    </Border.Transitions>

                    <DockPanel ClipToBounds="True">

                        <Border DockPanel.Dock="Bottom"
                                Height="1" Opacity="0.08"
                                Background="{DynamicResource Sem.Color.OnSurfaceVariant}" />
                        <Button DockPanel.Dock="Bottom"
                                Classes="NavToggle"
                                Command="{Binding ToggleNavCommand}">
                            <Grid ColumnDefinitions="64,*" MinHeight="{x:Static semantic:InteractionTokens.TouchTarget}">
                                <Panel Grid.Column="0" Width="64">
                                    <iconPacks:PackIconPhosphorIcons Width="{x:Static semantic:IconTokens.Compact}" Height="{x:Static semantic:IconTokens.Compact}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource Sem.Color.OnSurfaceVariant}"
                                          Kind="CaretLeft"
                                          IsVisible="{Binding IsNavExpanded}" />
                                    <iconPacks:PackIconPhosphorIcons Width="{x:Static semantic:IconTokens.Compact}" Height="{x:Static semantic:IconTokens.Compact}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource Sem.Color.OnSurfaceVariant}"
                                          Kind="CaretRight"
                                          IsVisible="{Binding !IsNavExpanded}" />
                                </Panel>
                                <TextBlock Grid.Column="1"
                                           Text="{DynamicResource Common.CollapseRail}"
                                           FontSize="13"
                                           Opacity="0.60"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding IsNavExpanded}" />
                            </Grid>
                        </Button>

                        <StackPanel ClipToBounds="True">

                            <Button Classes="NavItem"
                                    Command="{Binding SelectCategoryCommand}"
                                    CommandParameter="{x:Static vm:SettingsCategory.EditAndBehaviour}">
                                <Panel>
                                    <Border Width="3"
                                            CornerRadius="0,2,2,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Stretch"
                                            Background="{DynamicResource Sem.Color.Primary}"
                                            IsVisible="{Binding SelectedCategory,
                                                Converter={StaticResource EnumEqual},
                                                ConverterParameter=EditAndBehaviour}" />
                                    <Border Background="{DynamicResource Sem.Color.Primary}"
                                            Opacity="0.08"
                                            IsVisible="{Binding SelectedCategory,
                                                Converter={StaticResource EnumEqual},
                                                ConverterParameter=EditAndBehaviour}" />
                                    <Grid ColumnDefinitions="64,*" MinHeight="56">
                                        <Panel Grid.Column="0" Width="64" HorizontalAlignment="Stretch">
                                            <Border Width="36" Height="36"
                                                    CornerRadius="{x:Static foundation:ShapeTokens.CornerL}"
                                                    HorizontalAlignment="Center"
                                                    Background="{DynamicResource Sem.Color.Primary}"
                                                    Opacity="0.18"
                                                    IsVisible="{Binding SelectedCategory,
                                                        Converter={StaticResource EnumEqual},
                                                        ConverterParameter=EditAndBehaviour}" />
                                            <iconPacks:PackIconPhosphorIcons
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{DynamicResource Sem.Color.Primary}"
                                                  Kind="NotePencil"
                                                  IsVisible="{Binding SelectedCategory,
                                                      Converter={StaticResource EnumEqual},
                                                      ConverterParameter=EditAndBehaviour}"  Width="{x:Static semantic:IconTokens.Standard}"  Height="{x:Static semantic:IconTokens.Standard}" />
                                            <iconPacks:PackIconPhosphorIcons
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{DynamicResource Sem.Color.OnSurfaceVariant}"
                                                  Kind="NotePencil"
                                                  IsVisible="{Binding SelectedCategory,
                                                      Converter={StaticResource EnumNotEqual},
                                                      ConverterParameter=EditAndBehaviour}"  Width="{x:Static semantic:IconTokens.Standard}"  Height="{x:Static semantic:IconTokens.Standard}" />
                                        </Panel>
                                        <Border Padding="0,0,12,0" Grid.Column="1" IsVisible="{Binding IsNavExpanded}">
                                            <StackPanel
                                                        VerticalAlignment="Center"
                                                        Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                                <TextBlock Text="{DynamicResource Settings.Nav.EditAndBehaviour}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{DynamicResource Settings.Nav.EditAndBehaviour.Sub}"
                                                           FontSize="11" Opacity="0.50"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Panel>
                            </Button>

                            <Button Classes="NavItem"
                                    Command="{Binding SelectCategoryCommand}"
                                    CommandParameter="{x:Static vm:SettingsCategory.RenderAndPerformance}">
                                <Panel>
                                    <Border Width="3"
                                            CornerRadius="0,2,2,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Stretch"
                                            Background="{DynamicResource Sem.Color.Primary}"
                                            IsVisible="{Binding SelectedCategory,
                                                Converter={StaticResource EnumEqual},
                                                ConverterParameter=RenderAndPerformance}" />
                                    <Border Background="{DynamicResource Sem.Color.Primary}"
                                            Opacity="0.08"
                                            IsVisible="{Binding SelectedCategory,
                                                Converter={StaticResource EnumEqual},
                                                ConverterParameter=RenderAndPerformance}" />
                                    <Grid ColumnDefinitions="64,*" MinHeight="56">
                                        <Panel Grid.Column="0" Width="64" HorizontalAlignment="Stretch">
                                            <Border Width="36" Height="36"
                                                    CornerRadius="{x:Static foundation:ShapeTokens.CornerL}"
                                                    HorizontalAlignment="Center"
                                                    Background="{DynamicResource Sem.Color.Primary}"
                                                    Opacity="0.18"
                                                    IsVisible="{Binding SelectedCategory,
                                                        Converter={StaticResource EnumEqual},
                                                        ConverterParameter=RenderAndPerformance}" />
                                            <iconPacks:PackIconPhosphorIcons
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{DynamicResource Sem.Color.Primary}"
                                                  Kind="Cpu"
                                                  IsVisible="{Binding SelectedCategory,
                                                      Converter={StaticResource EnumEqual},
                                                      ConverterParameter=RenderAndPerformance}"  Width="{x:Static semantic:IconTokens.Standard}"  Height="{x:Static semantic:IconTokens.Standard}" />
                                            <iconPacks:PackIconPhosphorIcons
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{DynamicResource Sem.Color.OnSurfaceVariant}"
                                                  Kind="Cpu"
                                                  IsVisible="{Binding SelectedCategory,
                                                      Converter={StaticResource EnumNotEqual},
                                                      ConverterParameter=RenderAndPerformance}"  Width="{x:Static semantic:IconTokens.Standard}"  Height="{x:Static semantic:IconTokens.Standard}" />
                                        </Panel>
                                        <Border Padding="0,0,12,0" Grid.Column="1" IsVisible="{Binding IsNavExpanded}">
                                            <StackPanel
                                                        VerticalAlignment="Center"
                                                        Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                                <TextBlock Text="{DynamicResource Settings.Nav.RenderAndPerformance}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{DynamicResource Settings.Nav.RenderAndPerformance.Sub}"
                                                           FontSize="11" Opacity="0.50"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Panel>
                            </Button>

                            <Button Classes="NavItem"
                                    Command="{Binding SelectCategoryCommand}"
                                    CommandParameter="{x:Static vm:SettingsCategory.FileAndStorage}">
                                <Panel>
                                    <Border Width="3"
                                            CornerRadius="0,2,2,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Stretch"
                                            Background="{DynamicResource Sem.Color.Primary}"
                                            IsVisible="{Binding SelectedCategory,
                                                Converter={StaticResource EnumEqual},
                                                ConverterParameter=FileAndStorage}" />
                                    <Border Background="{DynamicResource Sem.Color.Primary}"
                                            Opacity="0.08"
                                            IsVisible="{Binding SelectedCategory,
                                                Converter={StaticResource EnumEqual},
                                                ConverterParameter=FileAndStorage}" />
                                    <Grid ColumnDefinitions="64,*" MinHeight="56">
                                        <Panel Grid.Column="0" Width="64" HorizontalAlignment="Stretch">
                                            <Border Width="36" Height="36"
                                                    CornerRadius="{x:Static foundation:ShapeTokens.CornerL}"
                                                    HorizontalAlignment="Center"
                                                    Background="{DynamicResource Sem.Color.Primary}"
                                                    Opacity="0.18"
                                                    IsVisible="{Binding SelectedCategory,
                                                        Converter={StaticResource EnumEqual},
                                                        ConverterParameter=FileAndStorage}" />
                                            <iconPacks:PackIconPhosphorIcons
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{DynamicResource Sem.Color.Primary}"
                                                  Kind="HardDrives"
                                                  IsVisible="{Binding SelectedCategory,
                                                      Converter={StaticResource EnumEqual},
                                                      ConverterParameter=FileAndStorage}"  Width="{x:Static semantic:IconTokens.Standard}"  Height="{x:Static semantic:IconTokens.Standard}" />
                                            <iconPacks:PackIconPhosphorIcons
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{DynamicResource Sem.Color.OnSurfaceVariant}"
                                                  Kind="HardDrives"
                                                  IsVisible="{Binding SelectedCategory,
                                                      Converter={StaticResource EnumNotEqual},
                                                      ConverterParameter=FileAndStorage}"  Width="{x:Static semantic:IconTokens.Standard}"  Height="{x:Static semantic:IconTokens.Standard}" />
                                        </Panel>
                                        <Border Padding="0,0,12,0" Grid.Column="1" IsVisible="{Binding IsNavExpanded}">
                                            <StackPanel
                                                        VerticalAlignment="Center"
                                                        Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                                <TextBlock Text="{DynamicResource Settings.Nav.FileAndStorage}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{DynamicResource Settings.Nav.FileAndStorage.Sub}"
                                                           FontSize="11" Opacity="0.50"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Panel>
                            </Button>

                            <Button Classes="NavItem"
                                    Command="{Binding SelectCategoryCommand}"
                                    CommandParameter="{x:Static vm:SettingsCategory.AppearanceAndLanguage}">
                                <Panel>
                                    <Border Width="3"
                                            CornerRadius="0,2,2,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Stretch"
                                            Background="{DynamicResource Sem.Color.Primary}"
                                            IsVisible="{Binding SelectedCategory,
                                                Converter={StaticResource EnumEqual},
                                                ConverterParameter=AppearanceAndLanguage}" />
                                    <Border Background="{DynamicResource Sem.Color.Primary}"
                                            Opacity="0.08"
                                            IsVisible="{Binding SelectedCategory,
                                                Converter={StaticResource EnumEqual},
                                                ConverterParameter=AppearanceAndLanguage}" />
                                    <Grid ColumnDefinitions="64,*" MinHeight="56">
                                        <Panel Grid.Column="0" Width="64" HorizontalAlignment="Stretch">
                                            <Border Width="36" Height="36"
                                                    CornerRadius="{x:Static foundation:ShapeTokens.CornerL}"
                                                    HorizontalAlignment="Center"
                                                    Background="{DynamicResource Sem.Color.Primary}"
                                                    Opacity="0.18"
                                                    IsVisible="{Binding SelectedCategory,
                                                        Converter={StaticResource EnumEqual},
                                                        ConverterParameter=AppearanceAndLanguage}" />
                                            <iconPacks:PackIconPhosphorIcons
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{DynamicResource Sem.Color.Primary}"
                                                  Kind="Palette"
                                                  IsVisible="{Binding SelectedCategory,
                                                      Converter={StaticResource EnumEqual},
                                                      ConverterParameter=AppearanceAndLanguage}"  Width="{x:Static semantic:IconTokens.Standard}"  Height="{x:Static semantic:IconTokens.Standard}" />
                                            <iconPacks:PackIconPhosphorIcons
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{DynamicResource Sem.Color.OnSurfaceVariant}"
                                                  Kind="Palette"
                                                  IsVisible="{Binding SelectedCategory,
                                                      Converter={StaticResource EnumNotEqual},
                                                      ConverterParameter=AppearanceAndLanguage}"  Width="{x:Static semantic:IconTokens.Standard}"  Height="{x:Static semantic:IconTokens.Standard}" />
                                        </Panel>
                                        <Border Padding="0,0,12,0" Grid.Column="1" IsVisible="{Binding IsNavExpanded}">
                                            <StackPanel
                                                        VerticalAlignment="Center"
                                                        Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                                <TextBlock Text="{DynamicResource Settings.Nav.AppearanceAndLanguage}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{DynamicResource Settings.Nav.AppearanceAndLanguage.Sub}"
                                                           FontSize="11" Opacity="0.50"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Panel>
                            </Button>

                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1"
                        Width="1"
                        Opacity="0.10"
                        Background="{DynamicResource Sem.Color.OnSurfaceVariant}" />

                <ScrollViewer Grid.Column="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              BringIntoViewOnFocusChange="False">
                    <Border Padding="24,20,24,24">
                        <Panel>

                            <!-- ══════════════════════════════════════════
                                 编辑与行为
                                 ══════════════════════════════════════════ -->
                            <StackPanel
                                IsVisible="{Binding SelectedCategory,
                                Converter={StaticResource EnumEqual},
                                ConverterParameter=EditAndBehaviour}" Spacing="{x:Static foundation:LayoutTokens.SpaceSM}">
                                <TextBlock Classes="CategoryTitle" Text="{DynamicResource Settings.Edit.CategoryTitle}" />

                                <!-- 钢琴键行为 -->
                                <Border Classes="SettingCard">
                                    <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceSM}">
                                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                            <TextBlock Classes="SettingItemTitle"
                                                       Text="{DynamicResource Settings.Edit.PianoKeyBehavior}" />
                                            <TextBlock Classes="PlaceholderText"
                                                       Text="{DynamicResource Settings.Edit.PianoKeyBehavior.Desc}" />
                                        </StackPanel>
                                        <ComboBox HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding AvailablePianoKeyBehaviors}"
                                                  SelectedItem="{Binding SelectedPianoKeyBehavior, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PianoKeyBehaviorOption">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <Border Height="1"
                                                Margin="-20,0,-20,0"
                                                Opacity="0.08"
                                                Background="{DynamicResource Sem.Color.OnSurfaceVariant}"
                                                IsVisible="{Binding SelectedPianoKeyBehavior.Value,
                                                    Converter={StaticResource EnumEqual},
                                                    ConverterParameter=SoundFont}" />

                                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceS}"
                                                    IsVisible="{Binding SelectedPianoKeyBehavior.Value,
                                                        Converter={StaticResource EnumEqual},
                                                        ConverterParameter=SoundFont}">
                                            <TextBlock Classes="SettingItemTitle"
                                                       Text="{DynamicResource Settings.Edit.SoundFontPath}" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceSM}">
                                                <Border Grid.Column="0"
                                                        Background="{DynamicResource Sem.Color.SurfaceContainer}"
                                                        CornerRadius="{x:Static foundation:ShapeTokens.CornerM}"
                                                        VerticalAlignment="Center" Padding="12,8">
                                                    <TextBlock Text="{Binding SoundFontPath}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Opacity="0.65"
                                                               FontSize="13"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <Button Grid.Column="1"
                                                        Classes="filled"
                                                        Content="{DynamicResource Settings.Edit.SoundFontPath.Change}"
                                                        Command="{Binding ChangeSoundFontPathCommand}"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock FontSize="12"
                                                       Opacity="0.65"
                                                       Foreground="{DynamicResource Sem.Color.Primary}"
                                                       IsVisible="{Binding IsSoundFontLoaded}"
                                                       Text="{DynamicResource Settings.Edit.SoundFontPath.Loaded}" />
                                            <TextBlock FontSize="12"
                                                       Opacity="0.65"
                                                       Foreground="{DynamicResource Sem.Color.Error}"
                                                       IsVisible="{Binding !IsSoundFontLoaded}"
                                                       Text="{DynamicResource Settings.Edit.SoundFontPath.NotLoaded}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 走带自动翻页行为 -->
                                <Border Classes="SettingCard">
                                    <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceSM}">
                                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                            <TextBlock Classes="SettingItemTitle"
                                                       Text="{DynamicResource Settings.Edit.AutoScrollBehavior}" />
                                            <TextBlock Classes="PlaceholderText"
                                                       Text="{DynamicResource Settings.Edit.AutoScrollBehavior.Desc}" />
                                        </StackPanel>
                                        <ComboBox HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding AvailableAutoScrollBehaviors}"
                                                  SelectedItem="{Binding SelectedAutoScrollBehavior, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:AutoScrollBehaviorOption">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <!-- Stop Button Behavior -->
                                <Border Classes="SettingCard">
                                    <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceSM}">
                                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                            <TextBlock Classes="SettingItemTitle"
                                                       Text="{DynamicResource Settings.Edit.StopButtonBehavior}" />
                                            <TextBlock Classes="PlaceholderText"
                                                       Text="{DynamicResource Settings.Edit.StopButtonBehavior.Desc}" />
                                        </StackPanel>
                                        <ComboBox HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding AvailableStopButtonBehaviors}"
                                                  SelectedItem="{Binding SelectedStopButtonBehavior, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:StopButtonBehaviorOption">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <!-- 音高线编辑模式画布拖拽 -->
                                <Border Classes="SettingCard">
                                    <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceSM}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceM}">
                                            <StackPanel Grid.Column="0" Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                                <TextBlock Classes="SettingItemTitle"
                                                           Text="{DynamicResource Settings.Edit.PitchPenCanvasDrag}" />
                                                <TextBlock Classes="PlaceholderText"
                                                           Text="{DynamicResource Settings.Edit.PitchPenCanvasDrag.Desc}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1"
                                                          IsChecked="{Binding PitchPenCanvasDragEnabled, Mode=TwoWay}"
                                                          OffContent=""
                                                          OnContent=""
                                                          VerticalAlignment="Center" />
                                        </Grid>

                                        <Border Height="1"
                                                Margin="-20,0,-20,0"
                                                Opacity="0.08"
                                                Background="{DynamicResource Sem.Color.OnSurfaceVariant}" />

                                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceS}" IsEnabled="{Binding PitchPenCanvasDragEnabled}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceM}">
                                                <StackPanel Grid.Column="0" Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                                    <TextBlock Classes="SettingItemTitle"
                                                               Text="{DynamicResource Settings.Edit.PitchPenHitTickExtension}" />
                                                    <TextBlock Classes="PlaceholderText"
                                                               Text="{DynamicResource Settings.Edit.PitchPenHitTickExtension.Desc}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding PitchPenNoteHitTickExtension}"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.65" />
                                            </Grid>
                                            <Slider Minimum="{x:Static vm:SettingsViewModel.PitchPenNoteHitTickExtensionSliderMinimum}"
                                                    Maximum="{x:Static vm:SettingsViewModel.PitchPenNoteHitTickExtensionSliderMaximum}"
                                                    Value="{Binding PitchPenNoteHitTickExtension, Mode=TwoWay}"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True" />

                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceM}" Margin="0,8,0,0">
                                                <StackPanel Grid.Column="0" Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                                    <TextBlock Classes="SettingItemTitle"
                                                               Text="{DynamicResource Settings.Edit.PitchPenHitToneExtension}" />
                                                    <TextBlock Classes="PlaceholderText"
                                                               Text="{DynamicResource Settings.Edit.PitchPenHitToneExtension.Desc}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding PitchPenNoteHitToneExtension}"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.65" />
                                            </Grid>
                                            <Slider Minimum="{x:Static vm:SettingsViewModel.PitchPenNoteHitToneExtensionSliderMinimum}"
                                                    Maximum="{x:Static vm:SettingsViewModel.PitchPenNoteHitToneExtensionSliderMaximum}"
                                                    Value="{Binding PitchPenNoteHitToneExtension, Mode=TwoWay}"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 放大镜设置独立于音高笔画布拖拽开关 -->
                                <Border Classes="SettingCard">
                                    <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceS}">
                                        <TextBlock Classes="SettingItemTitle"
                                                   Text="{DynamicResource Settings.Edit.Magnifier}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceM}">
                                            <TextBlock Text="{DynamicResource Settings.Edit.MagnifierFactor}"
                                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding MagnifierMagnificationFactor, StringFormat='{}{0:0.00#}×'}"
                                                       Foreground="{DynamicResource Sem.Color.OnSurfaceVariant}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <Slider Minimum="0.75" Maximum="2.0"
                                                Value="{Binding MagnifierSliderValue, Mode=TwoWay}"
                                                TickFrequency="0.25" SmallChange="0.25" LargeChange="0.25"
                                                IsSnapToTickEnabled="True"
                                                AutomationProperties.Name="{DynamicResource Settings.Edit.MagnifierFactor}" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="0.75×" Foreground="{DynamicResource Sem.Color.OnSurfaceVariant}" />
                                            <TextBlock Grid.Column="1" Text="2.00×" Foreground="{DynamicResource Sem.Color.OnSurfaceVariant}" />
                                        </Grid>
                                        <TextBlock Text="{DynamicResource Settings.Edit.MagnifierFactor.Desc}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Sem.Color.OnSurfaceVariant}"
                                                   FontSize="{x:Static semantic:TypographyTokens.BodySSize}" />
                                    </StackPanel>
                                </Border>

                                <!-- 回放刷新率 -->
                                <Border Classes="SettingCard">
                                    <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceS}">
                                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                            <TextBlock Text="{DynamicResource Settings.Edit.PlaybackRefreshRate}"
                                                       Classes="SettingItemTitle" />
                                            <TextBlock Text="{Binding PlaybackRefreshRate, StringFormat='{}{0} FPS'}"
                                                       Classes="PlaceholderText" />
                                        </StackPanel>
                                        <Slider Minimum="1" Maximum="60"
                                                Value="{Binding PlaybackRefreshRate, Mode=TwoWay}"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True" />
                                        <TextBlock Classes="PlaceholderText"
                                                   Text="{DynamicResource Settings.Edit.PlaybackRefreshRate.Desc}"
                                                   FontSize="12" />
                                    </StackPanel>
                                </Border>

                                <!-- 立绘显示 -->
                                <Border Classes="SettingCard">
                                    <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceSM}">
                                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                            <TextBlock Classes="SettingItemTitle"
                                                       Text="{DynamicResource Settings.Edit.ShowPortrait}" />
                                            <TextBlock Classes="PlaceholderText"
                                                       Text="{DynamicResource Settings.Edit.ShowPortrait.Desc}" />
                                        </StackPanel>
                                        <ToggleSwitch IsChecked="{Binding ShowPortraitEnabled, Mode=TwoWay}"
                                                      OffContent=""
                                                      OnContent="" />
                                    </StackPanel>
                                </Border>

                                <!-- 撤销步数上限 -->
                                <Border Classes="SettingCard">
                                    <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceS}">
                                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                            <TextBlock Text="{DynamicResource Settings.Edit.UndoLimit}"
                                                       Classes="SettingItemTitle" />
                                            <TextBlock Text="{Binding UndoLimit, StringFormat='{}{0} steps'}"
                                                       Classes="PlaceholderText" />
                                        </StackPanel>
                                        <Slider Minimum="10" Maximum="100"
                                                Value="{Binding UndoLimit, Mode=TwoWay}"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True" />
                                        <TextBlock Classes="PlaceholderText"
                                                   Text="{DynamicResource Settings.Edit.UndoLimit.Desc}"
                                                   FontSize="12" />
                                    </StackPanel>
                                </Border>

                                <!-- 自动保存 -->
                                <Border Classes="SettingCard">
                                    <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceS}">
                                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                            <TextBlock Text="{DynamicResource Settings.Edit.AutoSave}"
                                                       Classes="SettingItemTitle" />
                                            <StackPanel Orientation="Horizontal" Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                                <TextBlock Text="{Binding AutoSaveInterval}"
                                                           Classes="PlaceholderText" />
                                                <TextBlock Text="s"
                                                           Classes="PlaceholderText" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="{x:Static foundation:LayoutTokens.SpaceSM}">
                                            <TextBlock Text="{DynamicResource Settings.Edit.AutoSave.Enabled}"
                                                       Classes="PlaceholderText" />
                                            <ToggleSwitch IsChecked="{Binding AutoSaveEnabled}"
                                                          OffContent=""
                                                          OnContent="" />
                                        </StackPanel>
                                        <Slider Minimum="30" Maximum="600"
                                                Value="{Binding AutoSaveInterval, Mode=TwoWay}"
                                                TickFrequency="10"
                                                IsSnapToTickEnabled="True"
                                                IsEnabled="{Binding AutoSaveEnabled}" />
                                        <TextBlock Classes="PlaceholderText"
                                                   Text="{DynamicResource Settings.Edit.AutoSave.Desc}"
                                                   FontSize="12" />
                                    </StackPanel>
                                </Border>

                            </StackPanel>

                            <!-- ══════════════════════════════════════════
                                 渲染与性能
                                 ══════════════════════════════════════════ -->
                            <StackPanel
                                IsVisible="{Binding SelectedCategory,
                                Converter={StaticResource EnumEqual},
                                ConverterParameter=RenderAndPerformance}" Spacing="{x:Static foundation:LayoutTokens.SpaceSM}">
                                <TextBlock Classes="CategoryTitle" Text="{DynamicResource Settings.Render.CategoryTitle}" />

                                <!-- 全局性能监视器 -->
                                <Border Classes="SettingCard">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceM}">
                                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                            <TextBlock Classes="SettingItemTitle"
                                                       Text="{DynamicResource Settings.Render.PerformanceMonitor}" />
                                            <TextBlock Classes="PlaceholderText"
                                                       Text="{DynamicResource Settings.Render.PerformanceMonitor.Desc}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsChecked="{Binding PerformanceMonitorEnabled, Mode=TwoWay}"
                                                      OffContent=""
                                                      OnContent=""
                                                      VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- DiffSinger 推理参数 -->
                                <Border Classes="SettingCard">
                                    <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceM}">
                                        <TextBlock Classes="SettingItemTitle"
                                                   Text="{DynamicResource Settings.Render.DiffSingerParams}" />

                                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceS}">
                                            <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                                <TextBlock Text="{DynamicResource Settings.Render.AcousticSteps}"
                                                           Classes="SettingItemTitle" />
                                                <TextBlock Text="{Binding DiffSingerSteps, StringFormat='{}{0} steps'}"
                                                           Classes="PlaceholderText" />
                                            </StackPanel>
                                            <Slider Minimum="1" Maximum="100"
                                                    Value="{Binding DiffSingerSteps, Mode=TwoWay}"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True" />
                                            <TextBlock Classes="PlaceholderText"
                                                       Text="{DynamicResource Settings.Render.AcousticSteps.Desc}"
                                                       FontSize="12" />
                                        </StackPanel>

                                        <Border Height="1"
                                                Margin="-20,0,-20,0"
                                                Opacity="0.08"
                                                Background="{DynamicResource Sem.Color.OnSurfaceVariant}" />

                                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceS}">
                                            <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                                <TextBlock Text="{DynamicResource Settings.Render.VarianceSteps}"
                                                           Classes="SettingItemTitle" />
                                                <TextBlock Text="{Binding DiffSingerStepsVariance, StringFormat='{}{0} steps'}"
                                                           Classes="PlaceholderText" />
                                            </StackPanel>
                                            <Slider Minimum="1" Maximum="100"
                                                    Value="{Binding DiffSingerStepsVariance, Mode=TwoWay}"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True" />
                                            <TextBlock Classes="PlaceholderText"
                                                       Text="{DynamicResource Settings.Render.VarianceSteps.Desc}"
                                                       FontSize="12" />
                                        </StackPanel>

                                        <Border Height="1"
                                                Margin="-20,0,-20,0"
                                                Opacity="0.08"
                                                Background="{DynamicResource Sem.Color.OnSurfaceVariant}" />

                                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceS}">
                                            <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                                <TextBlock Text="{DynamicResource Settings.Render.PitchSteps}"
                                                           Classes="SettingItemTitle" />
                                                <TextBlock Text="{Binding DiffSingerStepsPitch, StringFormat='{}{0} steps'}"
                                                           Classes="PlaceholderText" />
                                            </StackPanel>
                                            <Slider Minimum="1" Maximum="100"
                                                    Value="{Binding DiffSingerStepsPitch, Mode=TwoWay}"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True" />
                                            <TextBlock Classes="PlaceholderText"
                                                       Text="{DynamicResource Settings.Render.PitchSteps.Desc}"
                                                       FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 机器学习运行器后端 -->
                                <Border Classes="SettingCard">
                                    <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceSM}">
                                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                            <TextBlock Classes="SettingItemTitle"
                                                       Text="{DynamicResource Settings.Render.OnnxRunner}" />
                                            <TextBlock Classes="PlaceholderText"
                                                       Text="{DynamicResource Settings.Render.OnnxRunner.Desc}" />
                                        </StackPanel>
                                        <ComboBox HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding AvailableOnnxRunners}"
                                                  SelectedItem="{Binding SelectedOnnxRunner, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:OnnxRunnerOption">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock FontSize="12"
                                                   Foreground="{DynamicResource Sem.Color.Error}"
                                                   IsVisible="{Binding SelectedOnnxRunner.Value,
                                                       Converter={StaticResource EnumEqual},
                                                       ConverterParameter=NNAPI}"
                                                   Text="{DynamicResource Settings.Render.OnnxRunner.NnapiWarning}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- 预渲染设置 -->
                                <Border Classes="SettingCard">
                                    <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceSM}">
                                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                            <TextBlock Classes="SettingItemTitle"
                                                       Text="{DynamicResource Settings.Render.PreRender}" />
                                            <TextBlock Classes="PlaceholderText"
                                                       Text="{DynamicResource Settings.Render.PreRender.Desc}" />
                                        </StackPanel>
                                        <ToggleSwitch IsChecked="{Binding PreRenderEnabled, Mode=TwoWay}"
                                                      OffContent=""
                                                      OnContent="" />

                                        <Border Height="1"
                                                Margin="-20,0,-20,0"
                                                Opacity="0.08"
                                                Background="{DynamicResource Sem.Color.OnSurfaceVariant}"
                                                IsVisible="{Binding PreRenderEnabled}" />

                                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceS}"
                                                    IsVisible="{Binding PreRenderEnabled}">
                                            <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                                <TextBlock Text="{DynamicResource Settings.Render.ThreadCount}"
                                                           Classes="SettingItemTitle" />
                                                <TextBlock Text="{Binding NumRenderThreads, StringFormat='{}{0} threads'}"
                                                           Classes="PlaceholderText" />
                                            </StackPanel>
                                            <Slider Minimum="1" Maximum="16"
                                                    Value="{Binding NumRenderThreads, Mode=TwoWay}"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True" />
                                            <TextBlock Classes="PlaceholderText"
                                                       Text="{DynamicResource Settings.Render.ThreadCount.Desc}"
                                                       FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 音频输出设置 -->
                                <Border Classes="SettingCard">
                                    <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceM}">
                                        <TextBlock Classes="SettingItemTitle"
                                                   Text="{DynamicResource Settings.Render.AudioOutput}" />

                                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceSM}">
                                            <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                                <TextBlock Text="{DynamicResource Settings.Render.AudioBackend}"
                                                           Classes="SettingItemTitle" />
                                                <TextBlock Classes="PlaceholderText"
                                                           Text="{DynamicResource Settings.Render.AudioBackend.Desc}"/>
                                            </StackPanel>
                                            <ComboBox HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding AvailableAudioBackends}"
                                                      SelectedItem="{Binding SelectedAudioBackend, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:AudioBackendOption">
                                                        <TextBlock Text="{Binding DisplayName}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <Border Height="1"
                                                Margin="-20,0,-20,0"
                                                Opacity="0.08"
                                                Background="{DynamicResource Sem.Color.OnSurfaceVariant}" />

                                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceS}">
                                            <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                                <TextBlock Text="{DynamicResource Settings.Render.OutputDevice}"
                                                           Classes="SettingItemTitle" />
                                                <TextBlock Classes="PlaceholderText"
                                                           Text="{DynamicResource Settings.Render.OutputDevice.Desc}"
                                                           FontSize="12" />
                                            </StackPanel>
                                            <Button Classes="filled"
                                                    Content="{DynamicResource Common.Refresh}"
                                                    Command="{Binding RefreshAudioDevicesCommand}"
                                                    IsEnabled="{Binding !IsRefreshingDevices}"
                                                    HorizontalAlignment="Left" />
                                            <ComboBox HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding AvailableAudioDevices}"
                                                      SelectedItem="{Binding SelectedAudioDevice, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:AudioDeviceOption">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <TextBlock Classes="PlaceholderText"
                                                   Text="{DynamicResource Settings.Render.AudioBackend.RestartRequired}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Sem.Color.Error}" />
                                    </StackPanel>
                                </Border>

                            </StackPanel>

                            <!-- ══════════════════════════════════════════
                                 文件与存储
                                 ══════════════════════════════════════════ -->
                            <StackPanel
                                IsVisible="{Binding SelectedCategory,
                                Converter={StaticResource EnumEqual},
                                ConverterParameter=FileAndStorage}" Spacing="{x:Static foundation:LayoutTokens.SpaceSM}">
                                <TextBlock Classes="CategoryTitle" Text="{DynamicResource Settings.File.CategoryTitle}" />

                                <!-- 额外歌手路径 -->
                                <Border Classes="SettingCard">
                                    <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceSM}">
                                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                            <TextBlock Classes="SettingItemTitle"
                                                       Text="{DynamicResource Settings.File.AdditionalSingerPath}" />
                                            <TextBlock Classes="PlaceholderText"
                                                       Text="{DynamicResource Settings.File.AdditionalSingerPath.Desc}" />
                                        </StackPanel>
                                        <ToggleSwitch IsChecked="{Binding AdditionalSingerPathEnabled, Mode=TwoWay}"
                                                      OffContent=""
                                                      OnContent="" />

                                        <Border Height="1"
                                                Margin="-20,0,-20,0"
                                                Opacity="0.08"
                                                Background="{DynamicResource Sem.Color.OnSurfaceVariant}"
                                                IsVisible="{Binding AdditionalSingerPathEnabled}" />

                                        <Grid ColumnDefinitions="*,Auto"
                                              IsVisible="{Binding AdditionalSingerPathEnabled}" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceSM}">
                                            <Border Grid.Column="0"
                                                    Background="{DynamicResource Sem.Color.SurfaceContainer}"
                                                    CornerRadius="{x:Static foundation:ShapeTokens.CornerM}"
                                                    VerticalAlignment="Center" Padding="12,8">
                                                <TextBlock Text="{Binding AdditionalSingerPath}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Opacity="0.65"
                                                           FontSize="13"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Button Grid.Column="1"
                                                    Classes="filled"
                                                    Content="{DynamicResource Settings.File.AdditionalSingerPath.Change}"
                                                    Command="{Binding ChangeAdditionalSingerPathCommand}"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 渲染缓存 -->
                                <Border Classes="SettingCard">
                                    <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceSM}">
                                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                            <TextBlock Classes="SettingItemTitle"
                                                       Text="{DynamicResource Settings.File.RenderCache}" />
                                            <TextBlock Classes="PlaceholderText"
                                                       Text="{DynamicResource Settings.File.RenderCache.Desc}" />
                                        </StackPanel>
                                        <Button Classes="filled"
                                                Content="{DynamicResource Settings.File.RenderCache.Clear}"
                                                Command="{Binding ClearRenderCacheCommand}"
                                                HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ══════════════════════════════════════════
                                 外观与语言
                                 ══════════════════════════════════════════ -->
                            <StackPanel
                                IsVisible="{Binding SelectedCategory,
                                Converter={StaticResource EnumEqual},
                                ConverterParameter=AppearanceAndLanguage}" Spacing="{x:Static foundation:LayoutTokens.SpaceSM}">
                                <TextBlock Classes="CategoryTitle"
                                           Text="{DynamicResource Settings.Appearance.CategoryTitle}" />

                                <!-- 主题选择 -->
                                <Border Classes="SettingCard">
                                    <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceSM}">
                                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                            <TextBlock Classes="SettingItemTitle"
                                                       Text="{DynamicResource Settings.Appearance.Theme}" />
                                            <TextBlock Classes="PlaceholderText"
                                                       Text="{DynamicResource Settings.Appearance.Theme.Desc}" />
                                        </StackPanel>
                                        <ComboBox HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding AvailableThemes}"
                                                  SelectedItem="{Binding SelectedThemeOption, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ThemeOption">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <!-- 主题色选择 -->
                                <Border Classes="SettingCard">
                                    <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceSM}">
                                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                            <TextBlock Classes="SettingItemTitle"
                                                       Text="{DynamicResource Settings.Appearance.ThemeColor}" />
                                            <TextBlock Classes="PlaceholderText"
                                                       Text="{DynamicResource Settings.Appearance.ThemeColor.Desc}" />
                                        </StackPanel>
                                        <ComboBox HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding AvailableThemeColorModes}"
                                                  SelectedItem="{Binding SelectedThemeColorMode, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ThemeColorModeOption">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <Border Height="1"
                                                Opacity="0.08"
                                                Background="{DynamicResource Sem.Color.OnSurfaceVariant}"
                                                IsVisible="{Binding IsCustomThemeColorMode}" />

                                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceSM}" IsVisible="{Binding IsCustomThemeColorMode}">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceS}">
                                                <Border Grid.Column="0"
                                                        Width="48"
                                                        Height="28"
                                                        CornerRadius="{x:Static foundation:ShapeTokens.CornerM}"
                                                        Background="{Binding ThemeSeedPreviewBrush}"
                                                        BorderBrush="{DynamicResource Sem.Color.Outline}"
                                                        BorderThickness="1" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding ThemeSeedHexInput, Mode=TwoWay}"
                                                         Watermark="#RRGGBB"
                                                         VerticalAlignment="Center" />
                                                <Button Grid.Column="2"
                                                        Content="{DynamicResource Settings.Appearance.ThemeColor.ApplyHex}"
                                                        Command="{Binding ApplyThemeSeedHexCommand}"
                                                        Classes="filled" />
                                                <Button Grid.Column="3"
                                                        Content="{DynamicResource Settings.Appearance.ThemeColor.OpenPicker}"
                                                        Command="{Binding OpenThemeColorPickerCommand}" Classes="tonal" />
                                            </Grid>

                                            <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceS}">
                                                <TextBlock Classes="SettingItemTitle"
                                                           Text="{DynamicResource Settings.Appearance.ThemeColor.Presets}" />
                                                <ItemsControl ItemsSource="{Binding PresetSeedColors}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" ItemWidth="42"
                                                                       ItemHeight="42"  ItemSpacing="{x:Static foundation:LayoutTokens.SpaceS}"  LineSpacing="{x:Static foundation:LayoutTokens.SpaceS}" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ThemeSeedPresetOption">
                                                            <Button Width="36"
                                                                    Height="36"

                                                                    BorderThickness="1"
                                                                    BorderBrush="{DynamicResource Sem.Color.OutlineVariant}"
                                                                    Background="{Binding Hex}"
                                                                    ToolTip.Tip="{Binding DisplayName}"
                                                                    Command="{Binding ApplyCommand}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                            <TextBlock Classes="PlaceholderText"
                                                       Text="{Binding ThemeColorHint}"
                                                       IsVisible="{Binding HasThemeColorHint}" />
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="{x:Static foundation:LayoutTokens.SpaceS}"
                                                        IsVisible="{Binding HasThemeColorSystemSource}">
                                                <TextBlock Classes="PlaceholderText"
                                                           Text="{DynamicResource Settings.Appearance.ThemeColor.Source}" />
                                                <TextBlock Classes="PlaceholderText"
                                                           Text="{Binding ThemeColorSystemSource}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 语言选择 -->
                                <Border Classes="SettingCard">
                                    <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceSM}">
                                        <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                            <TextBlock Classes="SettingItemTitle"
                                                       Text="{DynamicResource Settings.Appearance.Language}" />
                                            <TextBlock Classes="PlaceholderText"
                                                       Text="{DynamicResource Settings.Appearance.Language.Desc}" />
                                        </StackPanel>
                                        <ComboBox HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding AvailableLanguages}"
                                                  SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:LanguageOption">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                            </StackPanel>

                        </Panel>
                    </Border>
                </ScrollViewer>

            </Grid>
        </DockPanel>
    </Panel>
</UserControl>
