<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens"
        xmlns:foundation="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Foundation">
    <!-- Info card style -->
    <Style Selector="Border.InfoCard">
        <Setter Property="Background" Value="{DynamicResource Sem.Color.SurfaceContainerLow}" />
        <Setter Property="CornerRadius" Value="{x:Static foundation:ShapeTokens.CornerL}" />
        <Setter Property="Padding" Value="20,12" />
    </Style>

    <!-- Info row label -->
    <Style Selector="TextBlock.InfoLabel">
        <Setter Property="FontSize" Value="{x:Static theme:TypographyTokens.BodySSize}" />
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <!-- Info row value -->
    <Style Selector="TextBlock.InfoValue">
        <Setter Property="FontSize" Value="{x:Static theme:TypographyTokens.BodyMSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Action button -->
    <Style Selector="Button.ActionBtn">
        <Setter Property="Background" Value="{DynamicResource Sem.Color.SurfaceContainerLow}" />
        <Setter Property="CornerRadius" Value="{x:Static foundation:ShapeTokens.CornerM}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- 保留迁移前由全局同名按钮样式补充的属性。 -->
        <Setter Property="Foreground" Value="{DynamicResource Sem.Color.OnSurface}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{x:Static theme:TypographyTokens.BodyLSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.ActionBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Sem.Color.SurfaceContainerLow}" />
    </Style>

    <!-- Delete button -->
    <Style Selector="Button.DeleteBtn">
        <Setter Property="Background" Value="{DynamicResource Sem.Color.ErrorContainer}" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Color.Error}" />
        <Setter Property="CornerRadius" Value="{x:Static foundation:ShapeTokens.CornerM}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.DeleteBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Sem.Color.ErrorContainer}" />
    </Style>
</Styles>