<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localTokens="clr-namespace:OpenUtauMobile.Views.Tokens"
        xmlns:theme="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens"
        xmlns:foundation="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Foundation"
        xmlns:semantic="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Semantic">
    <Design.PreviewWith>
        <StackPanel Orientation="Vertical" Spacing="{x:Static foundation:LayoutTokens.SpaceS}">
            <Button Classes="HomeActionButton">
                <StackPanel Orientation="Horizontal"
                            Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                    <Path Data="M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z" />
                    <TextBlock Text="Home Action" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Design.PreviewWith>
    <!-- Recent item row button -->
    <Style Selector="Button.RecentItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- Delete button on each row -->
    <Style Selector="Button.HomeDeleteBtn">
        <Setter Property="Width" Value="{x:Static localTokens:HomeTokens.DeleteButtonSize}" />
        <Setter Property="Height" Value="{x:Static localTokens:HomeTokens.DeleteButtonSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{x:Static foundation:ShapeTokens.CornerFull}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Color.OnSurfaceVariant}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!--
         -->

    <!-- MD2 banner for recovery prompt -->
    <Style Selector="Border.RecoveryBanner">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="CornerRadius" Value="{x:Static foundation:ShapeTokens.CornerL}" />
        <Setter Property="Background" Value="{DynamicResource Sem.Color.SurfaceContainerHigh}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Sem.Color.OutlineVariant}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>



    <!-- 首页操作按钮仅在首页加载。 -->
    <Style Selector="Button.HomeActionButton">
        <Setter Property="Width" Value="{x:Static localTokens:HomeTokens.ActionSize}" />
        <Setter Property="Height" Value="{x:Static localTokens:HomeTokens.ActionSize}" />
        <Setter Property="CornerRadius" Value="{x:Static foundation:ShapeTokens.CornerXL}" />
        <Setter Property="Padding" Value="{x:Static foundation:LayoutTokens.InsetS}" />
        <Setter Property="Background" Value="{DynamicResource Sem.Color.SecondaryContainer}" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Color.OnSecondaryContainer}" />
        <Setter Property="FontSize" Value="{x:Static semantic:TypographyTokens.LabelMSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.HomeActionButton StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.HomeActionButton Path">
        <Setter Property="Stroke" Value="{DynamicResource Sem.Color.OnSecondaryContainer}" />
    </Style>

    <Style Selector="Button.HomeActionButton TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

</Styles>
