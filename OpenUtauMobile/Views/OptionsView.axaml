<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:foundation="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Foundation"
    xmlns:theme="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenUtauMobile.ViewModels"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             mc:Ignorable="d"
             x:Class="OpenUtauMobile.Views.OptionsView"
             x:DataType="vm:OptionsViewModel">
    <UserControl.Styles>
        <Style Selector="iconPacks|PackIconPhosphorIcons.CaretRight">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource Sem.Color.OnPrimaryContainer}" />
        </Style>
        <Style Selector="Border.Separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Opacity" Value="0.08" />
            <Setter Property="Margin" Value="52,0,12,0" />
            <Setter Property="Background" Value="{DynamicResource Sem.Color.OnSurfaceVariant}" />
        </Style>
    </UserControl.Styles>

    <Panel Background="{DynamicResource Sem.Color.Surface}">
        <DockPanel>
            <!-- Top App Bar -->
            <Border DockPanel.Dock="Top" Classes="TopBar">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceS}">
                    <!-- Back button -->
                    <Button Grid.Column="0"
                            Classes="TopBarBtn"
                            Command="{Binding BackCommand}"
                            ToolTip.Tip="{DynamicResource Common.Back}"
                            Content="{iconPacks:PhosphorIcons Kind=ArrowLeft}" />
                    <!-- Title -->
                    <TextBlock Grid.Column="1" Classes="TopBarTitle" Text="{DynamicResource Options.Title}" />
                </Grid>
            </Border>

            <!-- Entry list -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Border Padding="20,16,20,20">
                    <Border CornerRadius="{x:Static foundation:ShapeTokens.CornerXL}"
                            Background="{DynamicResource Sem.Color.SurfaceContainerLow}"
                            ClipToBounds="True">
                        <StackPanel>

                            <!-- 鈺愨晲鈺?1. 璁剧疆 鈺愨晲鈺?-->
                            <Button Classes="OptionEntry"
                                    Command="{Binding OpenSettingsCommand}">
                                <Border Padding="{x:Static theme:OptionEntryTokens.TrailingInset}">
                                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceS}" MinHeight="{x:Static theme:OptionEntryTokens.MinHeight}">
                                        <!-- Icon -->
                                        <Panel Grid.Column="0"
                                               Width="{x:Static theme:OptionEntryTokens.IconContainerSize}" Height="{x:Static theme:OptionEntryTokens.IconContainerSize}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                            <Border Width="{x:Static theme:OptionEntryTokens.IconContainerSize}" Height="{x:Static theme:OptionEntryTokens.IconContainerSize}"
                                                    CornerRadius="{x:Static foundation:ShapeTokens.CornerL}"
                                                    Background="{DynamicResource Sem.Color.PrimaryContainer}" />
                                            <iconPacks:PackIconPhosphorIcons Kind="GearSix" />
                                        </Panel>
                                        <!-- Title + Subtitle -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                            <TextBlock Text="{DynamicResource Options.Settings}" FontSize="{x:Static theme:TypographyTokens.BodyLSize}"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{DynamicResource Options.Settings.Desc}" FontSize="{x:Static theme:TypographyTokens.LabelSSize}"
                                                       Opacity="0.50" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <!-- Chevron -->
                                        <iconPacks:PackIconPhosphorIcons Kind="CaretRight"
                                                                         Classes="CaretRight"
                                                                         Grid.Column="2" />
                                    </Grid>
                                </Border>
                            </Button>

                            <!-- Separator -->
                            <Border Classes="Separator" />

                            <!-- 鈺愨晲鈺?2. 渚濊禆椤圭鐞?鈺愨晲鈺?-->
                            <Button Classes="OptionEntry"
                                    Command="{Binding OpenDependencyManagerCommand}">
                                <Border Padding="{x:Static theme:OptionEntryTokens.TrailingInset}">
                                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceS}" MinHeight="{x:Static theme:OptionEntryTokens.MinHeight}">
                                        <!-- Icon -->
                                        <Panel Grid.Column="0"
                                               Width="{x:Static theme:OptionEntryTokens.IconContainerSize}" Height="{x:Static theme:OptionEntryTokens.IconContainerSize}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                            <Border Width="{x:Static theme:OptionEntryTokens.IconContainerSize}" Height="{x:Static theme:OptionEntryTokens.IconContainerSize}"
                                                    CornerRadius="{x:Static foundation:ShapeTokens.CornerL}"
                                                    Background="{DynamicResource Sem.Color.PrimaryContainer}" />
                                            <iconPacks:PackIconPhosphorIcons Kind="PuzzlePiece" />
                                        </Panel>
                                        <!-- Title + Subtitle -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{x:Static foundation:LayoutTokens.SpaceXS}"
                                                    ClipToBounds="True">
                                            <TextBlock Text="{DynamicResource Options.DependencyManager}" FontSize="{x:Static theme:TypographyTokens.BodyLSize}"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{DynamicResource Options.DependencyManager.Desc}" FontSize="{x:Static theme:TypographyTokens.LabelSSize}"
                                                       Opacity="0.50" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <!-- Chevron -->
                                        <iconPacks:PackIconPhosphorIcons Kind="CaretRight"
                                                                         Classes="CaretRight"
                                                                         Grid.Column="2" />
                                    </Grid>
                                </Border>
                            </Button>

                            <!-- Separator -->
                            <Border Classes="Separator" />

                            <!-- 鈺愨晲鈺?3. 甯姪涓庢暀绋?鈺愨晲鈺?-->
                            <Button Classes="OptionEntry" Command="{Binding OpenHelpCommand}">
                                <Border Padding="{x:Static theme:OptionEntryTokens.TrailingInset}">
                                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceS}" MinHeight="{x:Static theme:OptionEntryTokens.MinHeight}">
                                        <Panel Grid.Column="0"
                                               Width="{x:Static theme:OptionEntryTokens.IconContainerSize}" Height="{x:Static theme:OptionEntryTokens.IconContainerSize}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                            <Border Width="{x:Static theme:OptionEntryTokens.IconContainerSize}" Height="{x:Static theme:OptionEntryTokens.IconContainerSize}"
                                                    CornerRadius="{x:Static foundation:ShapeTokens.CornerL}"
                                                    Background="{DynamicResource Sem.Color.PrimaryContainer}" />
                                            <iconPacks:PackIconPhosphorIcons Kind="Book" />
                                        </Panel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                            <TextBlock Text="{DynamicResource Options.Help}" FontSize="{x:Static theme:TypographyTokens.BodyLSize}"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{DynamicResource Options.Help.Desc}" FontSize="{x:Static theme:TypographyTokens.LabelSSize}" Opacity="0.50"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <iconPacks:PackIconPhosphorIcons Kind="CaretRight"
                                                                         Classes="CaretRight"
                                                                         Grid.Column="2" />
                                    </Grid>
                                </Border>
                            </Button>

                            <!-- Separator -->
                            <Border Classes="Separator" />

                            <!-- 鈺愨晲鈺?4. 瀵煎嚭鏃ュ織 鈺愨晲鈺?-->
                            <Button Classes="OptionEntry" Command="{Binding ExportLogCommand}">
                                <Border Padding="{x:Static theme:OptionEntryTokens.TrailingInset}">
                                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceS}" MinHeight="{x:Static theme:OptionEntryTokens.MinHeight}">
                                        <Panel Grid.Column="0"
                                               Width="{x:Static theme:OptionEntryTokens.IconContainerSize}" Height="{x:Static theme:OptionEntryTokens.IconContainerSize}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                            <Border Width="{x:Static theme:OptionEntryTokens.IconContainerSize}" Height="{x:Static theme:OptionEntryTokens.IconContainerSize}"
                                                    CornerRadius="{x:Static foundation:ShapeTokens.CornerL}"
                                                    Background="{DynamicResource Sem.Color.PrimaryContainer}" />
                                            <iconPacks:PackIconPhosphorIcons Kind="Bug" />
                                        </Panel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                            <TextBlock Text="{DynamicResource Options.ExportLog}" FontSize="{x:Static theme:TypographyTokens.BodyLSize}"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{DynamicResource Options.ExportLog.Desc}" FontSize="{x:Static theme:TypographyTokens.LabelSSize}"
                                                       Opacity="0.50" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <!-- Export icon instead of chevron -->
                                        <iconPacks:PackIconPhosphorIcons Kind="CaretRight"
                                                                         Classes="CaretRight"
                                                                         Grid.Column="2" />
                                    </Grid>
                                </Border>
                            </Button>

                            <!-- Separator -->
                            <Border Classes="Separator" />

                            <!-- 鈺愨晲鈺?5. 鍏充簬 鈺愨晲鈺?-->
                            <Button Classes="OptionEntry" Command="{Binding OpenAboutCommand}">
                                <Border Padding="{x:Static theme:OptionEntryTokens.TrailingInset}">
                                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceS}" MinHeight="{x:Static theme:OptionEntryTokens.MinHeight}">
                                        <Panel Grid.Column="0"
                                               Width="{x:Static theme:OptionEntryTokens.IconContainerSize}" Height="{x:Static theme:OptionEntryTokens.IconContainerSize}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                            <Border Width="{x:Static theme:OptionEntryTokens.IconContainerSize}" Height="{x:Static theme:OptionEntryTokens.IconContainerSize}"
                                                    CornerRadius="{x:Static foundation:ShapeTokens.CornerL}"
                                                    Background="{DynamicResource Sem.Color.PrimaryContainer}" />
                                            <iconPacks:PackIconPhosphorIcons Kind="Info" />
                                        </Panel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                            <TextBlock Text="{DynamicResource Options.About}" FontSize="{x:Static theme:TypographyTokens.BodyLSize}"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{DynamicResource Options.About.Desc}" FontSize="{x:Static theme:TypographyTokens.LabelSSize}" Opacity="0.50"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <iconPacks:PackIconPhosphorIcons Kind="CaretRight"
                                                                         Classes="CaretRight"
                                                                         Grid.Column="2" />
                                    </Grid>
                                </Border>
                            </Button>

                        </StackPanel>
                    </Border>
                </Border>
            </ScrollViewer>
        </DockPanel>
    </Panel>
</UserControl>