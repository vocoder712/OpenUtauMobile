<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OpenUtauMobile.ViewModels"
             xmlns:foundation="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Foundation"
             xmlns:semantic="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Semantic"
             xmlns:icons="https://github.com/MahApps/IconPacks.Avalonia"
             x:Class="OpenUtauMobile.Views.ResamplerManagerView"
             x:DataType="vm:ResamplerManagerViewModel">
    <UserControl.Styles>
        <!-- 状态文字沿用插件管理页的语义色：引擎已识别用主色，未识别用错误色。 -->
        <Style Selector="TextBlock.ResamplerStatus">
            <Setter Property="Foreground" Value="{DynamicResource Sem.Color.Error}" />
        </Style>
        <Style Selector="TextBlock.ResamplerStatus.available">
            <Setter Property="Foreground" Value="{DynamicResource Sem.Color.Primary}" />
        </Style>
        <Style Selector="TextBlock.Supporting">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource Sem.Color.OnSurfaceVariant}" />
        </Style>
    </UserControl.Styles>
    <Panel Background="{DynamicResource Sem.Color.Surface}">
        <DockPanel>
            <!-- 顶栏：返回、标题与刷新，沿用应用导航页的公共角色。 -->
            <Border DockPanel.Dock="Top" Classes="TopBar">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceS}">
                    <Button Classes="TopBarBtn" Command="{Binding BackCommand}"
                            Content="{icons:PhosphorIcons ArrowLeft}" ToolTip.Tip="{DynamicResource Common.Back}"
                            AutomationProperties.Name="{DynamicResource Common.Back}" />
                    <TextBlock Grid.Column="1" Classes="TopBarTitle" Text="{DynamicResource ResamplerManager.Title}" />
                    <Button Grid.Column="2" Classes="TopBarBtn" Command="{Binding RefreshCommand}"
                            Content="{icons:PhosphorIcons ArrowsClockwise}" ToolTip.Tip="{DynamicResource Common.Refresh}"
                            AutomationProperties.Name="{DynamicResource Common.Refresh}" />
                </Grid>
            </Border>
            <!-- 页面加载状态固定在顶栏下方，不随列表滚动。 -->
            <ProgressBar DockPanel.Dock="Top" Classes="TopBarLoading" IsVisible="{Binding IsBusy}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!-- 底部留白为右下角悬浮按钮腾出位置，避免遮挡最后一张卡片。 -->
                <Border Padding="20,16,20,108">
                    <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceM}">
                        <!-- 支持的文件类型与“识别不等于可运行”的说明。 -->
                        <TextBlock Classes="Supporting" Text="{Binding Hint}" />
                        <TextBlock IsVisible="{Binding IsEmpty}" Text="{DynamicResource ResamplerManager.Empty}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource Sem.Color.OnSurfaceVariant}" />
                        <TextBlock IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource Sem.Color.Error}" />
                        <!-- 已添加的重采样器列表。 -->
                        <ItemsControl ItemsSource="{Binding Resamplers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceM}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ResamplerCardViewModel">
                                    <!-- 卡片左侧为文件信息，右侧为移除按钮；卡片本身不可点击。 -->
                                    <Border Classes="card">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceM}">
                                            <icons:PackIconPhosphorIcons Kind="Waveform" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                                <TextBlock Text="{Binding FileName}" FontSize="{x:Static semantic:TypographyTokens.BodyLSize}"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}" />
                                                <TextBlock IsVisible="{Binding HasFolder}" Text="{Binding RelativePath}" TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding RelativePath}" Foreground="{DynamicResource Sem.Color.OnSurfaceVariant}" />
                                                <TextBlock Text="{Binding SizeText}" FontSize="{x:Static semantic:TypographyTokens.LabelSSize}"
                                                           Foreground="{DynamicResource Sem.Color.OnSurfaceVariant}" />
                                                <TextBlock Classes="ResamplerStatus" Classes.available="{Binding IsAvailable}"
                                                           Text="{Binding StatusText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="icon" VerticalAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:ResamplerManagerViewModel)DataContext).RemoveCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{DynamicResource Common.Delete}"
                                                    AutomationProperties.Name="{DynamicResource Common.Delete}">
                                                <icons:PackIconPhosphorIcons Kind="Trash" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </DockPanel>
        <!-- 右下角悬浮按钮：选择并添加重采样器。 -->
        <Button Classes="FAB" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,28"
                Command="{Binding AddCommand}" Content="{icons:PhosphorIcons Plus}"
                ToolTip.Tip="{DynamicResource ResamplerManager.Add}" AutomationProperties.Name="{DynamicResource ResamplerManager.Add}" />
    </Panel>
</UserControl>
