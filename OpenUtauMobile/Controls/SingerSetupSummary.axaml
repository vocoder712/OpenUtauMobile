<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:OpenUtauMobile.ViewModels"
    xmlns:foundation="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Foundation"
    xmlns:semantic="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Semantic"
    xmlns:components="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Components"
    xmlns:theme="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens"
    xmlns:tools="clr-namespace:OpenUtauMobile.Tools"
    xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
    x:Class="OpenUtauMobile.Controls.SingerSetupSummary"
    x:DataType="vm:ClassicSingerSetupViewModel">
    <UserControl.Resources>
        <tools:EncodingNameConverter x:Key="EncodingNameConverter"/>
    </UserControl.Resources>
    <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceM}">
        <Border
            BorderThickness="1"
            BorderBrush="{DynamicResource Sem.Color.OnSurfaceVariant}"
            CornerRadius="{x:Static foundation:ShapeTokens.CornerS}"
            Padding="{x:Static foundation:LayoutTokens.InsetSM}">
            <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceS}">
                <TextBlock
                    Text="{DynamicResource SingerSetup.Step4.FileInfo}"
                    FontWeight="SemiBold"
                    FontSize="{x:Static semantic:TypographyTokens.BodyMSize}"
                    Foreground="{DynamicResource Sem.Color.OnSurface}"/>
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="{DynamicResource SingerSetup.Step4.File}"
                        FontSize="12"
                        Foreground="{DynamicResource Sem.Color.OnSurfaceVariant}"/>
                    <SelectableTextBlock Text="{Binding ArchiveFilePath}" FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border
            BorderThickness="1"
            BorderBrush="{DynamicResource Sem.Color.OnSurfaceVariant}"
            CornerRadius="{x:Static foundation:ShapeTokens.CornerS}"
            Padding="{x:Static foundation:LayoutTokens.InsetSM}">
            <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceS}">
                <TextBlock
                    Text="{DynamicResource SingerSetup.Step4.EncodingInfo}"
                    FontWeight="SemiBold"
                    FontSize="{x:Static semantic:TypographyTokens.BodyMSize}"
                    Foreground="{DynamicResource Sem.Color.OnSurface}"/>
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="{DynamicResource SingerSetup.Step4.ArchiveEncoding}"
                        FontSize="12"
                        Foreground="{DynamicResource Sem.Color.OnSurfaceVariant}"/>
                    <SelectableTextBlock
                        Text="{Binding ArchiveEncoding, Converter={StaticResource EncodingNameConverter}, Mode=OneWay}"
                        FontSize="13"
                        TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="{DynamicResource SingerSetup.Step4.TextEncoding}"
                        FontSize="12"
                        Foreground="{DynamicResource Sem.Color.OnSurfaceVariant}"/>
                    <SelectableTextBlock
                        Text="{Binding TextEncoding, Converter={StaticResource EncodingNameConverter}, Mode=OneWay}"
                        FontSize="13"
                        TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border
            BorderThickness="1"
            BorderBrush="{DynamicResource Sem.Color.OnSurfaceVariant}"
            CornerRadius="{x:Static foundation:ShapeTokens.CornerS}"
            Padding="{x:Static foundation:LayoutTokens.InsetSM}">
            <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceS}">
                <TextBlock
                    Text="{DynamicResource SingerSetup.Step4.SingerType}"
                    FontWeight="SemiBold"
                    FontSize="{x:Static semantic:TypographyTokens.BodyMSize}"
                    Foreground="{DynamicResource Sem.Color.OnSurface}"/>
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="{DynamicResource SingerSetup.Step4.Type}"
                        FontSize="12"
                        Foreground="{DynamicResource Sem.Color.OnSurfaceVariant}"/>
                    <SelectableTextBlock Text="{Binding SingerType}" FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
