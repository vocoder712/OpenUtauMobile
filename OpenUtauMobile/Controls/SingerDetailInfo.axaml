<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:OpenUtauMobile.ViewModels"
    xmlns:foundation="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Foundation"
    xmlns:semantic="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Semantic"
    xmlns:components="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Components"
    xmlns:theme="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens"
    xmlns:tools="clr-namespace:OpenUtauMobile.Tools"
    xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
    x:Class="OpenUtauMobile.Controls.SingerDetailInfo"
    x:DataType="vm:SingerDetailViewModel">
    <UserControl.Resources>
        <StreamGeometry x:Key="IconFolder">M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z</StreamGeometry>
    </UserControl.Resources>
    <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceSM}">
        <Border Classes="InfoCard">
            <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceM}">
                <TextBlock
                    Text="{DynamicResource SingerDetail.Details}"
                    FontSize="{x:Static semantic:TypographyTokens.BodyMSize}"
                    FontWeight="SemiBold"
                    Margin="0,0,0,4"/>
                <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}" IsVisible="{Binding HasAuthor}">
                    <TextBlock Classes="InfoLabel" Text="{DynamicResource SingerDetail.Author}"/>
                    <SelectableTextBlock Classes="InfoValue" Text="{Binding Author}"/>
                </StackPanel>
                <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}" IsVisible="{Binding HasVoice}">
                    <TextBlock Classes="InfoLabel" Text="{DynamicResource SingerDetail.Voice}"/>
                    <SelectableTextBlock Classes="InfoValue" Text="{Binding Voice}"/>
                </StackPanel>
                <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}" IsVisible="{Binding HasWeb}">
                    <TextBlock Classes="InfoLabel" Text="{DynamicResource SingerDetail.Website}"/>
                    <SelectableTextBlock Classes="InfoValue" Text="{Binding Web}" Foreground="{DynamicResource Sem.Color.Primary}"/>
                </StackPanel>
                <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}" IsVisible="{Binding HasDefaultPhonemizer}">
                    <TextBlock Classes="InfoLabel" Text="{DynamicResource SingerDetail.DefaultPhonemizer}"/>
                    <SelectableTextBlock Classes="InfoValue" Text="{Binding DefaultPhonemizer}"/>
                </StackPanel>
                <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}" IsVisible="{Binding HasOtherInfo}">
                    <TextBlock Classes="InfoLabel" Text="{DynamicResource SingerDetail.OtherInfo}"/>
                    <SelectableTextBlock Classes="InfoValue" Text="{Binding OtherInfo}"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Classes="InfoCard" IsVisible="{Binding HasLocation}">
            <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceS}">
                <StackPanel Orientation="Horizontal" Spacing="{x:Static foundation:LayoutTokens.SpaceS}">
                    <Path
                        Width="{x:Static semantic:IconTokens.Small}"
                        Height="{x:Static semantic:IconTokens.Small}"
                        Stretch="Uniform"
                        Fill="{DynamicResource Sem.Color.OnSurfaceVariant}"
                        Data="{StaticResource IconFolder}"/>
                    <TextBlock
                        Text="{DynamicResource SingerDetail.Location}"
                        FontSize="{x:Static semantic:TypographyTokens.BodyMSize}"
                        FontWeight="SemiBold"/>
                </StackPanel>
                <SelectableTextBlock
                    Text="{Binding Location}"
                    FontSize="{x:Static semantic:TypographyTokens.BodySSize}"
                    Foreground="{DynamicResource Sem.Color.OnSurfaceVariant}"
                    TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
