<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:foundation="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Foundation"
             x:Class="OpenUtauMobile.Controls.CollapsibleContextMenu"
             HorizontalAlignment="Right"
             VerticalAlignment="Top">
    <UserControl.Styles>
        <StyleInclude Source="/Controls/Styles/CollapsibleContextMenu.axaml" />
    </UserControl.Styles>

    <!-- 上下文菜单，胶囊 -->
    <Border x:Name="Capsule"
            Background="{DynamicResource Sem.Color.SurfaceContainer}"
            CornerRadius="{x:Static foundation:ShapeTokens.CornerXXXXXL}"
            Padding="{x:Static foundation:LayoutTokens.InsetS}">
        <Grid RowDefinitions="*,Auto"
              HorizontalAlignment="Center">
            <Border x:Name="ContentHost"
                    Grid.Row="0"
                    Background="Transparent"
                    ClipToBounds="True">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="MaxHeight" Duration="{x:Static foundation:MotionTokens.DurationMedium}" Easing="CubicEaseOut" />
                    </Transitions>
                </Border.Transitions>
                <ScrollViewer x:Name="ActionsScrollViewer"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden">
                    <StackPanel Orientation="Vertical"
                                ClipToBounds="True"
                                Spacing="{x:Static foundation:LayoutTokens.SpaceXS}"
                                x:Name="ActionsList">
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <!-- 展开收起按钮 -->
            <Button Grid.Row="1"
                    x:Name="ToggleButton"
                    HorizontalAlignment="Center"
                    Classes="ContextActionBtn"
                    Background="{DynamicResource Sem.Color.SecondaryContainer}"
                    Click="OnToggleClick" />
        </Grid>
    </Border>
</UserControl>