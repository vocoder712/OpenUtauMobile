<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:localTokens="clr-namespace:OpenUtauMobile.Views.Tokens"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenUtauMobile.ViewModels"
             xmlns:local="clr-namespace:OpenUtauMobile"
             mc:Ignorable="d"
             x:Class="OpenUtauMobile.Controls.PianoRollSurface"
             xmlns:c="clr-namespace:OpenUtauMobile.Controls"
             xmlns:tools="clr-namespace:OpenUtauMobile.Tools"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:foundation="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Foundation"
             xmlns:semantic="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Semantic"
             x:DataType="vm:EditorViewModel"
             Background="{DynamicResource Sem.Color.SurfaceContainerLow}">

    <UserControl.Resources>
        <tools:SnapDivToLabelConverter x:Key="SnapDivToLabelConverter" />
        <tools:ProgressToWidthConverter x:Key="ProgressToWidthConverter" />
        <tools:PathToFileNameConverter x:Key="PathToFileName" />
        <tools:PathToDirectoryConverter x:Key="PathToDirectory" />
        <tools:DoubleToGridLengthConverter x:Key="DoubleToGridLengthConverter" />
    </UserControl.Resources>


            <Grid x:Name="PianoRollAreaGrid"
                  Background="{DynamicResource Sem.Color.SurfaceContainerLow}">

                <!-- 上下文为PianoRollViewModel，放大镜的Source -->
                <Grid Grid.Row="0" ClipToBounds="True"
                      x:Name="PART_PianoRollGrid"
                      x:DataType="vm:PianoRollViewModel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="{Binding Source={x:Static local:ViewConstants.PianoKeysWidth}, Converter={StaticResource DoubleToGridLengthConverter}}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition
                            Height="{Binding Source={x:Static local:ViewConstants.PianoRollTickRulerHeight}, Converter={StaticResource DoubleToGridLengthConverter}}" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="0" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- 横向琴键网格（Row 1, Col 1） -->
                    <c:PianoRollBackground
                        Grid.Row="1"
                        Grid.Column="1"
                        ClipToBounds="True"
                        IsVisible="{Binding IsVoiceMode}"
                        KeyHeight="{Binding KeyHeight}"
                        KeyOffset="{Binding KeyOffset}"
                        ProjectKey="{Binding ProjectKey}" />
                    <c:RenderWaveformCanvas Grid.Row="0" Grid.Column="1"
                                         IsVisible="{Binding IsVoiceMode}"
                                         Part="{Binding EditingVoicePart}"
                                         TickWidth="{Binding TickWidth}"
                                         TickOffset="{Binding TickOffset}"
                                         ShowWaveform="{Binding ShowRenderWaveform}"
                                         ReadyBrush="{DynamicResource Sem.Color.PrimaryContainer}"
                                         PendingBrush="{DynamicResource Sem.Color.Primary}" />
                    <!-- 纵向时间网格 覆盖右列全高（Row 0..1, Col 1） -->
                    <c:TickBackground Grid.Row="0"
                                      Grid.RowSpan="2"
                                      Grid.Column="1"
                                      TickWidth="{Binding TickWidth}"
                                      TickOffset="{Binding TickOffset}"
                                      SnapDiv="{Binding PianoRollSnapDiv}"
                                      RulerHeight="{x:Static local:ViewConstants.PianoRollTickRulerHeight}"
                                      MinTicklineWidth="{x:Static local:ViewConstants.PianoRollMinTicklineWidth}"
                                      ShowBarNumber="True"
                                      ShowTempoMarkers="False"
                                      ShowTimeSignatureMarkers="False" />
                    <ToggleButton Grid.Row="0" Grid.Column="0"
                                  IsVisible="{Binding IsVoiceMode}"
                                  IsChecked="{Binding ShowRenderWaveform, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Padding="2" Margin="2,0" CornerRadius="4"
                                  Background="Transparent"
                                  Foreground="{DynamicResource Sem.Color.OnSurfaceVariant}"
                                  ToolTip.Tip="{DynamicResource PianoRoll.RenderDisplay.Toggle}"
                                  AutomationProperties.Name="{DynamicResource PianoRoll.RenderDisplay.Toggle}">
                        <Grid>
                            <iconPacks:PackIconPhosphorIcons Kind="Waveform" Width="18" Height="18"
                                                              IsVisible="{Binding ShowRenderWaveform}" />
                            <iconPacks:PackIconPhosphorIcons Kind="Rectangle" Width="18" Height="18"
                                                              IsVisible="{Binding !ShowRenderWaveform}" />
                        </Grid>
                    </ToggleButton>
                    <!-- 立绘 （Row 1, Col 1） 靠右 -->
                    <Image Grid.Column="1"
                           Grid.Row="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Opacity="{Binding PortraitOpacity}"
                           Source="{Binding PortraitBitmap}" />
                    <!-- 透明占位继续阻挡标尺点击穿透到音符画布。 -->
                    <Border x:Name="PianoInputRuler" Grid.Row="0" Grid.Column="1"
                            Background="Transparent"
                            Height="{x:Static local:ViewConstants.PianoRollTickRulerHeight}" />
                    <!-- 音符画布（Row 1, Col 1） -->
                    <c:NotesCanvas x:Name="NotesInputCanvas" Grid.Row="1"
                                   Grid.Column="1"
                                   IsVisible="{Binding IsVoiceMode}"
                                   ClipToBounds="True"
                                   Part="{Binding EditingVoicePart}"
                                   TickWidth="{Binding TickWidth}"
                                   KeyHeight="{Binding KeyHeight}"
                                   TickOffset="{Binding TickOffset}"
                                   KeyOffset="{Binding KeyOffset}" />
                    <!-- 波形画布 -->
                    <c:WaveCanvas Grid.Row="1" Grid.Column="1"
                                  ClipToBounds="True"
                                  IsVisible="{Binding IsWaveMode}"
                                  WavePart="{Binding EditingWavePart}"
                                  TickWidth="{Binding TickWidth}"
                                  TickOffset="{Binding TickOffset}" />
                    <!-- 钢琴键画布（Row 1, Col 0） -->
                    <Border Grid.Row="1" Grid.Column="0" IsVisible="{Binding IsVoiceMode}">
                        <c:PianoKeysCanvas ClipToBounds="True"
                                           KeyHeight="{Binding KeyHeight}"
                                           KeyOffset="{Binding KeyOffset}"
                                           ProjectKey="{Binding ProjectKey}"
                                           LabelMode="{Binding PianoKeyLabelMode}" />
                        <!-- <Border.Effect> -->
                        <!--     <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="12" OffsetX="4" OffsetY="4" Opacity="0.5"/> -->
                        <!-- </Border.Effect> -->
                    </Border>
                    <!-- 钢琴卷帘固定居中播放标记 -->
                    <c:PianoRollPlayPosCanvas
                        Grid.Row="1" Grid.Column="1"
                        PlayMarkerScreenX="{Binding PlayMarkerScreenX}"
                        IsPlaying="{Binding IsPlaying}"
                        IsWaiting="{Binding IsWaitingRender}"
                        IsHitTestVisible="False" />
                    <!-- 编辑提示文本，位于中上方 -->
                    <TextBlock Grid.Column="1"
                               Grid.Row="1"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"
                               TextWrapping="Wrap"
                               IsHitTestVisible="False"
                               Text="{Binding EditingTip}" />
                    <!-- 上下文操作面板（右上角悬浮，ZIndex 置顶） -->
                    <Grid x:Name="FloatingActions" Grid.Row="1"
                          Grid.Column="1"
                          RowDefinitions="Auto,*"
                          RowSpacing="{x:Static foundation:LayoutTokens.SpaceS}"
                          HorizontalAlignment="Right"
                          Margin="{x:Static foundation:LayoutTokens.InsetM}"
                          ZIndex="100"
                          IsHitTestVisible="True">
                        <!-- 编辑模式切换 -->
                        <c:PianoRollEditModeSwitcher CurrentMode="{Binding EditMode, Mode=TwoWay}" />
                        <!-- 上下文菜单 -->
                        <c:CollapsibleContextMenu Grid.Row="1"
                                                  Actions="{Binding PianoRollContextActions}"
                                                  IsExpanded="{Binding IsContextMenuExpanded, Mode=TwoWay}" />
                    </Grid>
                    <!-- 编辑中的分片名 -->
                    <StackPanel Grid.Column="1"
                                Grid.Row="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="8"
                                IsHitTestVisible="False">
                        <TextBlock Text="{Binding EditingVoicePart.DisplayName}"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="{DynamicResource EditingPartNameBrush}"
                                   IsVisible="{Binding IsVoiceMode}"
                                   MaxWidth="80" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding EditingVoicePart.DisplayName}" />
                        <TextBlock Text="{Binding EditingWavePart.DisplayName}"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="{DynamicResource EditingPartNameBrush}"
                                   IsVisible="{Binding IsWaveMode}"
                                   MaxWidth="80" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding EditingWavePart.DisplayName}" />
                    </StackPanel>

                    <!-- 音素与参数面板层 -->
                    <Grid Grid.Row="1"
                          Grid.Column="0" Grid.ColumnSpan="2"
                          RowDefinitions="*, 0, Auto">
                        <!-- 钢琴卷帘与音素/参数面板分隔条（Row 2） -->
                        <Grid Grid.Row="1"
                              Height="24"
                              Margin="0,-12,0,-12"
                              ClipToBounds="True"
                              ZIndex="50"
                              IsVisible="{Binding IsVoiceMode}"
                              x:Name="PhonemeSplitHandle">
                            <!-- 背景横向细分割线 -->
                            <Border Height="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    Background="{DynamicResource Sem.Color.OutlineVariant}"
                                    IsHitTestVisible="False" />
                            <!-- 中间胶囊手柄（悬浮居中跨越分割线，与主分割条完全一致） -->
                            <Grid x:Name="PhonemeSplitHandlePill"
                                  Width="{x:Static local:ViewConstants.EditorSplitHandleWidth}"
                                  Height="{x:Static local:ViewConstants.EditorSplitHandleHeight}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Cursor="{x:Static local:ViewConstants.cursorSizeNS}"
                                  IsHitTestVisible="True"
                                  ToolTip.Tip="{DynamicResource PhonemePanel.Split.Tooltip}">
                                <Path Data="M 0,12
                                           C 0,12 3,12 6,6
                                           C 9,0 12,0 12,0
                                           H 36
                                           C 36,0 39,0 42,6
                                           C 45,12 48,12 48,12
                                           C 48,12 45,12 42,18
                                           C 39,24 36,24 36,24
                                           H 12
                                           C 12,24 9,24 6,18
                                           C 3,12 0,12 0,12
                                           Z"
                                      Fill="{DynamicResource Sem.Color.Surface}"
                                      Stroke="{DynamicResource Sem.Color.Outline}"
                                      StrokeThickness="1"
                                      Stretch="Fill" />
                                <StackPanel Orientation="Vertical"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="{x:Static foundation:LayoutTokens.SpaceXS}"
                                            IsHitTestVisible="False">
                                    <Rectangle Width="12" Height="2" RadiusX="1" RadiusY="1"
                                               Fill="{DynamicResource Sem.Color.OnSurfaceVariant}" Opacity="0.58" />
                                    <Rectangle Width="12" Height="2" RadiusX="1" RadiusY="1"
                                               Fill="{DynamicResource Sem.Color.OnSurfaceVariant}" Opacity="0.58" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- 音素与参数编辑面板（Row 3） -->
                        <c:PhonemeParamPanel x:Name="PhonemeParamPanel"
                                             Grid.Row="2"
                                             Height="{Binding PhonemePanelHeight}"
                                             IsVisible="{Binding IsPhonemePanelVisible}" />
                    </Grid>

                    <!-- 没有活动分片时的遮罩 -->
                    <Border Grid.Row="0" Grid.RowSpan="4" Grid.Column="0" Grid.ColumnSpan="2"
                            Background="{DynamicResource Sem.Color.SurfaceVariant}"
                            ZIndex="150"
                            IsHitTestVisible="True">
                        <!-- 同时考虑 EditingWavePart 也没有才显示遮罩 -->
                        <Border.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="EditingVoicePart" Converter="{x:Static ObjectConverters.IsNull}" />
                                <Binding Path="EditingWavePart" Converter="{x:Static ObjectConverters.IsNull}" />
                            </MultiBinding>
                        </Border.IsVisible>
                        <TextBlock Text="{DynamicResource Editor.NoEditingPart}"
                                   Foreground="{DynamicResource Sem.Color.OnSurfaceVariant}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Grid>
</UserControl>
