<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OpenUtauMobile.ViewModels"
             xmlns:c="clr-namespace:OpenUtauMobile.Controls"
             xmlns:foundation="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Foundation"
             x:Class="OpenUtauMobile.Controls.PluginSettingsPanel" x:DataType="vm:PluginSettingsViewModel">
    <!-- 插件字段实时保存；共用一个滚动区，不增加保存和取消操作栏。 -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Border Padding="24,16">
            <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceM}">
                <c:PluginFieldsPanel Fields="{Binding Fields}" IsEnabled="{Binding !IsBusy}" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
                <TextBlock Text="{Binding Message}" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" Foreground="{DynamicResource Sem.Color.Error}" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
