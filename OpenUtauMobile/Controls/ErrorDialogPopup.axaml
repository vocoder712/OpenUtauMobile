<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:foundation="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Foundation"
    xmlns:theme="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OpenUtauMobile.ViewModels"
    xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
    xmlns:dialogs="clr-namespace:OpenUtauMobile.Controls"
    xmlns:semantic="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Semantic"
    mc:Ignorable="d"
    x:Class="OpenUtauMobile.Controls.ErrorDialogPopup"
    d:DataContext="{d:DesignInstance Type=vm:ErrorDialogViewModel, IsDesignTimeCreatable=False}"
    x:DataType="vm:ErrorDialogViewModel"
    Classes="PopupDialogRoot">
    <UserControl.Styles>
        <StyleInclude Source="/Controls/Styles/ErrorDialogPopup.axaml" />
    </UserControl.Styles>

    <dialogs:DialogShell CloseCommand="{Binding CloseCommand}" Header="{Binding Title}">
        <dialogs:DialogShell.Footer>
            <dialogs:DialogActions>
                <Button Classes="DialogAction" Command="{Binding CopyCommand}">
                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="{x:Static foundation:LayoutTokens.SpaceS}">
                        <iconPacks:PackIconPhosphorIcons
                            Kind="Copy"
                            Width="{x:Static semantic:IconTokens.Compact}"
                            Height="{x:Static semantic:IconTokens.Compact}" />
                        <TextBlock Text="{DynamicResource Common.Copy}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button
                    Classes="DialogAction DialogPrimary"
                    Content="{DynamicResource Common.Confirm}"
                    Command="{Binding CloseCommand}" />
            </dialogs:DialogActions>
        </dialogs:DialogShell.Footer>
        <Border Classes="DialogBodyBorder">
            <Grid RowDefinitions="Auto,Auto,*">
                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                </ScrollViewer>
                <Button
                    Grid.Row="1"
                    Classes="text"
                    IsVisible="{Binding HasDetail}"
                    x:Name="DetailToggleBtn"
                    Click="OnDetailToggleClicked">
                    <StackPanel Orientation="Horizontal" Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                        <iconPacks:PackIconPhosphorIcons
                            Width="{x:Static semantic:IconTokens.Compact}"
                            Height="{x:Static semantic:IconTokens.Compact}"
                            x:Name="DetailChevron"
                            Kind="CaretDown"
                            VerticalAlignment="Center"
                            Foreground="{Binding Foreground, ElementName=DetailToggleBtn}" />
                        <TextBlock Text="{DynamicResource Common.Details}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBox
                    Grid.Row="2"
                    x:Name="DetailPanel"
                    Classes="ErrorDetail"
                    IsVisible="False"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    Text="{Binding Detail}"
                    MaxHeight="280"
                    Margin="0,6,0,0"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>
    </dialogs:DialogShell>
</UserControl>
