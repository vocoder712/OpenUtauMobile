<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:foundation="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Foundation"
    xmlns:theme="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OpenUtauMobile.ViewModels"
    xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
    xmlns:dialogs="clr-namespace:OpenUtauMobile.Controls"
    xmlns:semantic="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Semantic"
    mc:Ignorable="d"
    x:Class="OpenUtauMobile.Controls.ErrorDialogPopup"
    d:DataContext="{d:DesignInstance Type=vm:ErrorDialogViewModel, IsDesignTimeCreatable=False}"
    x:DataType="vm:ErrorDialogViewModel"
    Classes="PopupDialogRoot">
    <UserControl.Styles>
        <StyleInclude Source="/Controls/Styles/ErrorDialogPopup.axaml" />
    </UserControl.Styles>

    <dialogs:DialogShell CloseCommand="{Binding CloseCommand}">
        <dialogs:DialogShell.Header>
            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
        </dialogs:DialogShell.Header>
        <dialogs:DialogShell.Footer>
            <dialogs:DialogActionRows>
                <dialogs:DialogActionRow IsVisible="{Binding HasMissingPackage}">
                    <Button Classes="DialogAction DialogPrimary"
                        Content="{DynamicResource DependencyManager.Title}"
                        Command="{Binding OpenDependencyManagerCommand}" />
                </dialogs:DialogActionRow>
                <dialogs:DialogActionRow>
                    <Button Classes="DialogAction" Command="{Binding CopyCommand}">
                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="{x:Static foundation:LayoutTokens.SpaceS}">
                            <iconPacks:PackIconPhosphorIcons
                                Kind="Copy"
                                Width="{x:Static semantic:IconTokens.Compact}"
                                Height="{x:Static semantic:IconTokens.Compact}" />
                            <TextBlock Text="{DynamicResource Common.Copy}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button dialogs:DialogShell.IsDefaultAction="True"
                        Classes="DialogAction"
                        Classes.DialogPrimary="{Binding !HasMissingPackage}"
                        Content="{DynamicResource Common.Confirm}"
                        Command="{Binding CloseCommand}" />
                </dialogs:DialogActionRow>
            </dialogs:DialogActionRows>
        </dialogs:DialogShell.Footer>
        <!-- 摘要与完整报告共用一个滚动视口；标题和操作区由 DialogShell 固定。 -->
        <ScrollViewer x:Name="BodyScroll"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            AllowAutoHide="False">
            <Border Classes="DialogBodyBorder">
                <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceS}">
                    <SelectableTextBlock x:Name="MessagePanel" Text="{Binding Message}" TextWrapping="Wrap" />
                    <Button
                        Classes="text"
                        IsVisible="{Binding HasDetail}"
                        x:Name="DetailToggleBtn"
                        Click="OnDetailToggleClicked">
                        <StackPanel Orientation="Horizontal" Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                            <iconPacks:PackIconPhosphorIcons
                                Width="{x:Static semantic:IconTokens.Compact}"
                                Height="{x:Static semantic:IconTokens.Compact}"
                                x:Name="DetailChevron"
                                Kind="CaretDown"
                                VerticalAlignment="Center"
                                Foreground="{Binding Foreground, ElementName=DetailToggleBtn}" />
                            <TextBlock Text="{DynamicResource Common.Details}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- 完整报告可选择、自动换行，不使用带内部滚动条的输入框。 -->
                    <Border
                        x:Name="DetailPanel"
                        Classes="ErrorDetail"
                        IsVisible="False">
                        <SelectableTextBlock x:Name="DetailText"
                            Classes="ErrorReport"
                            Text="{Binding ReportText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </dialogs:DialogShell>
</UserControl>
