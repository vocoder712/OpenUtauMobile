<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:localTokens="clr-namespace:OpenUtauMobile.Controls.Tokens"
             xmlns:theme="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens"
             xmlns:foundation="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Foundation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenUtauMobile.Controls.ToastOverlay"
             IsHitTestVisible="False">

    <Panel>
        <Border x:Name="ToastBorder"
                IsVisible="False"
                Opacity="0"
                Background="{DynamicResource Sem.Color.InverseSurface}"
                CornerRadius="{x:Static foundation:ShapeTokens.CornerFull}"
                MinWidth="48"
                MaxWidth="320"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="16,0,16,88" Padding="16,12">
            <!-- 阴影效果 -->
            <Border.Effect>
                <DropShadowEffect BlurRadius="{x:Static localTokens:ToastTokens.ShadowBlur}" OffsetX="0"
                                  OffsetY="{x:Static localTokens:ToastTokens.ShadowOffset}"
                                  Opacity="{x:Static localTokens:ToastTokens.ShadowOpacity}"
                                  Color="{DynamicResource Sem.Value.Shadow}" />
            </Border.Effect>
            <!-- Toast 消息文本 -->
            <TextBlock x:Name="ToastText"
                       Foreground="{DynamicResource Sem.Color.InverseOnSurface}"
                       FontSize="{x:Static theme:TypographyTokens.BodyMSize}"
                       FontWeight="Medium"
                       MaxLines="2"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center" />
        </Border>
    </Panel>

</UserControl>