<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:foundation="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Foundation"
             xmlns:semantic="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Semantic"
             xmlns:icons="https://github.com/MahApps/IconPacks.Avalonia"
             x:Class="OpenUtauMobile.Controls.ToastOverlay">
    <!-- 根面板无背景，只有可点击变体的局部按钮命中输入。 -->
    <Panel>
        <Border x:Name="ToastBorder" IsVisible="False" IsHitTestVisible="False" Opacity="0"
                Background="{DynamicResource Sem.Color.InverseSurface}"
                CornerRadius="{x:Static foundation:ShapeTokens.CornerS}"
                MinWidth="48" MinHeight="48" MaxWidth="560"
                VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,88">
            <Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="16,0" IsHitTestVisible="False">
                    <TextBlock x:Name="ToastText" Foreground="{DynamicResource Sem.Color.InverseOnSurface}"
                               FontSize="{x:Static semantic:TypographyTokens.BodyMSize}" LineHeight="20"
                               Margin="0,14" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <icons:PackIconPhosphorIcons x:Name="ToastActionIcon" Grid.Column="1" IsVisible="False"
                                               Kind="CaretRightFill" Width="{x:Static semantic:IconTokens.Standard}"
                                               Height="{x:Static semantic:IconTokens.Standard}"
                                               VerticalAlignment="Center" Foreground="{DynamicResource Sem.Color.InverseOnSurface}" />
                </Grid>
                <!-- 整条消息是同一按钮；正文和图标均复用基础按钮的按下、聚焦与悬停反馈。 -->
                <Button x:Name="ToastActionButton" IsVisible="False" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource Sem.Color.InverseOnSurface}" Padding="0"
                        CornerRadius="{x:Static foundation:ShapeTokens.CornerS}"
                        MinHeight="{x:Static semantic:InteractionTokens.TouchTarget}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        AutomationProperties.HelpText="{DynamicResource Common.Details}"
                        Click="OnToastClicked" />
            </Grid>
        </Border>
    </Panel>
</UserControl>
