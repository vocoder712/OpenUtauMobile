<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:foundation="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Foundation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OpenUtauMobile.ViewModels"
             x:Class="OpenUtauMobile.Controls.PerformanceMonitorOverlay"
             x:DataType="vm:PerformanceMonitorViewModel"
             IsHitTestVisible="False"
             IsVisible="{Binding IsEnabled}"
             HorizontalAlignment="Right"
             VerticalAlignment="Top">
    <Panel Margin="12">
        <Border CornerRadius="{x:Static foundation:ShapeTokens.CornerM}"
                Opacity="0.5"
                Background="{DynamicResource Sem.Color.InverseSurface}" />
        <Border Padding="12,8">
            <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                <TextBlock Text="{Binding AppMemoryText}"
                           FontSize="11"
                           Foreground="{DynamicResource Sem.Color.InverseOnSurface}" />
                <TextBlock Text="{Binding ManagedHeapText}"
                           FontSize="11"
                           Foreground="{DynamicResource Sem.Color.InverseOnSurface}" />
                <TextBlock Text="{Binding SystemMemoryText}"
                           FontSize="11"
                           Foreground="{DynamicResource Sem.Color.InverseOnSurface}" />
                <TextBlock Text="{Binding CpuText}"
                           FontSize="11"
                           Foreground="{DynamicResource Sem.Color.InverseOnSurface}" />
                <TextBlock Text="{Binding FrameRateText}"
                           FontSize="11"
                           Foreground="{DynamicResource Sem.Color.InverseOnSurface}" />
                <TextBlock Text="{Binding AudioLatencyText}"
                           FontSize="11"
                           Foreground="{DynamicResource Sem.Color.InverseOnSurface}" />
            </StackPanel>
        </Border>
    </Panel>
</UserControl>

