<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:foundation="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Foundation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OpenUtauMobile.ViewModels"
    xmlns:dialogs="clr-namespace:OpenUtauMobile.Controls"
    mc:Ignorable="d"
    x:Class="OpenUtauMobile.Controls.LyricEditPopup"
    d:DataContext="{d:DesignInstance Type=vm:LyricEditViewModel, IsDesignTimeCreatable=False}"
    x:DataType="vm:LyricEditViewModel"
    Classes="PopupDialogRoot DialogHeightCompact">
    <dialogs:DialogShell CloseCommand="{Binding CancelCommand}" Header="{DynamicResource LyricEdit.Title}">
        <dialogs:DialogShell.Footer>
            <dialogs:DialogActions>
                <Button
                    Command="{Binding CancelCommand}"
                    Classes="DialogAction"
                    Content="{DynamicResource Common.Cancel}" />
                <Button
                    Command="{Binding NextCommand}"
                    Classes="DialogAction"
                    Content="{DynamicResource Common.Next}"
                    ToolTip.Tip="{Binding NextButtonTooltip}" />
                <Button
                    Command="{Binding ConfirmCommand}"
                    Classes="DialogAction DialogPrimary"
                    Content="{DynamicResource Common.Confirm}" />
            </dialogs:DialogActions>
        </dialogs:DialogShell.Footer>
        <DockPanel>
            <!-- 标题栏 -->
            <!-- 内容区域 -->
            <Border DockPanel.Dock="Top" Classes="DialogBodyBorder">
                <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceSM}">
                    <!-- 当前音符信息 -->
                    <TextBlock
                        Text="{Binding CurrentNoteInfo}"
                        FontSize="13"
                        Foreground="{DynamicResource Sem.Color.OnSurfaceVariant}" />
                    <!-- 歌词输入框 -->
                    <TextBox
                        x:Name="LyricInput"
                        Text="{Binding CurrentLyric}"
                        Watermark="{DynamicResource LyricEdit.Watermark}"
                        CornerRadius="{x:Static foundation:ShapeTokens.CornerM}"
                        FontSize="14"
                        BorderThickness="1"  Padding="12,8" />
                    <!-- 按钮栏 -->
                </StackPanel>
            </Border>
        </DockPanel>
    </dialogs:DialogShell>
</UserControl>
