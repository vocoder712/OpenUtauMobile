<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:theme="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:OpenUtauMobile.ViewModels"
    xmlns:dialogs="clr-namespace:OpenUtauMobile.Controls"
    x:Class="OpenUtauMobile.Controls.MultiFilePickerPopup"
    x:DataType="vm:MultiFilePickerViewModel"
    Classes="PopupDialogRoot">
    <dialogs:DialogShell CloseCommand="{Binding CloseCommand}" Header="{Binding Title}">
        <dialogs:DialogShell.Footer>
            <StackPanel>
                <TextBlock Text="{Binding SelectionSummary}" />
                <dialogs:DialogActions>
                    <Button
                        Content="{DynamicResource Common.Cancel}"
                        Command="{Binding CloseCommand}"
                        Classes="DialogAction" />
                    <Button
                        Content="{DynamicResource ImportTracks.Next}"
                        Command="{Binding ConfirmCommand}"
                        Classes="DialogAction DialogPrimary" />
                </dialogs:DialogActions>
            </StackPanel>
        </dialogs:DialogShell.Footer>
        <DockPanel>
            <Border Classes="DialogBodyBorder" DockPanel.Dock="Top">
                <StackPanel>
                    <Button Content="{DynamicResource FilePicker.GoUp}" Command="{Binding GoUpCommand}" />
                    <TextBox Text="{Binding CurrentPath}" />
                    <ProgressBar IsVisible="{Binding IsLoading}" IsIndeterminate="True" />
                    <TextBlock
                        IsVisible="{Binding ShowEmptyState}"
                        Text="{Binding EmptyStateMessage}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Classes="DialogBodyBorder"><ListBox
                ItemsSource="{Binding Entries}"
                MaxHeight="280"
                IsEnabled="{Binding !IsLoading}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:MultiFilePickerEntry">
                        <Panel>
                            <Button
                                IsVisible="{Binding IsDirectory}"
                                Content="{Binding Name}"
                                Command="{Binding OpenCommand}"
                                HorizontalAlignment="Stretch"
                                MinHeight="{x:Static theme:InteractionTokens.TouchTarget}" />
                            <CheckBox
                                IsVisible="{Binding IsFile}"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                HorizontalAlignment="Stretch"
                                MinHeight="{x:Static theme:InteractionTokens.TouchTarget}">
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                            </CheckBox>
                        </Panel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox></Border>
        </DockPanel>
    </dialogs:DialogShell>
</UserControl>
