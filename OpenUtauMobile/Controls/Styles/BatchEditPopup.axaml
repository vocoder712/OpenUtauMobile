<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localTokens="clr-namespace:OpenUtauMobile.Controls.Tokens"
        xmlns:theme="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens"
        xmlns:foundation="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Foundation"
        xmlns:semantic="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Semantic">
    <Style Selector="UserControl.BatchEditRoot">
        <Setter Property="MinWidth" Value="{x:Static localTokens:BatchEditTokens.PopupMinWidth}" />
    </Style>

    <Style Selector="Border.BatchEditScope">
        <Setter Property="Margin" Value="12,12,12,4" />
        <Setter Property="Padding" Value="12,12" />
        <Setter Property="Background" Value="{DynamicResource Sem.Color.SecondaryContainer}" />
        <Setter Property="CornerRadius" Value="{x:Static foundation:ShapeTokens.CornerM}" />
    </Style>

    <Style Selector="Border.BatchEditItem">
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Padding" Value="{x:Static foundation:LayoutTokens.InsetSM}" />
        <Setter Property="Background" Value="{DynamicResource Sem.Color.SurfaceContainerLow}" />
        <Setter Property="CornerRadius" Value="{x:Static foundation:ShapeTokens.CornerM}" />
    </Style>

    <Style Selector="Border.BatchEditItemIcon">
        <Setter Property="Width" Value="{x:Static localTokens:BatchEditTokens.ItemIconSize}" />
        <Setter Property="Height" Value="{x:Static localTokens:BatchEditTokens.ItemIconSize}" />
        <Setter Property="Background" Value="{DynamicResource Sem.Color.PrimaryContainer}" />
        <Setter Property="CornerRadius" Value="{x:Static foundation:ShapeTokens.CornerFull}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style Selector="TextBlock.BatchEditItemTitle">
        <Setter Property="FontSize" Value="{x:Static semantic:TypographyTokens.BodyLSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Color.OnSurface}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.BatchEditParameterLabel">
        <Setter Property="FontSize" Value="{x:Static semantic:TypographyTokens.BodySSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Color.OnSurfaceVariant}" />
    </Style>

    <Style Selector="Border.BatchEditPinnedGroup">
        <Setter Property="Margin" Value="0,4,0,8" />
        <Setter Property="Padding" Value="{x:Static foundation:LayoutTokens.InsetXS}" />
        <Setter Property="Background" Value="{DynamicResource Sem.Color.SurfaceContainer}" />
        <Setter Property="CornerRadius" Value="{x:Static foundation:ShapeTokens.CornerM}" />
    </Style>

    <Style Selector="TextBlock.BatchEditPinnedHeader">
        <Setter Property="Margin" Value="8,4,8,0" />
        <Setter Property="FontSize" Value="{x:Static semantic:TypographyTokens.LabelLSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Color.Primary}" />
    </Style>

    <Style Selector="Button.BatchEditPinIconButton">
        <Setter Property="Width" Value="{x:Static localTokens:BatchEditTokens.PinIconButtonSize}" />
        <Setter Property="Height" Value="{x:Static localTokens:BatchEditTokens.PinIconButtonSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Color.OnSurfaceVariant}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{x:Static localTokens:BatchEditTokens.PinButtonCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.BatchEditPinIconVisual">
        <Setter Property="Width" Value="{x:Static localTokens:BatchEditTokens.PinIconVisualSize}" />
        <Setter Property="Height" Value="{x:Static localTokens:BatchEditTokens.PinIconVisualSize}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{x:Static localTokens:BatchEditTokens.PinButtonCornerRadius}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.BatchEditPinIconButton.pinned">
        <Setter Property="Foreground" Value="{DynamicResource Sem.Color.OnPrimaryContainer}" />
    </Style>

    <Style Selector="Button.BatchEditRunIconButton">
        <Setter Property="Width" Value="{x:Static localTokens:BatchEditTokens.ActionIconButtonSize}" />
        <Setter Property="Height" Value="{x:Static localTokens:BatchEditTokens.ActionIconButtonSize}" />
        <Setter Property="Padding" Value="{x:Static foundation:LayoutTokens.InsetM}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Color.OnSecondaryContainer}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{x:Static foundation:ShapeTokens.CornerFull}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 执行 -->
    <Style Selector="Border.BatchEditRunIconVisual">
        <Setter Property="Width" Value="{x:Static localTokens:BatchEditTokens.ActionIconVisualSize}" />
        <Setter Property="Height" Value="{x:Static localTokens:BatchEditTokens.ActionIconVisualSize}" />
        <Setter Property="Background" Value="{DynamicResource Sem.Color.SecondaryContainer}" />
        <Setter Property="CornerRadius" Value="{x:Static foundation:ShapeTokens.CornerFull}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="{x:Static foundation:LayoutTokens.InsetS}" />
    </Style>

    <Style Selector="TextBlock.BatchEditValidation">
        <Setter Property="FontSize" Value="{x:Static semantic:TypographyTokens.BodySSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Color.Error}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</Styles>
