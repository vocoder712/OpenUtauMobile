<Styles xmlns="https://github.com/avaloniaui"
        xmlns:foundation="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Foundation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 宸ュ叿鏍忓浘鏍囨寜閽?-->
    <Style Selector="Button.IconBtn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{x:Static foundation:LayoutTokens.InsetS}" />
        <Setter Property="CornerRadius" Value="{x:Static foundation:ShapeTokens.CornerM}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 鏂囦欢鍒楄〃鏉＄洰鎸夐挳 -->
    <Style Selector="Button.FileEntry">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="{x:Static foundation:ShapeTokens.CornerM}" />
    </Style>

</Styles>
