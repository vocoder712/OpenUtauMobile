<Styles xmlns="https://github.com/avaloniaui"
    xmlns:components="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Components"
    xmlns:semantic="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Semantic"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Button.KeyBtn">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="MinWidth" Value="{x:Static semantic:InteractionTokens.TouchTarget}"/>
        <Setter Property="MinHeight" Value="{x:Static semantic:InteractionTokens.TouchTarget}"/>
        <Setter Property="Padding" Value="{x:Static components:ButtonTokens.TextActionPadding}"/>
    </Style>
</Styles>
