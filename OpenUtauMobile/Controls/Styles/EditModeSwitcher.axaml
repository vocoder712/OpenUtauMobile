<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localTokens="clr-namespace:OpenUtauMobile.Controls.Tokens">
    <Style Selector="Button.EditModeBtn">
        <Setter Property="Background" Value="{DynamicResource Sem.Color.SecondaryContainer}" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Color.OnSecondaryContainer}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Width" Value="{x:Static localTokens:EditModeSwitcherTokens.ButtonSize}" />
        <Setter Property="Height" Value="{x:Static localTokens:EditModeSwitcherTokens.ButtonSize}" />
    </Style>
</Styles>