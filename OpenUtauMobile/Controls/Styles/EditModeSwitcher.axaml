<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localTokens="clr-namespace:OpenUtauMobile.Controls.Tokens"
        xmlns:icons="https://github.com/MahApps/IconPacks.Avalonia"
        xmlns:c="using:OpenUtauMobile.Controls"
        xmlns:semantic="using:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Semantic">
    <!-- 独立参数入口保留原有外观；浮动入口的外观由宿主工具栏提供。 -->
    <Style Selector="c|EditorModePicker:not(.FloatingMode) icons|PackIconPhosphorIcons.EditModeIcon">
        <Setter Property="Width" Value="{x:Static semantic:IconTokens.Small}" />
        <Setter Property="Height" Value="{x:Static semantic:IconTokens.Small}" />
    </Style>
    <Style Selector="c|EditorModePicker:not(.FloatingMode) Button.EditModeBtn">
        <Setter Property="Background" Value="{DynamicResource Sem.Color.SecondaryContainer}" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Color.OnSecondaryContainer}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Width" Value="{x:Static localTokens:EditModeSwitcherTokens.ButtonSize}" />
        <Setter Property="Height" Value="{x:Static localTokens:EditModeSwitcherTokens.ButtonSize}" />
    </Style>
    <Style Selector="Button.EditModeOption">
        <Setter Property="Width" Value="80" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Color.OnSurface}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.EditModeOption.Selected">
        <Setter Property="Background" Value="{DynamicResource Sem.Color.PrimaryContainer}" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Color.OnPrimaryContainer}" />
    </Style>
</Styles>
