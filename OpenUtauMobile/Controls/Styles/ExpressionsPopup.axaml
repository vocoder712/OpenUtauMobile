<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:semantic="using:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Semantic">
    <Styles.Resources>
        <!-- 分段外形属于表情作用域选择，交互状态复用基础按钮主题。 -->
        <ControlTheme x:Key="ExpressionScopeSegment" TargetType="RadioButton"
                      BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="MinHeight" Value="{x:Static semantic:InteractionTokens.TouchTarget}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Sem.Color.OnSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Sem.Color.Outline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="{x:Static semantic:TypographyTokens.LabelLSize}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Style Selector="^:checked">
                <Setter Property="Background" Value="{DynamicResource Sem.Color.SecondaryContainer}" />
                <Setter Property="Foreground" Value="{DynamicResource Sem.Color.OnSecondaryContainer}" />
            </Style>
        </ControlTheme>
    </Styles.Resources>
</Styles>
