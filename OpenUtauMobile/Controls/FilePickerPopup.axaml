<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OpenUtauMobile.ViewModels"
    xmlns:conv="clr-namespace:OpenUtauMobile.Tools"
    xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
    xmlns:dialogs="clr-namespace:OpenUtauMobile.Controls"
    xmlns:foundation="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Foundation"
    xmlns:semantic="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Semantic"
    mc:Ignorable="d"
    x:Class="OpenUtauMobile.Controls.FilePickerPopup"
    Name="Root"
    d:DataContext="vm:FilePickerBaseViewModel"
    x:DataType="vm:FilePickerBaseViewModel"
    Classes="PopupDialogRoot">
    <UserControl.Styles>
        <StyleInclude Source="/Controls/Styles/FilePickerPopup.axaml" />
    </UserControl.Styles>

    <UserControl.Resources>
        <conv:IsFileConverter x:Key="IsFile" />
        <conv:FileSizeConverter x:Key="FileSize" />
        <conv:EnumEqualConverter x:Key="ModeEq" />
    </UserControl.Resources>
    <dialogs:DialogShell
        CloseCommand="{Binding CloseCommand}"
        Header="{Binding Title}">
        <dialogs:DialogShell.Footer>
            <StackPanel IsVisible="{Binding HasFooter}">
                <StackPanel IsVisible="{Binding IsMultiSelect}"
                            Spacing="{x:Static foundation:LayoutTokens.SpaceS}">
                    <TextBlock Text="{Binding SelectionSummary}" />
                    <dialogs:DialogActionRow>
                        <Button Content="{DynamicResource Common.Cancel}"
                                Command="{Binding CloseCommand}" />
                        <Button Content="{DynamicResource ImportTracks.Next}"
                                Command="{Binding ConfirmCommand}"
                                Classes="DialogPrimary" />
                    </dialogs:DialogActionRow>
                </StackPanel>
                <Border IsVisible="{Binding Mode, Converter={StaticResource ModeEq}, ConverterParameter=OpenFolder}">
                    <Button
                        Content="{DynamicResource FilePicker.SelectFolder}"
                        Command="{Binding SelectCurrentFolderCommand}"
                        Classes="DialogAction DialogPrimary" />
                </Border>
                <Border IsVisible="{Binding Mode, Converter={StaticResource ModeEq}, ConverterParameter=SaveFile}">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceS}"
                          RowSpacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                        <!-- 标签 -->
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{DynamicResource FilePicker.FileName}"
                            FontSize="11"
                            Opacity="0.5" />
                        <!-- 文件名输入框 + 固定后缀 -->
                        <Grid
                            Grid.Row="1"
                            Grid.Column="0"
                            ColumnDefinitions="*,Auto" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                            <TextBox
                                Grid.Column="0"
                                Text="{Binding FileName}"
                                PlaceholderText="{DynamicResource FilePicker.FileNameHint}"
                                FontSize="13" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding Extension}"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Opacity="0.6" />
                        </Grid>
                        <!-- 保存按钮（跨两行，右侧对齐） -->
                        <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Content="{DynamicResource FilePicker.Save}"
                            Command="{Binding SaveCommand}"
                            VerticalAlignment="Bottom"
                            Classes="DialogAction DialogPrimary" />
                        <!-- 警告消息 -->
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Text="{Binding WarningMessage}"
                            IsVisible="{Binding IsShowingWarningMessage}"
                            FontSize="12"
                            Foreground="{DynamicResource Sem.Color.Warning}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </StackPanel>
        </dialogs:DialogShell.Footer>
        <DockPanel>
            <!-- ── Header ── -->
            <Border Classes="DialogBodyBorder" DockPanel.Dock="Top">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            Classes="DialogNavigation"
                            Command="{Binding GoUpCommand}"
                            ToolTip.Tip="{DynamicResource FilePicker.GoUp}"
                            Content="{iconPacks:PhosphorIcons ArrowUp}">
                    </Button>
                    <TextBox Text="{Binding CurrentPath}"
                             FontSize="13"
                             Height="40" MinHeight="40"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             TextWrapping="NoWrap"
                             AcceptsReturn="False"
                             Background="{DynamicResource Sem.Color.SurfaceContainerLow}"
                             Grid.Column="1" Padding="12,0" />
                </Grid>
            </Border>
            <!-- OpenFolder 模式：选择此文件夹 -->
            <!-- SaveFile 模式：文件名输入 + 保存按钮 -->
            <!-- ── Content ── -->
            <Panel ClipToBounds="True">
                <!-- 繁忙指示器：居中 Spinner，IsLoading=true 时覆盖整个内容区 -->
                <ProgressBar
                    IsVisible="{Binding IsLoading}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsIndeterminate="True"
                    Width="40"
                    Height="8" />
                <!-- 空状态面板（仅在非加载、无内容时显示） -->
                <StackPanel
                    IsVisible="{Binding ShowEmptyState}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="{x:Static foundation:LayoutTokens.SpaceM}"
                    Margin="24">
                    <!-- 无权限：锁图标 -->
                    <iconPacks:PackIconPhosphorIcons
                        Width="52"
                        Height="52"
                        Kind="Lock"
                        Opacity="0.35"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding IsAccessDenied}" />
                    <!-- 目录为空 / 无匹配：空文件夹图标 -->
                    <iconPacks:PackIconPhosphorIcons
                        Width="52"
                        Height="52"
                        Kind="Folder"
                        Opacity="0.35"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding IsAccessDenied, Converter={x:Static BoolConverters.Not}}" />
                    <TextBlock
                        Text="{Binding EmptyStateMessage}"
                        FontSize="14"
                        Opacity="0.5"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        MaxWidth="240"
                        HorizontalAlignment="Center" />
                </StackPanel>
                <!-- 文件列表（加载中时隐藏，避免空列表在 Spinner 下方撑开空间） -->
                <ScrollViewer
                    IsVisible="{Binding IsLoading, Converter={x:Static BoolConverters.Not}}"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <Border Padding="24,0,24,16">
                        <ItemsControl ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceXS}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FilePickerEntry">
                                    <Button
                                        Classes="FileEntry"
                                        Command="{Binding DataContext.SelectItemCommand, ElementName=Root}"
                                        CommandParameter="{Binding Item}">
                                        <Grid
                                            ColumnDefinitions="38,*,Auto,Auto"
                                            Height="44"
                                            Margin="2,0">
                                            <!-- 图标列 -->
                                            <Panel
                                                Grid.Column="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                                <!-- 文件夹图标（目录） -->
                                                <iconPacks:PackIconPhosphorIcons
                                                    Width="{x:Static semantic:IconTokens.Compact}"
                                                    Height="{x:Static semantic:IconTokens.Compact}"
                                                    Kind="Folder"
                                                    Foreground="{DynamicResource Sem.Color.OnSurfaceVariant}"
                                                    IsVisible="{Binding Item, Converter={StaticResource IsFile}, ConverterParameter=invert}" />
                                                <!-- 文件图标 -->
                                                <iconPacks:PackIconPhosphorIcons
                                                    Width="{x:Static semantic:IconTokens.Compact}"
                                                    Height="{x:Static semantic:IconTokens.Compact}"
                                                    Kind="File"
                                                    Foreground="{DynamicResource Sem.Color.OnSurfaceVariant}"
                                                    IsVisible="{Binding Item, Converter={StaticResource IsFile}}" />
                                            </Panel>
                                            <!-- 文件名 + 大小副标题 -->
                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                                                <TextBlock
                                                    Text="{Binding Name}"
                                                    FontSize="14"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Text="{Binding Item, Converter={StaticResource FileSize}}"
                                                    FontSize="11"
                                                    Opacity="0.45"
                                                    IsVisible="{Binding Item, Converter={StaticResource IsFile}}" />
                                            </StackPanel>
                                            <!-- 多选时增加复选框，其余内容复用原文件行。 -->
                                            <CheckBox
                                                Grid.Column="3"
                                                IsVisible="{Binding CanSelect}"
                                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                AutomationProperties.Name="{Binding Name}"
                                                VerticalAlignment="Center"
                                                Margin="4,0,6,0" />
                                            <!-- 目录右箭头 -->
                                            <iconPacks:PackIconPhosphorIcons
                                                Grid.Column="2"
                                                Width="14"
                                                Height="14"
                                                Kind="CaretRight"
                                                Opacity="0.3"
                                                VerticalAlignment="Center"
                                                Margin="4,0,6,0"
                                                IsVisible="{Binding Item, Converter={StaticResource IsFile}, ConverterParameter=invert}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </ScrollViewer>
            </Panel>
            <!-- ── Footer（按模式显示，OpenFile 模式不显示底部栏） ── -->
        </DockPanel>
    </dialogs:DialogShell>
</UserControl>
