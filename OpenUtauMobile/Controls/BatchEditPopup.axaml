<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenUtauMobile.ViewModels"
             xmlns:theme="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Runtime"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             mc:Ignorable="d"
             x:Class="OpenUtauMobile.Controls.BatchEditPopup"
             x:DataType="vm:BatchEditViewModel"
             Classes="PopupDialogRoot BatchEditRoot"
             MinHeight="{x:Static theme:ThemeSemBatchEditTokens.PopupMinHeight}"
             MaxHeight="{x:Static theme:ThemeSemBatchEditTokens.PopupMaxHeight}"
             d:DesignWidth="560"
             d:DesignHeight="620">

    <UserControl.Resources>
        <DataTemplate x:Key="BatchEditItemTemplate" x:DataType="vm:BatchEditItemViewModel">
            <Border Classes="BatchEditItem">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <Border Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="0"
                            Classes="BatchEditItemIcon">
                        <iconPacks:PackIconPhosphorIcons Kind="{Binding Icon}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Text="{Binding Title}"
                               Classes="BatchEditItemTitle" />

                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Margin="{x:Static theme:ThemeSemBatchEditTokens.ParameterMargin}"
                                IsVisible="{Binding HasParameter}">
                        <TextBlock Text="{Binding ParameterLabel}"
                                   Classes="BatchEditParameterLabel" />
                        <TextBox Text="{Binding ParameterValue, Mode=TwoWay}"
                                 MinWidth="{x:Static theme:ThemeSemBatchEditTokens.ParameterMinWidth}"
                                 HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <Button Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="2"
                            Classes="BatchEditRunButton"
                            Command="{Binding ExecuteCommand}"
                            Content="{Binding ExecuteLabel}"
                            IsEnabled="{Binding !IsRunning}" />

                    <StackPanel Grid.Row="2"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Margin="{x:Static theme:ThemeSemBatchEditTokens.FeedbackMargin}">
                        <TextBlock Text="{Binding ProgressText}"
                                   Classes="BatchEditProgress"
                                   IsVisible="{Binding ProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Text="{Binding ValidationMessage}"
                                   Classes="BatchEditValidation"
                                   IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Classes="PopupDialogSurface">
        <DockPanel>
            <Border Classes="PopupTitleBar" DockPanel.Dock="Top">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <iconPacks:PackIconPhosphorIcons Grid.Column="0"
                                                       Kind="ListChecks"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{DynamicResource BatchEdit.Title}"
                               Classes="PopupTitle" />
                    <Button Grid.Column="2"
                            Classes="PopupCloseBtn"
                            Command="{Binding CloseCommand}"
                            ToolTip.Tip="{DynamicResource Common.Close}"
                            Content="{iconPacks:PhosphorIcons X}" />
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top" Classes="BatchEditScope">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <iconPacks:PackIconPhosphorIcons Kind="SelectionAll"
                                                       VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ScopeText}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Bottom"
                    Classes="BatchEditStatus"
                    IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
            </Border>

            <TabControl Margin="{x:Static theme:ThemeSemBatchEditTokens.TabMargin}">
                <TabItem Header="{DynamicResource BatchEdit.Tab.Lyrics}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LyricActions}"
                                      ItemTemplate="{StaticResource BatchEditItemTemplate}" />
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{DynamicResource BatchEdit.Tab.Notes}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding NoteActions}"
                                      ItemTemplate="{StaticResource BatchEditItemTemplate}" />
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{DynamicResource BatchEdit.Tab.Reset}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ResetActions}"
                                      ItemTemplate="{StaticResource BatchEditItemTemplate}" />
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</UserControl>
