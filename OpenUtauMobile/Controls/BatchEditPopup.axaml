<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:semantic="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Semantic"
    xmlns:foundation="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Foundation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OpenUtauMobile.ViewModels"
    xmlns:localTokens="clr-namespace:OpenUtauMobile.Controls.Tokens"
    xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
    xmlns:dialogs="clr-namespace:OpenUtauMobile.Controls"
    mc:Ignorable="d"
    x:Class="OpenUtauMobile.Controls.BatchEditPopup"
    x:DataType="vm:BatchEditViewModel"
    Classes="PopupDialogRoot BatchEditRoot DialogHeightExpanded"
    d:DesignWidth="560"
    d:DesignHeight="620">
    <UserControl.Styles>
        <StyleInclude Source="/Controls/Styles/BatchEditPopup.axaml" />
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- Action 项目模板 -->
        <DataTemplate x:Key="BatchEditItemTemplate" x:DataType="vm:BatchEditItemViewModel">
            <Border Classes="BatchEditItem">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceS}" RowSpacing="{x:Static foundation:LayoutTokens.SpaceS}">
                    <Border
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="0"
                        Classes="BatchEditItemIcon">
                        <iconPacks:PackIconPhosphorIcons
                            Kind="{Binding Icon}"
                            Width="{x:Static semantic:IconTokens.Standard}" Height="{x:Static semantic:IconTokens.Standard}"
                            Foreground="{DynamicResource Sem.Color.OnPrimaryContainer}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Text="{Binding Title}"
                        Classes="BatchEditItemTitle" />
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"

                        IsVisible="{Binding HasParameter}" Spacing="{x:Static foundation:LayoutTokens.SpaceXS}">
                        <TextBlock Text="{Binding ParameterLabel}" Classes="BatchEditParameterLabel" />
                        <TextBox
                            Text="{Binding ParameterValue, Mode=TwoWay}"
                            MinWidth="{x:Static localTokens:BatchEditTokens.ParameterMinWidth}"
                            HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <!-- 操作独立成行，给窄窗口的标题和参数保留完整宽度。 -->
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal"
                                HorizontalAlignment="Right" Spacing="{x:Static foundation:LayoutTokens.SpaceS}">
                        <Button Classes="icon" Classes.tonal="{Binding IsPinned}"
                                Command="{Binding TogglePinCommand}"
                                ToolTip.Tip="{Binding PinLabel}" AutomationProperties.Name="{Binding PinLabel}">
                            <iconPacks:PackIconPhosphorIcons Kind="{Binding PinIcon}"
                                Width="{x:Static semantic:IconTokens.Standard}" Height="{x:Static semantic:IconTokens.Standard}" />
                        </Button>
                        <Button Classes="icon tonal" Command="{Binding ExecuteCommand}"
                                ToolTip.Tip="{Binding ExecuteLabel}" AutomationProperties.Name="{Binding ExecuteLabel}">
                            <iconPacks:PackIconPhosphorIcons Kind="Play"
                                Width="{x:Static semantic:IconTokens.Standard}" Height="{x:Static semantic:IconTokens.Standard}" />
                        </Button>
                    </StackPanel>
                    <StackPanel
                        Grid.Row="3"
                        Grid.Column="1"
                        >
                        <TextBlock
                            Text="{Binding ValidationMessage}"
                            Classes="BatchEditValidation"
                            IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <dialogs:DialogShell CloseCommand="{Binding CloseCommand}" Header="{DynamicResource BatchEdit.Title}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Classes="BatchEditScope">
                <StackPanel Orientation="Horizontal" Spacing="{x:Static foundation:LayoutTokens.SpaceS}">
                    <iconPacks:PackIconPhosphorIcons
                        Kind="SelectionAll"
                        Foreground="{DynamicResource Sem.Color.OnSecondaryContainer}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="{Binding ScopeText}"
                        Foreground="{DynamicResource Sem.Color.OnSecondaryContainer}"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <!-- Tab 页：歌词、音符、重置 -->
            <Border Classes="DialogBodyBorder">
                <TabControl>
                    <TabItem Header="{DynamicResource BatchEdit.Tab.Lyrics}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Classes="BatchEditPinnedGroup" IsVisible="{Binding HasPinnedLyrics}">
                                    <StackPanel>
                                        <TextBlock Classes="BatchEditPinnedHeader" Text="{DynamicResource BatchEdit.Pinned}" />
                                        <ItemsControl ItemsSource="{Binding PinnedLyricActions}" ItemTemplate="{StaticResource BatchEditItemTemplate}" />
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding LyricActions}" ItemTemplate="{StaticResource BatchEditItemTemplate}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{DynamicResource BatchEdit.Tab.Notes}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Classes="BatchEditPinnedGroup" IsVisible="{Binding HasPinnedNotes}">
                                    <StackPanel>
                                        <TextBlock Classes="BatchEditPinnedHeader" Text="{DynamicResource BatchEdit.Pinned}" />
                                        <ItemsControl ItemsSource="{Binding PinnedNoteActions}" ItemTemplate="{StaticResource BatchEditItemTemplate}" />
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding NoteActions}" ItemTemplate="{StaticResource BatchEditItemTemplate}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{DynamicResource BatchEdit.Tab.Reset}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Classes="BatchEditPinnedGroup" IsVisible="{Binding HasPinnedReset}">
                                    <StackPanel>
                                        <TextBlock Classes="BatchEditPinnedHeader" Text="{DynamicResource BatchEdit.Pinned}" />
                                        <ItemsControl ItemsSource="{Binding PinnedResetActions}" ItemTemplate="{StaticResource BatchEditItemTemplate}" />
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding ResetActions}" ItemTemplate="{StaticResource BatchEditItemTemplate}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </DockPanel>
    </dialogs:DialogShell>
</UserControl>
