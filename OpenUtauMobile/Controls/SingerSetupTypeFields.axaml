<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:OpenUtauMobile.ViewModels"
    xmlns:foundation="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Foundation"
    xmlns:semantic="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Semantic"
    xmlns:components="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Components"
    xmlns:theme="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens"
    xmlns:tools="clr-namespace:OpenUtauMobile.Tools"
    xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
    x:Class="OpenUtauMobile.Controls.SingerSetupTypeFields"
    x:DataType="vm:ClassicSingerSetupViewModel">
    <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceM}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <TextBlock
                Grid.Column="0"
                Text="{DynamicResource SingerSetup.Step3.SingerType}"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Foreground="{DynamicResource Sem.Color.OnSurface}"/>
            <ComboBox
                Grid.Column="1"
                ItemsSource="{Binding SingerTypes}"
                SelectedItem="{Binding SingerType}"
                MaxWidth="200"
                HorizontalAlignment="Stretch"/>
        </Grid>
        <Border
            BorderThickness="1"
            BorderBrush="{DynamicResource Sem.Color.OnSurfaceVariant}"
            CornerRadius="{x:Static foundation:ShapeTokens.CornerS}"
            Padding="{x:Static foundation:LayoutTokens.InsetSM}">
            <StackPanel Spacing="{x:Static foundation:LayoutTokens.SpaceS}">
                <TextBlock
                    Text="{DynamicResource SingerSetup.Step3.TypeHelp}"
                    FontWeight="SemiBold"
                    FontSize="{x:Static semantic:TypographyTokens.BodySSize}"
                    Foreground="{DynamicResource Sem.Color.OnSurface}"/>
                <TextBlock
                    Text="{DynamicResource SingerSetup.Step3.TypeUtau}"
                    FontSize="{x:Static semantic:TypographyTokens.LabelSSize}"
                    TextWrapping="Wrap"/>
                <TextBlock
                    Text="{DynamicResource SingerSetup.Step3.TypeEnunu}"
                    FontSize="{x:Static semantic:TypographyTokens.LabelSSize}"
                    TextWrapping="Wrap"/>
                <TextBlock
                    Text="{DynamicResource SingerSetup.Step3.TypeDiffSinger}"
                    FontSize="{x:Static semantic:TypographyTokens.LabelSSize}"
                    TextWrapping="Wrap"/>
                <TextBlock
                    Text="{DynamicResource SingerSetup.Step3.TypeNeutrino}"
                    FontSize="{x:Static semantic:TypographyTokens.LabelSSize}"
                    TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
