<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themeControls="using:OpenUtauMobile.Themes.OpenUtauMobile.Controls"
             x:Class="OpenUtauMobile.Controls.EditorContextActions">
    <!-- 覆盖层填满各自编辑区，只有模式入口和操作面板接收输入。 -->
    <themeControls:FloatingToolbar x:Name="Toolbar" IsFixedVertical="True" IconOnly="True" />
</UserControl>
