<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:metrics="using:OpenUtauMobile.Themes.OpenUtauMobile.Tokens"
                    xmlns:local="using:OpenUtauMobile.Themes.OpenUtauMobile.Controls"
                    xmlns:semantic="using:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Semantic"
                    xmlns:foundation="using:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Foundation"
                    x:CompileBindings="False">
    <x:Double x:Key="OpumSliderMinimumSize">48</x:Double>
    <x:Double x:Key="OpumSliderHandleWidth">4</x:Double>
    <x:Double x:Key="OpumSliderHandleLength">44</x:Double>
    <x:Double x:Key="OpumSliderActiveHandleWidth">2</x:Double>
    <x:Double x:Key="OpumSliderFocusWidth">12</x:Double>
    <x:Double x:Key="OpumSliderFocusHeight">52</x:Double>
    <x:Double x:Key="OpumSliderTrackHeight">16</x:Double>
    <x:Double x:Key="OpumSliderHandleGap">6</x:Double>
    <!-- 轨道只负责命中，MD3 轨道及圆点由共享呈现器绘制。 -->
    <ControlTheme x:Key="OpumSliderTrackButton" TargetType="RepeatButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template"><ControlTemplate><Border Background="Transparent" /></ControlTemplate></Setter>
        <Style Selector="^:disabled"><Setter Property="Cursor" Value="Arrow" /></Style>
    </ControlTheme>
    <ControlTheme x:Key="OpumSliderThumbTheme" TargetType="Thumb">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- 可见把手与 48 DIP 命中区分离，状态变化不改变 Track 的拖动坐标。 -->
                <Grid Background="Transparent">
                    <Border x:Name="Handle" Background="{TemplateBinding Background}" CornerRadius="2"
                            Width="{DynamicResource OpumSliderHandleWidth}" Height="{DynamicResource OpumSliderHandleLength}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border x:Name="FocusRing" BorderBrush="{DynamicResource Sem.Color.Primary}" BorderThickness="3"
                            CornerRadius="6" Width="{DynamicResource OpumSliderFocusWidth}" Height="{DynamicResource OpumSliderFocusHeight}" IsVisible="False"
                            HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[Tag=vertical] /template/ Border#Handle, ^[Tag=vertical-active] /template/ Border#Handle, ^[Tag=vertical-focus] /template/ Border#Handle">
            <Setter Property="Width" Value="{DynamicResource OpumSliderHandleLength}" />
            <Setter Property="Height" Value="{DynamicResource OpumSliderHandleWidth}" />
        </Style>
        <Style Selector="^[Tag=vertical-focus] /template/ Border#FocusRing">
            <Setter Property="Width" Value="{DynamicResource OpumSliderFocusHeight}" /><Setter Property="Height" Value="{DynamicResource OpumSliderFocusWidth}" />
        </Style>
        <Style Selector="^[Tag=horizontal-active] /template/ Border#Handle, ^[Tag=horizontal-focus] /template/ Border#Handle">
            <Setter Property="Width" Value="{DynamicResource OpumSliderActiveHandleWidth}" />
        </Style>
        <Style Selector="^[Tag=vertical-active] /template/ Border#Handle, ^[Tag=vertical-focus] /template/ Border#Handle">
            <Setter Property="Height" Value="{DynamicResource OpumSliderActiveHandleWidth}" />
        </Style>
        <Style Selector="^[Tag=horizontal-focus] /template/ Border#FocusRing, ^[Tag=vertical-focus] /template/ Border#FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:disabled"><Setter Property="Cursor" Value="Arrow" /></Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">
        <Setter Property="Background" Value="{DynamicResource SliderTrackFill}" />
        <Setter Property="Foreground" Value="{DynamicResource SliderTrackValueFill}" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <DataValidationErrors>
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <Grid x:Name="SliderContainer" Background="Transparent" MinHeight="{DynamicResource OpumSliderMinimumSize}" MinWidth="{DynamicResource OpumSliderMinimumSize}">
                            <local:SliderTrackPresenter Source="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                       ThumbSize="{DynamicResource OpumSliderMinimumSize}"
                                                       TrackHeight="{DynamicResource OpumSliderTrackHeight}"
                                                       HandleWidth="{DynamicResource OpumSliderHandleWidth}"
                                                       ActiveHandleWidth="{DynamicResource OpumSliderActiveHandleWidth}"
                                                       HandleGap="{DynamicResource OpumSliderHandleGap}"
                                                       IsHitTestVisible="False"
                                                       ActiveTickBrush="{DynamicResource Sem.Color.OnPrimary}"
                                                       InactiveTickBrush="{DynamicResource Sem.Color.OnSecondaryContainer}"
                                                       DisabledActiveBrush="{DynamicResource SliderTrackValueFillDisabled}"
                                                       DisabledInactiveBrush="{DynamicResource SliderTrackFillDisabled}" />
                            <local:RelativeSliderTrack x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value, Mode=TwoWay}" Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseButton><RepeatButton x:Name="PART_DecreaseButton" Theme="{StaticResource OpumSliderTrackButton}" Focusable="False" /></Track.DecreaseButton>
                                <Track.IncreaseButton><RepeatButton x:Name="PART_IncreaseButton" Theme="{StaticResource OpumSliderTrackButton}" Focusable="False" /></Track.IncreaseButton>
                                <Thumb x:Name="SliderThumb" Width="{DynamicResource OpumSliderMinimumSize}" Height="{DynamicResource OpumSliderMinimumSize}"
                                       Theme="{StaticResource OpumSliderThumbTheme}" Background="{DynamicResource SliderThumbBackground}" />
                            </local:RelativeSliderTrack>
                            <local:SliderValueIndicator Source="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                        PlacementTarget="{Binding #SliderThumb}">
                                <Border Background="{DynamicResource Sem.Color.InverseSurface}"
                                        CornerRadius="{x:Static foundation:ShapeTokens.CornerXL}"
                                        Padding="12,8" IsHitTestVisible="False">
                                    <TextBlock Text="{TemplateBinding local:SliderValueIndicator.ValueText}"
                                               Foreground="{DynamicResource Sem.Color.InverseOnSurface}"
                                               FontSize="{x:Static semantic:TypographyTokens.LabelLSize}"
                                               FontWeight="Medium" FontFeatures="tnum" />
                                </Border>
                            </local:SliderValueIndicator>
                        </Grid>
                    </Border>
                </DataValidationErrors>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:vertical /template/ Thumb"><Setter Property="Tag" Value="vertical" /></Style>
        <!-- 状态只传递给把手主题，不覆盖调用方的轨道颜色。 -->
        <Style Selector="^:horizontal:pressed:not(:disabled) /template/ Thumb"><Setter Property="Tag" Value="horizontal-active" /></Style>
        <Style Selector="^:vertical:pressed:not(:disabled) /template/ Thumb"><Setter Property="Tag" Value="vertical-active" /></Style>
        <Style Selector="^:horizontal:focus-visible:not(:disabled) /template/ Thumb"><Setter Property="Tag" Value="horizontal-focus" /></Style>
        <Style Selector="^:vertical:focus-visible:not(:disabled) /template/ Thumb"><Setter Property="Tag" Value="vertical-focus" /></Style>
        <Style Selector="^:disabled /template/ Thumb"><Setter Property="Background" Value="{DynamicResource SliderThumbBackgroundDisabled}" /></Style>
        <Style Selector="^:error">
            <Setter Property="Foreground" Value="{DynamicResource Sem.Color.Error}" />
            <Style Selector="^ /template/ Thumb"><Setter Property="Background" Value="{DynamicResource Sem.Color.Error}" /></Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
