<Styles xmlns="https://github.com/avaloniaui"
        xmlns:foundation="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Foundation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens"
        xmlns:components="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Components"
        xmlns:semantic="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Semantic">
    <Design.PreviewWith>
        <Border Padding="{x:Static foundation:LayoutTokens.InsetL}">
            <StackPanel>
                <TabItem Header="Available" IsSelected="True" />
                <TabItem Header="Installed" />
                <TabItem Header="Disabled" IsEnabled="False" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Style Selector="TabItem">
        <Setter Property="MinHeight" Value="{x:Static components:TabItemTokens.ContainerHeight}" />
        <Setter Property="Padding" Value="{x:Static components:TabItemTokens.HeaderInset}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="{DynamicResource Sem.Color.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Color.OnSurfaceVariant}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="{x:Static components:TabItemTokens.LabelSize}" />
        <Setter Property="FontWeight" Value="{x:Static components:TabItemTokens.LabelWeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate TargetType="TabItem">
                <Grid MinHeight="{TemplateBinding MinHeight}"
                      Background="{TemplateBinding Background}">
                    <ContentPresenter x:Name="PART_ContentPresenter"
                                      Margin="{TemplateBinding Padding}"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RecognizesAccessKey="True" />
                    <Border x:Name="PART_StateLayer"
                            Background="{DynamicResource Sem.Color.OnSurface}"
                            IsHitTestVisible="False"
                            Opacity="0" />
                    <Border x:Name="PART_SelectedIndicator"
                            Height="{x:Static components:TabItemTokens.ActiveIndicatorHeight}"
                            Background="{DynamicResource Sem.Color.Primary}"
                            CornerRadius="{x:Static components:TabItemTokens.ActiveIndicatorCorner}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            IsVisible="False" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource Sem.Color.OnSurface}" />
    </Style>

    <Style Selector="TabItem:pointerover /template/ Border#PART_StateLayer">
        <Setter Property="Opacity" Value="{x:Static semantic:StateOpacityTokens.Hover}" />
    </Style>

    <Style Selector="TabItem:focus /template/ Border#PART_StateLayer">
        <Setter Property="Opacity" Value="{x:Static semantic:StateOpacityTokens.Focus}" />
    </Style>

    <Style Selector="TabItem:pressed /template/ Border#PART_StateLayer">
        <Setter Property="Opacity" Value="{x:Static semantic:StateOpacityTokens.Pressed}" />
    </Style>

    <Style Selector="TabItem:selected /template/ Border#PART_SelectedIndicator">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="TabItem:disabled">
        <Setter Property="Opacity" Value="{x:Static semantic:StateOpacityTokens.Disabled}" />
    </Style>
</Styles>
