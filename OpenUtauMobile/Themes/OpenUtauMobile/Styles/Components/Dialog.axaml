<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenUtauMobile.Controls"
        xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
        xmlns:icons="https://github.com/MahApps/IconPacks.Avalonia"
        xmlns:foundation="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Foundation"
        xmlns:semantic="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Semantic"
        xmlns:components="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Tokens.Components">
    <!-- 弹窗外观的唯一入口；业务视图不再绘制标题栏、关闭图标或底栏边框。 -->
    <Styles.Resources>
        <ControlTheme x:Key="{x:Type controls:DialogShell}" TargetType="controls:DialogShell">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent"
                            CornerRadius="{x:Static components:DialogTokens.CornerRadius}"
                            ClipToBounds="True">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <!-- 独立底色层透出宿主已模糊的背景，不影响前景控件透明度。 -->
                            <Border Grid.Row="0" Name="PART_SurfaceLayer" Grid.RowSpan="3"
                                    Background="{DynamicResource Sem.Color.SurfaceContainerHigh}"
                                    Opacity="{x:Static components:DialogTokens.SurfaceOpacity}"
                                    CornerRadius="{x:Static components:DialogTokens.CornerRadius}"
                                    IsHitTestVisible="False" />
                            <Border Grid.Row="0" Padding="{x:Static components:DialogTokens.HeaderPadding}">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="{x:Static foundation:LayoutTokens.SpaceS}">
                                    <ContentPresenter Name="PART_HeaderPresenter" Content="{TemplateBinding Header}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                      VerticalAlignment="Center"
                                                      TextElement.FontSize="{x:Static components:DialogTokens.TitleSize}"
                                                      TextElement.FontWeight="SemiBold"
                                                      TextElement.Foreground="{DynamicResource Sem.Color.OnSurface}" />
                                    <Button Grid.Column="1" Classes="DialogClose"
                                            Command="{TemplateBinding CloseCommand}"
                                            IsVisible="{Binding CloseCommand, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            ToolTip.Tip="{DynamicResource Common.Close}"
                                            AutomationProperties.Name="{DynamicResource Common.Close}">
                                        <icons:PackIconPhosphorIcons Kind="X"
                                                                     Width="{x:Static semantic:IconTokens.Standard}"
                                                                     Height="{x:Static semantic:IconTokens.Standard}" />
                                    </Button>
                                </Grid>
                            </Border>
                            <ContentPresenter Name="PART_ContentPresenter" Grid.Row="1"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <Border Grid.Row="2" Padding="{x:Static components:DialogTokens.FooterPadding}"
                                    IsVisible="{Binding Footer.IsVisible, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=False}">
                                <ContentPresenter Content="{TemplateBinding Footer}"
                                                  HorizontalContentAlignment="Stretch" />
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ControlTheme>
    </Styles.Resources>
    <Style Selector="dialogHost|DialogHost">
        <Setter Property="DialogMargin" Value="{x:Static components:DialogTokens.ViewportMargin}" />
    </Style>
    <!-- 覆盖宿主默认的 0.56；使用不透明语义色，避免遮罩透明度重复相乘。 -->
    <Style Selector="dialogHost|DialogHost[IsOpen=True] /template/ Rectangle#PART_ContentCover">
        <Setter Property="Opacity" Value="{x:Static components:DialogTokens.ScrimOpacity}" />
    </Style>
    <Style Selector=":is(controls|PopupDialogControl).PopupDialogRoot">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="MaxHeight" Value="{x:Static components:DialogTokens.DefaultMaxHeight}" />
    </Style>
    <!-- 高度预设只负责根节点尺寸；各弹窗按用途选择其中一个。 -->
    <Style Selector=":is(controls|PopupDialogControl).PopupDialogRoot.DialogHeightCompact">
        <Setter Property="MinHeight" Value="{x:Static components:DialogTokens.CompactMinHeight}" />
        <Setter Property="MaxHeight" Value="{x:Static components:DialogTokens.CompactMaxHeight}" />
    </Style>
    <Style Selector=":is(controls|PopupDialogControl).PopupDialogRoot.DialogHeightRegular">
        <Setter Property="MinHeight" Value="{x:Static components:DialogTokens.RegularMinHeight}" />
    </Style>
    <Style Selector=":is(controls|PopupDialogControl).PopupDialogRoot.DialogHeightList">
        <Setter Property="MinHeight" Value="{x:Static components:DialogTokens.ListMinHeight}" />
        <Setter Property="MaxHeight" Value="{x:Static components:DialogTokens.ListMaxHeight}" />
    </Style>
    <Style Selector=":is(controls|PopupDialogControl).PopupDialogRoot.DialogHeightExpanded">
        <Setter Property="MinHeight" Value="{x:Static components:DialogTokens.ExpandedMinHeight}" />
    </Style>
    <Style Selector="TextBlock.PopupTitle">
        <Setter Property="FontSize" Value="{x:Static components:DialogTokens.TitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Color.OnSurface}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.DialogSubtitle">
        <Setter Property="FontSize" Value="{x:Static semantic:TypographyTokens.BodyMSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Color.OnSurfaceVariant}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.DialogBodyBorder">
        <Setter Property="Padding" Value="{x:Static components:DialogTokens.BodyPadding}" />
    </Style>
    <Style Selector="controls|DialogActionRows">
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="Spacing" Value="{x:Static foundation:LayoutTokens.SpaceS}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="controls|DialogActionRows > ContentPresenter">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector=":is(controls|DialogActionRow)">
        <Setter Property="Spacing" Value="{x:Static foundation:LayoutTokens.SpaceS}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector=":is(controls|DialogActionRow) > ContentPresenter">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.DialogAction, :is(controls|DialogActionRow) Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="{x:Static components:DialogTokens.ControlMinSize}" />
        <Setter Property="Padding" Value="{x:Static components:DialogTokens.ActionPadding}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="{x:Static semantic:TypographyTokens.LabelLSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CornerRadius" Value="{x:Static components:DialogTokens.ActionCornerRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Color.Primary}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.DialogPrimary">
        <Setter Property="Background" Value="{DynamicResource Sem.Color.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Color.OnPrimary}" />
    </Style>
    <Style Selector="Button.DialogDestructive">
        <Setter Property="Background" Value="{DynamicResource Sem.Color.Error}" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Color.OnError}" />
    </Style>

    <Style Selector="Button.DialogClose, Button.DialogNavigation">
        <Setter Property="Width" Value="{x:Static components:DialogTokens.ControlMinSize}" />
        <Setter Property="Height" Value="{x:Static components:DialogTokens.ControlMinSize}" />
        <Setter Property="Padding" Value="{x:Static foundation:LayoutTokens.InsetS}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Color.OnSurfaceVariant}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{x:Static components:DialogTokens.ActionCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style
        Selector="Button.DialogAction /template/ ContentPresenter TextBlock, :is(controls|DialogActionRow) Button /template/ ContentPresenter TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
</Styles>
