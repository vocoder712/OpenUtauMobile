<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 全局颜色资源；运行时生成的颜色仍由主题协调器注入。 -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude
                    Source="avares://OpenUtauMobile/Themes/OpenUtauMobile/Resources/Color/SemanticColor.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- Avalonia 内置控件的全局覆盖；FluentTheme 继续提供基础主题。 -->
    <StyleInclude Source="/Themes/OpenUtauMobile/Styles/Controls/Button.axaml" />
    <StyleInclude Source="/Themes/OpenUtauMobile/Styles/Controls/TextBox.axaml" />
    <StyleInclude Source="/Themes/OpenUtauMobile/Styles/Controls/ComboBox.axaml" />
    <StyleInclude Source="/Themes/OpenUtauMobile/Styles/Controls/TabItem.axaml" />
    <StyleInclude Source="/Themes/OpenUtauMobile/Styles/Controls/Slider.axaml" />
    <StyleInclude Source="/Themes/OpenUtauMobile/Styles/Controls/ProgressBar.axaml" />
    <StyleInclude Source="/Themes/OpenUtauMobile/Styles/Controls/ToggleSwitch.axaml" />

    <!-- 已有跨功能复用的 OPUM 组件；页面及业务控件样式由各自所有者加载。 -->
    <StyleInclude Source="/Themes/OpenUtauMobile/Styles/Components/TopBar.axaml" />
    <StyleInclude Source="/Themes/OpenUtauMobile/Styles/Components/OptionEntry.axaml" />
    <StyleInclude Source="/Themes/OpenUtauMobile/Styles/Components/FAB.axaml" />
    <StyleInclude Source="/Themes/OpenUtauMobile/Styles/Components/Card.axaml" />
    <StyleInclude Source="/Themes/OpenUtauMobile/Styles/Components/DawKnob.axaml" />
    <StyleInclude Source="/Themes/OpenUtauMobile/Styles/Components/Icon.axaml" />
    <StyleInclude Source="/Themes/OpenUtauMobile/Styles/Components/Dialog.axaml" />
</Styles>
