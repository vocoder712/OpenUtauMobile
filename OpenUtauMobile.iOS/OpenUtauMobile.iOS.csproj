<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-ios</TargetFramework>
        <SupportedOSPlatformVersion>15.1</SupportedOSPlatformVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- iOS 配置 -->
    <PropertyGroup>
        <!-- 仅解释执行反射创建音素器的程序集，其余代码仍使用 Mono AOT。 -->
        <PublishAot>false</PublishAot>
        <MtouchUseLlvm>false</MtouchUseLlvm>
        <MtouchInterpreter>OpenUtau.Plugin.Builtin,OpenUtau.Core</MtouchInterpreter>
        <TrimMode>partial</TrimMode>
        <EnableAssemblyILStripping>false</EnableAssemblyILStripping>
        <!-- 避免将全部泛型实例聚合到过大的 aot-instances.dll。 -->
        <_IsDedupEnabled>false</_IsDedupEnabled>
        <AppIcon>AppIcon</AppIcon>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.iOS" Version="$(AvaloniaVersion)"/>
        <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0"/>
        <PackageReference Include="Microsoft.ML.OnnxRuntime.Extensions" Version="0.14.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\OpenUtauMobile\OpenUtauMobile.csproj"/>
    </ItemGroup>
    <Import Project="../native/worldline/WorldlineNative.targets" />
</Project>
