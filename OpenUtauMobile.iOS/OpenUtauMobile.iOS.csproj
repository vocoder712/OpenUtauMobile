<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-ios</TargetFramework>
        <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- iOS 配置 -->
    <PropertyGroup>
        <!-- 常规构建禁用 IL 链接器；NativeAOT 使用工作流指定的全量链接。 -->
        <MtouchLink Condition="'$(PublishAot)' != 'true'">None</MtouchLink>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.iOS" Version="$(AvaloniaVersion)"/>
        <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0"/>
        <PackageReference Include="Microsoft.ML.OnnxRuntime.Extensions" Version="0.14.0"/>
    </ItemGroup>

    <ItemGroup>
        <!-- NativeAOT 只应用于 iOS 可执行入口，不能传播到普通 net10.0 类库。 -->
        <ProjectReference Include="..\OpenUtauMobile\OpenUtauMobile.csproj"
                          GlobalPropertiesToRemove="PublishAot;MtouchLink"/>
    </ItemGroup>
</Project>
