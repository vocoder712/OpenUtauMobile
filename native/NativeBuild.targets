<Project>
    <PropertyGroup>
        <_NativeRoot>$(MSBuildThisFileDirectory)</_NativeRoot>
        <_NativePlatform>$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))</_NativePlatform>
        <_NativePlatform Condition="'$(MSBuildProjectName)' == 'OpenUtauMobile.Linux'">linux</_NativePlatform>
        <_NativePlatform Condition="'$(MSBuildProjectName)' == 'OpenUtauMobile.MacOS'">osx</_NativePlatform>
        <_NativeDesktop Condition="'$(_NativePlatform)' == 'windows' or '$(_NativePlatform)' == 'linux' or '$(_NativePlatform)' == 'osx'">true</_NativeDesktop>
        <_NativePython Condition="$([MSBuild]::IsOSPlatform('Windows'))">python</_NativePython>
        <_NativePython Condition="'$(_NativePython)' == ''">python3</_NativePython>
    </PropertyGroup>
    <!-- 桌面入口在 SDK 推断输出路径之前选择目标，类库不导入本文件。 -->
    <PropertyGroup Condition="'$(_NativeDesktop)' == 'true'">
        <_NativeArchitecture>$([System.Text.RegularExpressions.Regex]::Replace('$(NETCoreSdkRuntimeIdentifier)', '^.*-', ''))</_NativeArchitecture>
        <_NativeArchitecture Condition="'$(Platform)' == 'x86' or '$(Platform)' == 'x64' or '$(Platform)' == 'ARM64'">$(Platform)</_NativeArchitecture>
        <_NativeArchitecture Condition="'$(PlatformTarget)' != '' and '$(PlatformTarget)' != 'AnyCPU'">$(PlatformTarget)</_NativeArchitecture>
        <_NativeDesktopRid>$(_NativePlatform)-$([System.String]::Copy('$(_NativeArchitecture)').ToLowerInvariant())</_NativeDesktopRid>
        <_NativeDesktopRid Condition="'$(_NativePlatform)' == 'windows'">win-$([System.String]::Copy('$(_NativeArchitecture)').ToLowerInvariant())</_NativeDesktopRid>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(_NativeDesktopRid)</RuntimeIdentifier>
        <CopyNuGetNativeSymbols Condition="'$(CopyNuGetNativeSymbols)' == ''">false</CopyNuGetNativeSymbols>
        <PublishSelfContained>true</PublishSelfContained>
    </PropertyGroup>
    <PropertyGroup Condition="'$(_NativePlatform)' == 'android'">
        <AndroidNdkVersion>$([System.IO.File]::ReadAllText('$(_NativeRoot)android-ndk-version.txt').Trim())</AndroidNdkVersion>
        <_NativeResolveSdk>_ResolveSdks</_NativeResolveSdk>
    </PropertyGroup>
    <ItemGroup Condition="'$(_NativePlatform)' == 'ios'">
        <Compile Include="$(_NativeRoot)worldline/WorldlineIosResolver.cs" Link="Interop/WorldlineIosResolver.cs" />
    </ItemGroup>
    <Target Name="SelectNativeAndroidNdk" AfterTargets="_ResolveSdks" Condition="'$(_NativePlatform)' == 'android'">
        <PropertyGroup>
            <AndroidNdkDirectory Condition="'$(AndroidNdkDirectory)' == ''">$(_AndroidSdkDirectory)/ndk/$(AndroidNdkVersion)</AndroidNdkDirectory>
            <_AndroidNdkDirectory>$([MSBuild]::EnsureTrailingSlash('$(AndroidNdkDirectory)'))</_AndroidNdkDirectory>
        </PropertyGroup>
    </Target>
    <Target Name="SelectNativeRuntimes">
        <ItemGroup>
            <!-- Android 多 RID 与 SDK 的发布资产计算使用同一集合。 -->
            <_NativeRuntime Include="$(RuntimeIdentifiers)" Condition="'$(_NativePlatform)' == 'android' and '$(RuntimeIdentifiers)' != ''" />
            <_NativeRuntime Include="$(RuntimeIdentifier)" Condition="'$(_NativePlatform)' != 'android' or '$(RuntimeIdentifiers)' == ''" />
            <_NativeRuntime Update="@(_NativeRuntime)">
                <Abi Condition="'%(_NativeRuntime.Identity)' == 'android-arm64'">arm64-v8a</Abi>
                <Abi Condition="'%(_NativeRuntime.Identity)' == 'android-arm'">armeabi-v7a</Abi>
                <Abi Condition="'%(_NativeRuntime.Identity)' == 'android-x64'">x86_64</Abi>
                <Abi Condition="'%(_NativeRuntime.Identity)' == 'android-x86'">x86</Abi>
            </_NativeRuntime>
        </ItemGroup>
    </Target>
    <Target Name="PrepareNativeBuild" DependsOnTargets="$(_NativeResolveSdk);SelectNativeRuntimes"
            Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
        <ItemGroup>
            <_NativeCommonSource Include="$(_NativeRoot)build.py;$(_NativeRoot)NativeBuild.targets;$(_NativeRoot).bazelrc;$(_NativeRoot).bazelversion" />
            <_NativeCommonSource Include="$(_NativeRoot)android-ndk-version.txt;$(_NativeRoot)android-ndk-inputs.patch" Condition="'$(_NativePlatform)' == 'android'" />
            <_WorldlineSource Include="$(_NativeRoot)upstream_cpp/**/*;$(_NativeRoot)worldline/**/*"
                              Exclude="$(_NativeRoot)**/__pycache__/**;$(_NativeRoot)**/*.md;$(_NativeRoot)**/LICENSE*;$(_NativeRoot)worldline/WorldlineIosResolver.cs" />
            <_GameSource Include="$(_NativeRoot)game/**/*" Exclude="$(_NativeRoot)**/__pycache__/**;$(_NativeRoot)**/*.md" />
            <_NativeBuild Include="@(_NativeRuntime)">
                <Library>worldline</Library>
                <LibraryFile>libworldline.so</LibraryFile>
                <LibraryFile Condition="'$(_NativePlatform)' == 'windows'">worldline.dll</LibraryFile>
                <LibraryFile Condition="'$(_NativePlatform)' == 'osx'">libworldline.dylib</LibraryFile>
                <LibraryFile Condition="'$(_NativePlatform)' == 'ios'">libworldline.a</LibraryFile>
                <LibraryFile Condition="'$(_NativePlatform)' == 'browser'">worldline.a</LibraryFile>
                <Sources>@(_NativeCommonSource);@(_WorldlineSource)</Sources>
            </_NativeBuild>
            <_NativeBuild Include="@(_NativeRuntime)" Condition="'$(_NativeDesktop)' == 'true' or '$(_NativePlatform)' == 'android'">
                <Library>game</Library>
                <LibraryFile>libopum_game.so</LibraryFile>
                <LibraryFile Condition="'$(_NativePlatform)' == 'windows'">opum_game.dll</LibraryFile>
                <LibraryFile Condition="'$(_NativePlatform)' == 'osx'">libopum_game.dylib</LibraryFile>
                <Sources>@(_NativeCommonSource);@(_GameSource)</Sources>
            </_NativeBuild>
            <_NativeBuild Update="@(_NativeBuild)">
                <OutputDirectory>$(_NativeRoot)../artifacts/native/%(_NativeBuild.Identity)</OutputDirectory>
                <InputFile>$(_NativeRoot)../artifacts/native/%(_NativeBuild.Identity)/%(_NativeBuild.Library).inputs</InputFile>
                <Stamp>$(_NativeRoot)../artifacts/native/%(_NativeBuild.Identity)/%(_NativeBuild.Library).stamp</Stamp>
                <OutputFile>$(_NativeRoot)../artifacts/native/%(_NativeBuild.Identity)/%(_NativeBuild.LibraryFile)</OutputFile>
            </_NativeBuild>
        </ItemGroup>
        <MakeDir Directories="@(_NativeBuild->'%(OutputDirectory)')" />
        <!-- 同一份继承参数同时供增量判断与 Python 使用，源文件增删也会使输入列表变化。 -->
        <WriteLinesToFile File="%(_NativeBuild.InputFile)" WriteOnlyWhenDifferent="true" Overwrite="true"
                          Lines="NativeLibrary=%(_NativeBuild.Library);RuntimeIdentifier=%(_NativeBuild.Identity);NativeFileName=%(_NativeBuild.LibraryFile);AndroidNdkDirectory=$(AndroidNdkDirectory);SupportedOSPlatformVersion=$(SupportedOSPlatformVersion);EmscriptenSdkToolsPath=$(EmscriptenSdkToolsPath);EmscriptenCacheSdkCacheDir=$(EmscriptenCacheSdkCacheDir);EmscriptenNodeToolsPath=$(EmscriptenNodeToolsPath);WasmEnableThreads=$(WasmEnableThreads);WasmEnableSIMD=$(WasmEnableSIMD);WasmEnableExceptionHandling=$(WasmEnableExceptionHandling);%(_NativeBuild.Sources)" />
    </Target>
    <!-- 原生成功记录位于共享 artifacts，SDK 的 bin/obj 清理不会处理它们。 -->
    <Target Name="CleanNativeLibraries" AfterTargets="CoreClean" DependsOnTargets="SelectNativeRuntimes">
        <Delete Files="@(_NativeRuntime->'$(_NativeRoot)../artifacts/native/%(Identity)/worldline.stamp');@(_NativeRuntime->'$(_NativeRoot)../artifacts/native/%(Identity)/game.stamp')" />
    </Target>
    <Target Name="BuildNativeLibraries" DependsOnTargets="PrepareNativeBuild"
            Inputs="%(_NativeBuild.Sources);%(_NativeBuild.InputFile)" Outputs="%(_NativeBuild.Stamp)"
            Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
        <Exec Command="&quot;$(_NativePython)&quot; &quot;$(_NativeRoot)build.py&quot; &quot;%(_NativeBuild.InputFile)&quot;" />
        <Touch Files="%(_NativeBuild.Stamp)" AlwaysCreate="true" />
    </Target>
    <Target Name="CollectNativeLibraries" BeforeTargets="AssignTargetPaths;_ComputeAndroidAssetsPaths"
            DependsOnTargets="BuildNativeLibraries"
            Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
        <ItemGroup Condition="'$(_NativePlatform)' == 'android'">
            <AndroidNativeLibrary Include="@(_NativeBuild->'%(OutputFile)')" Abi="%(_NativeBuild.Abi)" />
        </ItemGroup>
        <ItemGroup Condition="'$(_NativeDesktop)' == 'true'">
            <Content Include="@(_NativeBuild->'%(OutputFile)')" Link="%(_NativeBuild.LibraryFile)"
                     CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        </ItemGroup>
        <ItemGroup Condition="'$(_NativePlatform)' == 'ios'">
            <NativeReference Include="@(_NativeBuild->'%(OutputFile)')" Kind="Static" ForceLoad="true" SmartLink="false" IsCxx="true"
                             Frameworks="AudioToolbox AVFoundation CoreAudio CoreFoundation Foundation" />
            <ReferenceNativeSymbol Include="F0FrameCount;F0;DecodeMgc;DecodeBap;InitAnalysisConfig;WorldAnalysisF0In;WorldSynthesisSampleCount;WorldSynthesis;HnAnalysisF0In;WorldSynthesisContinuousNoise;ou_get_audio_device_infos;ou_free_audio_device_infos;ou_init_audio_device;ou_init_audio_device_auto;ou_get_audio_device_api;ou_get_audio_device_name;ou_free_audio_device;ou_audio_device_start;ou_audio_device_stop;ou_audio_get_error_message" SymbolType="Function" />
        </ItemGroup>
        <ItemGroup Condition="'$(_NativePlatform)' == 'browser'">
            <NativeFileReference Include="@(_NativeBuild->'%(OutputFile)')" />
        </ItemGroup>
    </Target>
    <Target Name="TrackWorldlineWasmTrampolines" BeforeTargets="_WasmCompileNativeSourceFiles" Condition="'$(_NativePlatform)' == 'browser'">
        <!-- runtime.c 包含跳板表，将该表加入 SDK 原生编译的增量依赖。 -->
        <ItemGroup>
            <_WasmRuntimePackSrcFile Update="@(_WasmRuntimePackSrcFile)" Condition="'%(_WasmRuntimePackSrcFile.Filename)' == 'runtime'">
                <Dependencies>%(_WasmRuntimePackSrcFile.Dependencies);$(_WasmInterpToNativeTablePath)</Dependencies>
            </_WasmRuntimePackSrcFile>
        </ItemGroup>
    </Target>
</Project>
