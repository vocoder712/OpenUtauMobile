+        "{clang_resource_directory}/lib/linux/%s/*" % {"i686": "i386"}.get(target_system_name.split("-")[0], target_system_name.split("-")[0]),
+    ], allow_empty = True),
 ) for target_system_name in TARGET_SYSTEM_NAMES]
 
 filegroup(
@@ -146,6 +144,6 @@
 
 filegroup(
