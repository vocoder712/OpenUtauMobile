module(name = "opum_worldline")

bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_android_ndk", version = "0.1.5")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

cc_configure = use_extension("@rules_cc//cc:extensions.bzl", "cc_configure_extension")
use_repo(cc_configure, "local_config_cc")

# 单独导入冻结源码，避免构建工具的传递依赖将这些版本自动抬升。
frozen_archive = use_repo_rule("//:frozen_archive.bzl", "frozen_archive")
frozen_archive(
    name = "absl",
    urls = ["https://github.com/abseil/abseil-cpp/releases/download/20240116.1/abseil-cpp-20240116.1.tar.gz"],
    integrity = "sha256-PHQyBN94NmrS6vI21mMdg/a8ko0XBd0AALhy5Ttz3Go=",
    strip_prefix = "abseil-cpp-20240116.1",
)
frozen_archive(
    name = "gtest",
    urls = ["https://github.com/google/googletest/archive/refs/tags/v1.14.0.tar.gz"],
    integrity = "sha256-itWYxzrXluDYKAsILOvYKmMNc+c808cAV5OKZQG7pdc=",
    strip_prefix = "googletest-1.14.0",
)
frozen_archive(
    name = "re2",
    urls = ["https://github.com/google/re2/releases/download/2023-09-01/re2-2023-09-01.zip"],
    integrity = "sha256-IkuDUdxGM7EBLb2EdWTgYKRr5goioUY9S1uZP9S/Wcw=",
    strip_prefix = "re2-2023-09-01",
)
frozen_archive(
    name = "xxhash",
    urls = ["https://github.com/Cyan4973/xxHash/archive/refs/tags/v0.8.2.tar.gz"],
    integrity = "sha256-uu4Mav1PAxZd56TmeYjRbw8rJXtR0OPLkZCTAqJqecQ=",
    strip_prefix = "xxHash-0.8.2",
    build_file = "//:xxhash.BUILD",
)

android_ndk = use_extension("@rules_android_ndk//:extension.bzl", "android_ndk_repository_extension")
android_ndk.configure(api_level = 24)
use_repo(android_ndk, "androidndk")
# 仅 Android 构建通过 --extra_toolchains 注册 NDK，桌面构建不要求安装 NDK。

