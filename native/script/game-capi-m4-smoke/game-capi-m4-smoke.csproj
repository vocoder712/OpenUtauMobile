<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
        <AssemblyName>game-capi-m4-smoke</AssemblyName>
        <RootNamespace>GameM4Smoke</RootNamespace>
        <GameDesktopNativeDir>..\..\..\native\build-desktop\app</GameDesktopNativeDir>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\OpenUtauMobile\OpenUtauMobile.csproj"/>
    </ItemGroup>

    <!-- 拷贝桌面原生运行库到输出（与 game-capi-cs-smoke 相同） -->
    <Target Name="CopyGameNativeRuntime" AfterTargets="Build">
        <ItemGroup>
            <GameNativeDlls Include="$(GameDesktopNativeDir)\game_ggml_shared.dll"/>
            <GameNativeDlls Include="$(GameDesktopNativeDir)\ggml*.dll"/>
            <GameNativeDlls Include="$(GameDesktopNativeDir)\msvcp140.dll"/>
            <GameNativeDlls Include="$(GameDesktopNativeDir)\vcruntime140.dll"/>
            <GameNativeDlls Include="$(GameDesktopNativeDir)\vccorlib140.dll"/>
            <GameNativeDlls Include="$(GameDesktopNativeDir)\concrt140.dll"/>
        </ItemGroup>
        <Copy Condition="Exists('$(GameDesktopNativeDir)')" SourceFiles="@(GameNativeDlls)" DestinationFolder="$(OutputPath)"/>
    </Target>
</Project>
