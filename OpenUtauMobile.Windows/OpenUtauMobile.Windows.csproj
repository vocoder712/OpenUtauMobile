<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    </PropertyGroup>

    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)"/>
        <PackageReference Include="NAudio.WinMM" Version="2.2.1"/>
        <PackageReference Include="NAudio.WinForms" Version="2.2.1"/>
        <PackageReference Include="SDL3-CS.Windows" Version="3.4.14"/>
        <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\OpenUtauMobile\OpenUtauMobile.csproj"/>
        <ProjectReference Include="..\OpenUtauMobile.DesktopUI\OpenUtauMobile.DesktopUI.csproj"/>
    </ItemGroup>
    <Import Project="../native/NativeBuild.targets" />
</Project>

